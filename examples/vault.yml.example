---
vault_domain: ''

# Format: 'Town, Country'
vault_location: ''

# Caddy

# CloudFlare API token for DNS-01 challange
vault_caddy_cf_api_token: ''

# Auth secret for authenticating Frigate with Caddy
vault_caddy_frigate_auth_secret: ''

# Pi-Hole

# Format: 'DNS1;DNS2'
vault_pihole_dns_upstreams: ''

# Local DNS entries. Format: 'IP DOMAIN; IP DOMAIN;...'
vault_pihole_dns_hosts: ''

# Password for web UI
vault_pihole_webserver_api_password: ''

# Hash of app password
vault_pihole_webserver_app_password_hash: ''

# App password
vault_pihole_webserver_app_password: ''

# Frigate

vault_frigate_doorbell_user: ''
vault_frigate_doorbell_password: ''
