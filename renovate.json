{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Warsaw",
  "schedule": [
    "* * 1,15 * *"
  ],
  "updateNotScheduled": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "labels": [
    "dependencies"
  ],
  "semanticCommits": "enabled",
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "ansible/roles/**/templates/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update dependencies in Ansible YAML files based on renovate comments",
      "managerFilePatterns": [
        "ansible/roles/*/defaults/*.yml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)(?: packageName=(?<packageName>.*?))?(?: versioning=(?<versioning>.*?))?\\n\\s*.*?:\\s*[\"']?(?<currentValue>[^\"'\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?[\"']?"
      ]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/blakeblackshear/frigate"
      ],
      "versioning": "semver",
      "ignoreUnstable": false,
      "respectLatest": false,
      "allowedVersions": "/^v?\\d+\\.\\d+\\.\\d+(-(beta|rc)\\.?\\d*)?$/"
    },
    {
      "description": "GHCR exposes no release timestamps, so minimumReleaseAge would block these forever. Skip the gate, and flag the PR for a manual release-date check.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/**"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "addLabels": [
        "no-release-age"
      ],
      "prBodyNotes": [
        "**No release-age delay:** GHCR publishes no release timestamps, so the 7-day `minimumReleaseAge` was not applied to this update. Check the release date upstream before merging."
      ]
    },
    {
      "description": "Immich dictates Postgres/Valkey versions via its compose file; digest refreshes only",
      "matchDepNames": [
        "immich-postgres",
        "immich-redis"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    }
  ]
}
