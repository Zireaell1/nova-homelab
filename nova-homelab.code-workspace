{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "ansible"
		}
	],
	"settings": {
		"workbench.editor.customLabels.patterns": {
			"**/tasks/**.yml": "${dirname(1)} > ${filename}.${extname} [tasks]",
			"**/vars/**.yml": "${dirname(1)} > ${filename}.${extname} [vars]",
			"**/defaults/**.yml": "${dirname(1)} > ${filename}.${extname} [defaults]",
			"**/handlers/**.yml": "${dirname(1)} > ${filename}.${extname} [handlers]"
		},
		"editor.formatOnSave": true,
		"files.trimTrailingWhitespace": true,
		"files.insertFinalNewline": true,
		"files.associations": {
			"*.container.j2": "ini",
			"*.network.j2": "ini",
			"*.env.j2": "ini",
			"*.service.j2": "ini",
			"*.timer.j2": "ini",
			"Caddyfile.j2": "makefile"
		},
		"[yaml]": {
			"editor.insertSpaces": true,
			"editor.tabSize": 2,
			"editor.autoIndent": "keep",
			"diffEditor.ignoreTrimWhitespace": false,
			"editor.defaultColorDecorators": "never",
			"editor.quickSuggestions": {
				"strings": true,
				"other": true,
				"comments": false
			},
			"editor.defaultFormatter": "redhat.vscode-yaml"
		},
		"[github-actions-workflow]": {
			"editor.insertSpaces": true,
			"editor.tabSize": 2,
			"editor.autoIndent": "keep",
			"diffEditor.ignoreTrimWhitespace": false,
			"editor.defaultColorDecorators": "never",
			"editor.quickSuggestions": {
				"strings": true,
				"other": true,
				"comments": false
			}
		},
		"[ansible]": {
			"editor.autoIndent": "advanced",
			"editor.detectIndentation": true,
			"editor.insertSpaces": true,
			"editor.quickSuggestions": {
				"comments": true,
				"other": true,
				"strings": true
			},
			"editor.tabSize": 2,
			"editor.defaultFormatter": "redhat.vscode-yaml"
		},
		"[makefile]": {
			"editor.insertSpaces": false,
			"editor.tabSize": 4,
			"editor.detectIndentation": false
		},
		"yaml.format.enable": true,
		"yaml.format.bracketSpacing": true,
		"yaml.validate": true,
		"ansible.validation.lint.enabled": true
	},
	"extensions": {
		"recommendations": [
			"redhat.ansible",
			"github.vscode-github-actions"
		]
	}
}
