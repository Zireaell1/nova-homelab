#!/usr/bin/env bash
#
# Pending-update metrics for the node exporter textfile collector.
#
# ==============================================================================
# DNF Commands used in this script (All are read-only and purely diagnostic):
#
# * dnf -q -C repoquery --upgrades       : Lists all available updates from local cache.
# * dnf -q -C check-update --security    : Checks local cache for security updates.
# * dnf -q -C updateinfo list --security : Fallback to check security update notices.
# * dnf -q -C needs-restarting --json    : Reboot hint as JSON; its exit code alone cannot tell "reboot needed" (1) from "error" (also 1).
# ==============================================================================

set -Eeuo pipefail

PROM_DIR="{{ textfile_metrics_path }}"
PROM_FILE="${PROM_DIR}/homelab_updates.prom"
PROM_TMP="${PROM_DIR}/.homelab_updates.prom.$$"
DNF_ERR_FILE="$(mktemp)"

SUCCESS=1
PENDING_ALL=0
PENDING_SECURITY=0
REBOOT_REQUIRED=0
CACHE_TIMESTAMP=0

DNF_OUT=""
DNF_ERR=""
DNF_RC=0

cleanup() {
    trap - EXIT
    rm -f "$PROM_TMP" "$DNF_ERR_FILE"
}
trap cleanup EXIT

on_err() {
    echo >&2 "[ERROR] Unhandled failure at line ${1} (exit ${2})."
    SUCCESS=0
}
trap 'on_err "${LINENO}" "$?"' ERR

run_dnf() {
    DNF_RC=0
    DNF_OUT="$(LC_ALL=C dnf -q -C "$@" 2>"$DNF_ERR_FILE")" || DNF_RC=$?
    DNF_ERR="$(<"$DNF_ERR_FILE")"
}

log_dnf_stderr() {
    [ -n "$DNF_ERR" ] || return 0
    printf '%s\n' "$DNF_ERR" | sed "s/^/[${1}] dnf ${2}: /" >&2
}

fail() {
    echo >&2 "[ERROR] $1"
    SUCCESS=0
}

count_pending_all() {
    run_dnf repoquery --upgrades --queryformat '%{name}\n'
    if [ "$DNF_RC" -ne 0 ]; then
        log_dnf_stderr ERROR "repoquery"
        fail "'dnf repoquery --upgrades' failed (exit ${DNF_RC})."
        return
    fi
    log_dnf_stderr WARN "repoquery"
    PENDING_ALL="$(printf '%s\n' "$DNF_OUT" | sed '/^$/d' | sort -u | wc -l)"
}

count_pending_security() {
    run_dnf check-update --security
    if [ "$DNF_RC" -eq 0 ] || [ "$DNF_RC" -eq 100 ]; then
        log_dnf_stderr WARN "check-update"
        PENDING_SECURITY="$(printf '%s\n' "$DNF_OUT" \
            | awk '/^Obsoleting Packages/ {exit} NF >= 3 && $1 !~ /^(Last|Security:)/ {sub(/\.[^.]+$/, "", $1); print $1}' \
            | sort -u | wc -l)"
        return
    fi
    log_dnf_stderr ERROR "check-update"

    run_dnf updateinfo list --security
    if [ "$DNF_RC" -eq 0 ] || [ "$DNF_RC" -eq 100 ]; then
        log_dnf_stderr WARN "updateinfo"
        PENDING_SECURITY="$(printf '%s\n' "$DNF_OUT" \
            | awk 'NF >= 3 {print $3}' \
            | sort -u | wc -l)"
        return
    fi
    log_dnf_stderr ERROR "updateinfo"
    fail "Neither 'check-update --security' nor 'updateinfo list --security' worked."
}

check_reboot() {
    local verdict=""
    run_dnf --disablerepo='*' needs-restarting --json
    if [ -n "$DNF_OUT" ]; then
        verdict="$(printf '%s' "$DNF_OUT" | python3 -c '
import json, sys
try:
    print(int(json.load(sys.stdin)[0]["reboot_required"]))
except Exception:
    pass
')"
    fi
    case "$verdict" in
        0 | 1)
            REBOOT_REQUIRED="$verdict"
            log_dnf_stderr WARN "needs-restarting"
            ;;
        *)
            log_dnf_stderr ERROR "needs-restarting"
            fail "'dnf needs-restarting --json' gave no verdict (exit ${DNF_RC}); is dnf5-plugins installed?"
            ;;
    esac
}

read_cache_timestamp() {
    local newest
    newest="$(find /var/cache/libdnf5 /var/cache/dnf -maxdepth 4 -name 'repomd.xml' -printf '%T@\n' 2>/dev/null \
        | sort -rn | head -n1 | cut -d. -f1)" || newest=""
    if [ -n "$newest" ]; then
        CACHE_TIMESTAMP="$newest"
    fi
}

emit() {
    cat <<PROM
# HELP homelab_updates_pending Packages with a pending upgrade, by severity
# TYPE homelab_updates_pending gauge
homelab_updates_pending{severity="all"} ${PENDING_ALL}
homelab_updates_pending{severity="security"} ${PENDING_SECURITY}
# HELP homelab_updates_reboot_required Whether the package manager says a reboot is needed
# TYPE homelab_updates_reboot_required gauge
homelab_updates_reboot_required ${REBOOT_REQUIRED}
# HELP homelab_updates_cache_timestamp_seconds Unix time the package metadata was last refreshed
# TYPE homelab_updates_cache_timestamp_seconds gauge
homelab_updates_cache_timestamp_seconds ${CACHE_TIMESTAMP}
# HELP homelab_updates_last_check_timestamp_seconds Unix time this collector last ran
# TYPE homelab_updates_last_check_timestamp_seconds gauge
homelab_updates_last_check_timestamp_seconds $(date +%s)
# HELP homelab_updates_collector_success Whether this collector completed without error (1) or not (0)
# TYPE homelab_updates_collector_success gauge
homelab_updates_collector_success ${SUCCESS}
PROM
}

main() {
    mkdir -p "$PROM_DIR"
    count_pending_all
    count_pending_security
    check_reboot
    read_cache_timestamp
    emit > "$PROM_TMP"
    mv -f "$PROM_TMP" "$PROM_FILE"
    chmod 0644 "$PROM_FILE"
    echo "[INFO] ${PENDING_ALL} pending (${PENDING_SECURITY} security), reboot_required=${REBOOT_REQUIRED}, success=${SUCCESS}."
}

main "$@"
