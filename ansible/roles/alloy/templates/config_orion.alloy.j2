logging {
    level = "warn"
}

local.file "prom_auth" {
    filename  = "/etc/alloy/prom_password.txt"
    is_secret = true
}

local.file "loki_auth" {
    filename  = "/etc/alloy/loki_password.txt"
    is_secret = true
}

prometheus.remote_write "remote_prom" {
    endpoint {
        url = "https://{{ service_endpoints['prometheus']['subdomain'] }}.{{ vault_domain }}/api/v1/write"

        basic_auth {
            username = "{{ vault_prometheus_service_account_username }}"
            password = local.file.prom_auth.content
        }

        queue_config {
            min_shards           = 1
            max_shards           = 1
            capacity             = 15000
            max_samples_per_send = 5000
            batch_send_deadline  = "60s"
        }

        enable_http2 = true
    }
}

loki.write "remote_loki" {
    endpoint {
        url = "https://{{ service_endpoints['loki']['subdomain'] }}.{{ vault_domain }}/loki/api/v1/push"

        basic_auth {
            username = "{{ vault_loki_service_account_username }}"
            password = local.file.loki_auth.content
        }

        batch_wait = "30s"
        batch_size = "2MiB"
    }
}

loki.source.journal "system" {
    forward_to    = [loki.write.remote_loki.receiver]
    relabel_rules = loki.relabel.journal.rules
}

loki.relabel "journal" {
    forward_to = []

    rule {
        target_label = "job"
        replacement  = "os"
    }

    rule {
        source_labels = ["__journal_container_name"]
        regex         = "(.+)"
        target_label  = "job"
        replacement   = "container"
    }

    rule {
        source_labels = ["__journal__systemd_unit"]
        target_label  = "unit"
    }

    rule {
        source_labels = ["__journal_syslog_identifier"]
        target_label  = "syslog_identifier"
    }

    rule {
        target_label = "host"
        replacement  = constants.hostname
    }

    rule {
        source_labels = ["__journal_container_name"]
        target_label  = "container"
    }
}

prometheus.exporter.unix "host" {
    include_exporter_metrics = true
    disable_collectors       = ["mdadm", "rapl", "dmi", "edac", "nvme", "nfs", "nfsd", "tapestats", "infiniband", "fibrechannel", "ipvs", "btrfs", "zfs", "bache", "xfs"]
    enable_collectors        = ["systemd", "processes", "logind", "wifi"]

    textfile {
        directory = "{{ textfile_metrics_path }}"
    }
}

prometheus.scrape "host_metrics" {
    targets = array.concat(
        prometheus.exporter.unix.host.targets,
        [
            {
                job         = "alloy",
                __address__ = "127.0.0.1:12345",
            },
            {
                job         = "eink",
                __address__ = "127.0.0.1:9110",
            },
        ],
    )
    forward_to = [prometheus.remote_write.remote_prom.receiver]

    scrape_interval = "60s"
}
