logging {
    level = "warn"
}

prometheus.remote_write "local_prom" {
    endpoint {
        url = "http://127.0.0.1:9080/api/v1/write"
    }
}

loki.write "local_loki" {
    endpoint {
        url = "http://127.0.0.1:3100/loki/api/v1/push"
    }
}

loki.source.journal "system" {
    forward_to    = [loki.process.journal.receiver]
    relabel_rules = loki.relabel.journal.rules
}

loki.process "journal" {
    forward_to = [loki.write.local_loki.receiver]

    stage.match {
        selector = `{job="os", syslog_identifier="kernel"}`
        stage.regex {
            expression = `(?P<kernel_io_error>Buffer I/O error|blk_update_request: I/O error|EXT4-fs error|XFS \(.+\): (corruption|metadata I/O error|Internal error)|failed command: (READ|WRITE) FPDMA)`
        }
        stage.metrics {
            metric.counter {
                name              = "kernel_io_errors_total"
                description       = "Kernel I/O or filesystem error lines in the journal"
                source            = "kernel_io_error"
                action            = "inc"
                max_idle_duration = "24h"
            }
        }
    }

    stage.match {
        selector = `{syslog_identifier="setroubleshoot"} != "upsmon from using the dac_override"`
        stage.regex {
            expression = `(?P<selinux_denial>SELinux is preventing)`
        }
        stage.metrics {
            metric.counter {
                name              = "selinux_denials_total"
                description       = "SELinux denials reported by setroubleshootd"
                source            = "selinux_denial"
                action            = "inc"
                max_idle_duration = "24h"
            }
        }
    }

    stage.match {
        selector = `{container="zigbee2mqtt"}`
        stage.regex {
            expression = `(?P<z2m_error>Coordinator failed|Failed to connect to the adapter|Adapter disconnected|Error while starting zigbee-herdsman)`
        }
        stage.metrics {
            metric.counter {
                name              = "zigbee2mqtt_errors_total"
                description       = "Zigbee2MQTT adapter and coordinator errors"
                source            = "z2m_error"
                action            = "inc"
                max_idle_duration = "24h"
            }
        }
    }

    stage.match {
        selector = `{unit="tailscaled.service"}`
        stage.drop {
            expression          = `magicsock: endpoints changed`
            drop_counter_reason = "tailscale_endpoint_churn"
        }
    }
}

loki.relabel "journal" {
    forward_to = []

    rule {
        target_label = "job"
        replacement  = "os"
    }

    rule {
        source_labels = ["__journal_container_name"]
        regex         = "(.+)"
        target_label  = "job"
        replacement   = "container"
    }

    rule {
        source_labels = ["__journal__systemd_unit"]
        target_label  = "unit"
    }

    rule {
        source_labels = ["__journal_syslog_identifier"]
        target_label  = "syslog_identifier"
    }

    rule {
        target_label = "host"
        replacement  = constants.hostname
    }

    rule {
        source_labels = ["__journal_container_name"]
        target_label  = "container"
    }
}

prometheus.exporter.unix "host" {
    include_exporter_metrics = true
    disable_collectors       = ["mdadm", "nfs", "nfsd", "tapestats", "infiniband", "fibrechannel", "ipvs", "btrfs", "zfs", "bcache"]
    enable_collectors        = ["systemd", "processes", "logind"]

    textfile {
        directory = "{{ textfile_metrics_path }}"
    }
}

prometheus.scrape "host_metrics" {
    targets = array.concat(
        prometheus.exporter.unix.host.targets,
        [
            {
                job         = "alloy",
                __address__ = "{{ host_svc_address }}:12345",
            },
            {
                job         = "podman",
                __address__ = "127.0.0.1:9882",
            },
            {
                job         = "tailscale",
                __address__ = "100.100.100.100:80",
            },
        ],
    )
    forward_to = [prometheus.remote_write.local_prom.receiver]

    scrape_interval = "15s"
}

prometheus.exporter.cadvisor "containers" {
    docker_only                 = true
    raw_cgroup_prefix_allowlist = ["/user.slice/"]
    store_container_labels      = false
    disable_root_cgroup_stats   = true
    enabled_metrics             = ["cpu", "memory"]
    storage_duration            = "2m"
}

prometheus.scrape "containers" {
    targets         = prometheus.exporter.cadvisor.containers.targets
    forward_to      = [prometheus.relabel.containers.receiver]
    scrape_interval = "30s"
}

prometheus.relabel "containers" {
    forward_to = [prometheus.remote_write.local_prom.receiver]

    rule {
        source_labels = ["id"]
        regex         = ".*/([^/]+)\\.service/libpod-payload-[0-9a-f]+"
        target_label  = "service"
    }

    rule {
        source_labels = ["service"]
        regex         = ""
        action        = "drop"
    }

    rule {
        source_labels = ["__name__"]
        regex         = "container_memory_(swap|working_set_bytes|rss)|container_spec_memory_(limit|swap_limit)_bytes|container_cpu_(usage_seconds_total|cfs_periods_total|cfs_throttled_periods_total)"
        action        = "keep"
    }

    rule {
        regex  = "id|name|image"
        action = "labeldrop"
    }
}
