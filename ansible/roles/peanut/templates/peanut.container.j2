[Unit]
Description=PeaNUT
Documentation=https://github.com/Brandawg93/PeaNUT/wiki

Wants=network-online.target
After=network-online.target

Wants=nut.target
After=nut.target

RequiresMountsFor={{ stacks_path }}/peanut/config

[Container]
# --- Image / Exec ---
Image={{ peanut_image }}:{{ peanut_version }}
ContainerName=peanut
StopTimeout=20

# --- Identity / Namespaces ---
UserNS=keep-id:uid=1000,gid=1000

# --- Security / Capabilities ---
DropCapability=all
NoNewPrivileges=true

# --- Resource Limits ---
Memory={{ peanut_memory_limit }}

# --- Storage ---
Volume={{ stacks_path }}/peanut/config:/config:Z

# --- Networking ---
Network=peanut.network

# --- Configuration / Env ---
Timezone={{ timezone }}

EnvironmentFile={{ stacks_path }}/peanut/peanut.env

HealthCmd=["node", "/app/healthcheck.mjs"]
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
