#!/usr/bin/env bash
#
# Mirrors the repositories in git_backup_repos into git_backup_dir right before the snapshot:
# ExecStartPre=- of homelab-backup.service (a failed mirror never stops the backup; it shows in the metrics).
#
# ==============================================================================
# Commands used in this script:
#
# * git -c gc.autoDetach=false clone --mirror <url> <dir>        : First run: a bare mirror (all branches, tags, refs).
# * git -c gc.autoDetach=false -C <dir> remote update --prune    : Later runs: fetch everything, drop refs deleted upstream.
#       gc.autoDetach=false: a background gc must not still be writing when the backup reads the mirror.
#
# Writes: homelab_git_mirror.prom (per repo: success, last success time; a failure keeps the previous time).
# ==============================================================================

set -Euo pipefail

TARGET_DIR="{{ git_backup_dir }}"
PROM_DIR="{{ textfile_metrics_path }}"
PROM_FILE="${PROM_DIR}/homelab_git_mirror.prom"
PROM_TMP="${PROM_DIR}/.homelab_git_mirror.prom.$$"

FAILED=0

cleanup() {
    trap - EXIT
    rm -f "$PROM_TMP"
}
trap cleanup EXIT

previous_success() {
    local repo="$1"
    [ -f "$PROM_FILE" ] || { echo 0; return; }
    awk -v r="$repo" -F'[ ]' '$1 == "homelab_git_mirror_last_success_timestamp_seconds{repo=\"" r "\"}" {print $2; found=1} END {if (!found) print 0}' "$PROM_FILE"
}

sync_repo() {
    local name="$1" url="$2" path="$TARGET_DIR/$1"
    if [ -d "$path" ]; then
        echo "[INFO] Updating mirror: $name"
        git -c gc.autoDetach=false -C "$path" remote update --prune
    else
        echo "[INFO] Cloning mirror: $name"
        git -c gc.autoDetach=false clone --mirror "$url" "$path"
    fi
}

mkdir -p "$TARGET_DIR" "$PROM_DIR"
echo "[INFO] Starting Git repository sync..."

{
    echo "# HELP homelab_git_mirror_last_success_timestamp_seconds Unix time of the last successful mirror update"
    echo "# TYPE homelab_git_mirror_last_success_timestamp_seconds gauge"
    echo "# HELP homelab_git_mirror_success Whether the last mirror update succeeded (1) or failed (0)"
    echo "# TYPE homelab_git_mirror_success gauge"
} > "$PROM_TMP"

{% for repo in git_backup_repos %}
if sync_repo "{{ repo.name }}" "{{ repo.url }}"; then
    ts="$(date +%s)"; ok=1
else
    echo >&2 "[ERROR] Mirror failed: {{ repo.name }}"
    ts="$(previous_success "{{ repo.name }}")"; ok=0; FAILED=1
fi
echo "homelab_git_mirror_last_success_timestamp_seconds{repo=\"{{ repo.name }}\"} ${ts}" >> "$PROM_TMP"
echo "homelab_git_mirror_success{repo=\"{{ repo.name }}\"} ${ok}" >> "$PROM_TMP"

{% endfor %}
mv -f "$PROM_TMP" "$PROM_FILE"
chmod 0644 "$PROM_FILE"

echo "[INFO] Git repository sync complete."
exit "$FAILED"
