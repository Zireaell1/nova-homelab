#!/usr/bin/env bash
#
# Reads the offsite copy back from B2: OnSuccess= of homelab-backup.service.
#
# ==============================================================================
# Commands used in this script (all read-only, --no-lock: nothing is written to B2):
#
# * restic dump latest <canary.txt> --no-cache --no-lock   (repository rclone:<b2>/homelab)
#       : The canary timestamp from the newest snapshot, straight from B2. Fresh = tonight's data arrived and is readable.
# * restic check --no-lock --read-data-subset=<5%>         (only on backup_verify_b2_check_weekday, Sunday)
#       : Structure, every index, and a random share of the data packs of the B2 copy itself.
#
# Environment: RESTIC_PASSWORD_FILE, RESTIC_REPOSITORY, XDG_CONFIG_HOME (rclone.conf).
# Writes: homelab_backup_verify.prom every run, homelab_backup_b2_check.prom only when the weekly check ran.
# ==============================================================================

set -uo pipefail

echo "[INFO] Starting Backup Cloud Verification..."
VERIFY_START_TIME=$(date +%s)

# ==========================================
# 1. CONFIGURATION
# ==========================================
export RESTIC_PASSWORD_FILE="{{ backup_restic_password_file }}"
export XDG_CONFIG_HOME="{{ user_config_path }}"
RCLONE_TARGET="{{ backup_rclone_target }}"

CANARY_PATH="{{ backup_canary_file }}"
MAX_AGE="{{ backup_canary_max_age }}"

PROM_TARGET_DIR="{{ textfile_metrics_path }}"
PROM_TMP_FILE="${PROM_TARGET_DIR}/.homelab_backup_verify.prom.$$"

SUCCESS=0
CANARY_TIMESTAMP=0
CANARY_AGE=-1

CHECK_WEEKDAY="{{ backup_verify_b2_check_weekday }}"
CHECK_SUBSET="{{ backup_verify_b2_read_subset }}"
CHECK_RAN=0
CHECK_SUCCESS=1

export RESTIC_REPOSITORY="rclone:${RCLONE_TARGET}/homelab"

# ==========================================
# 2. FETCH CANARY FROM CLOUD
# ==========================================
echo "[INFO] Attempting to retrieve canary file directly from B2 (forcing --no-cache)..."

if RAW_TIMESTAMP=$(restic dump latest "$CANARY_PATH" --no-cache --no-lock 2>/dev/null); then
    if [[ "$RAW_TIMESTAMP" =~ ^[0-9]+$ ]]; then
        CANARY_TIMESTAMP=$RAW_TIMESTAMP
        CANARY_AGE=$(( $(date +%s) - CANARY_TIMESTAMP ))

        if [ "$CANARY_AGE" -lt "$MAX_AGE" ]; then
            SUCCESS=1
            echo "[SUCCESS] Canary retrieved, age ${CANARY_AGE}s."
        else
            echo >&2 "[ERROR] Canary is ${CANARY_AGE}s old (limit ${MAX_AGE}s) -- the offsite copy is stale."
        fi
    else
        echo >&2 "[ERROR] Canary content is not a timestamp: ${RAW_TIMESTAMP}"
    fi
else
    echo >&2 "[ERROR] Could not reach B2 or extract the canary."
fi

# ==========================================
# 2b. WEEKLY CHECK OF THE B2 COPY ITSELF
# ==========================================
# The nightly backup checks the local repository; this reads the offsite copy:
# structure, every index, and a random share of the data packs.
if [ "$CHECK_WEEKDAY" -ne 0 ] && [ "$(date +%u)" -eq "$CHECK_WEEKDAY" ]; then
    CHECK_RAN=1
    echo "[INFO] Weekly restic check of the B2 copy (read-data-subset ${CHECK_SUBSET})..."
    if restic check --no-lock --read-data-subset="$CHECK_SUBSET"; then
        echo "[SUCCESS] B2 copy checked."
    else
        CHECK_SUCCESS=0
        echo >&2 "[ERROR] restic check of the B2 copy failed."
    fi
fi

# ==========================================
# 3. METRICS GENERATION
# ==========================================
VERIFY_END_TIME=$(date +%s)
VERIFY_DURATION=$((VERIFY_END_TIME - VERIFY_START_TIME))

echo "[INFO] Generating Prometheus metrics..."
cat <<EOF > "$PROM_TMP_FILE"
# HELP homelab_backup_verify_success Whether the cloud B2 verification of the homelab repository succeeded (1) or failed (0); device repositories are encrypted under client keys and are not verified
# TYPE homelab_backup_verify_success gauge
homelab_backup_verify_success $SUCCESS

# HELP homelab_backup_verify_canary_age_seconds Age of the canary file retrieved directly from cloud B2
# TYPE homelab_backup_verify_canary_age_seconds gauge
homelab_backup_verify_canary_age_seconds $CANARY_AGE

# HELP homelab_backup_verify_duration_seconds Time taken to run the cloud verification script
# TYPE homelab_backup_verify_duration_seconds gauge
homelab_backup_verify_duration_seconds $VERIFY_DURATION
EOF

# The weekly check keeps its own file, so the six nights without a check don't overwrite its result.
if [ "$CHECK_RAN" -eq 1 ] && [ -d "$PROM_TARGET_DIR" ]; then
    cat <<EOF > "${PROM_TARGET_DIR}/.homelab_backup_b2_check.prom.$$"
# HELP homelab_backup_b2_check_success Whether the last weekly restic check of the B2 copy passed (1) or failed (0)
# TYPE homelab_backup_b2_check_success gauge
homelab_backup_b2_check_success $CHECK_SUCCESS

# HELP homelab_backup_b2_check_timestamp_seconds When the weekly restic check of the B2 copy last ran
# TYPE homelab_backup_b2_check_timestamp_seconds gauge
homelab_backup_b2_check_timestamp_seconds $VERIFY_END_TIME
EOF
    mv -f "${PROM_TARGET_DIR}/.homelab_backup_b2_check.prom.$$" "${PROM_TARGET_DIR}/homelab_backup_b2_check.prom"
fi

if [ -d "$PROM_TARGET_DIR" ]; then
    mv "$PROM_TMP_FILE" "${PROM_TARGET_DIR}/homelab_backup_verify.prom"
    echo "[INFO] Metrics saved to $PROM_TARGET_DIR."
else
    echo "[WARNING] Prometheus metrics directory $PROM_TARGET_DIR does not exist."
fi

if [ $SUCCESS -eq 1 ] && [ $CHECK_SUCCESS -eq 1 ]; then
    exit 0
else
    exit 1
fi
