#!/usr/bin/env bash

set -uo pipefail

# ==========================================
# 1. CONFIGURATION
# ==========================================
SCRIPT_START_TIME=$(date +%s)

export RESTIC_PASSWORD_FILE="{{ backup_restic_password_file }}"
export XDG_CONFIG_HOME="{{ user_config_path }}"

REPO_CRITICAL="{{ local_backup_path }}"
REPO_DEVICES_ROOT="{{ restic_server_path }}"
RCLONE_TARGET="{{ backup_rclone_target }}"

B2_QUOTA_BYTES="{{ backup_b2_quota_bytes }}"

CANARY_FILE="/tmp/homelab_canary.txt"

GLOBAL_SUCCESS=1
RCLONE_SUCCESS=1
PRUNE_SUCCESS=1
QUOTA_EXCEEDED=0

LOCAL_BACKUP_DURATION=0
CLOUD_SYNC_DURATION=0
PRUNE_DURATION=0

# ==========================================
# 2. GENERATE DYNAMIC PATH LISTS
# ==========================================
INCLUDE_FILE=$(mktemp /tmp/restic_includes.XXXXXX)
EXCLUDE_FILE=$(mktemp /tmp/restic_excludes.XXXXXX)

cat << 'EOF' > "$INCLUDE_FILE"
{% for svc_name, svc_vars in services.items() %}
{% if 'backup' in svc_vars and svc_vars.backup.get('paths') %}
{% for path in svc_vars.backup.paths %}
{{ path }}
{% endfor %}
{% endif %}
{% endfor %}
EOF

cat << 'EOF' > "$EXCLUDE_FILE"
{% for svc_name, svc_vars in services.items() %}
{% if 'backup' in svc_vars and svc_vars.backup.get('excludes') %}
{% for path in svc_vars.backup.excludes %}
{{ path }}
{% endfor %}
{% endif %}
{% endfor %}
EOF

sed -i '/^[[:space:]]*$/d' "$INCLUDE_FILE" "$EXCLUDE_FILE"

echo "[INFO] Generating Canary file for integrity testing..."
echo "$SCRIPT_START_TIME" > "$CANARY_FILE"
echo "$CANARY_FILE" >> "$INCLUDE_FILE"

SERVICES_TO_STOP=(
{% for svc_name, svc_vars in services.items() %}
{% if 'backup' in svc_vars and svc_vars.backup.get('stop', false) %}
  "{{ svc_vars.get('quadlet_name', svc_name ~ '.service') }}"
{% endif %}
{% endfor %}
)

# ==========================================
# 3. TRAP CLEANUP & METRICS
# ==========================================
cleanup_and_start() {
    local script_end_time=$(date +%s)
    local duration=$((script_end_time - SCRIPT_START_TIME))

    local repo_size_bytes=0
    if [ -d "$REPO_CRITICAL" ]; then
        repo_size_bytes=$(du -sb "$REPO_CRITICAL" | cut -f1)
    fi

    local snapshot_count=0
    if [ -d "$REPO_CRITICAL" ]; then
        export RESTIC_REPOSITORY="$REPO_CRITICAL"
        snapshot_count=$(restic snapshots --json 2>/dev/null | jq length 2>/dev/null || echo 0)
    fi

    local b2_size_bytes=0
    echo "[INFO] Fetching cloud size metrics from B2..."
    if b2_info=$(rclone size "${RCLONE_TARGET}/homelab" --json 2>/dev/null); then
        b2_size_bytes=$(echo "$b2_info" | jq -r '.bytes' 2>/dev/null || echo 0)
    fi

    echo "[INFO] Running final cleanup procedure (Trap)..."

    if [ {% raw %}${#SERVICES_TO_STOP[@]}{% endraw %} -gt 0 ]; then
        echo "[INFO] Restarting systemd services..."
        for service in "${SERVICES_TO_STOP[@]}"; do
            systemctl --user start "$service" || echo "[WARNING] Failed to start $service"
        done
    fi

    rm -f "$INCLUDE_FILE" "$EXCLUDE_FILE" "$CANARY_FILE"

    if [ $GLOBAL_SUCCESS -eq 1 ] && [ $RCLONE_SUCCESS -eq 1 ] && [ $QUOTA_EXCEEDED -eq 0 ]; then
        echo "[SUCCESS] Backup routine completed successfully in ${duration}s."
    else
        echo "[CRITICAL] Script encountered errors or hit quota limit. Check logs. Duration: ${duration}s."
    fi

    local PROM_TMP_FILE="/tmp/homelab_backup.prom"
    local PROM_TARGET_DIR="{{ textfile_metrics_path }}"

    cat <<EOF > "$PROM_TMP_FILE"
# HELP homelab_backup_success Whether the local Restic backup succeeded (1) or failed (0)
# TYPE homelab_backup_success gauge
homelab_backup_success $GLOBAL_SUCCESS

# HELP homelab_backup_cloud_sync_success Whether the Rclone cloud sync succeeded (1) or failed (0)
# TYPE homelab_backup_cloud_sync_success gauge
homelab_backup_cloud_sync_success $RCLONE_SUCCESS

# HELP homelab_backup_prune_success Whether the retention policy prune succeeded (1) or failed (0)
# TYPE homelab_backup_prune_success gauge
homelab_backup_prune_success $PRUNE_SUCCESS

# HELP homelab_backup_quota_exceeded Whether the projected B2 size exceeded the limit (1) or not (0)
# TYPE homelab_backup_quota_exceeded gauge
homelab_backup_quota_exceeded $QUOTA_EXCEEDED

# HELP homelab_backup_duration_seconds Time taken for the total backup script to run
# TYPE homelab_backup_duration_seconds gauge
homelab_backup_duration_seconds $duration

# HELP homelab_backup_stage_duration_seconds Time taken for individual backup stages
# TYPE homelab_backup_stage_duration_seconds gauge
homelab_backup_stage_duration_seconds{stage="local_backup"} $LOCAL_BACKUP_DURATION
homelab_backup_stage_duration_seconds{stage="cloud_sync"} $CLOUD_SYNC_DURATION
homelab_backup_stage_duration_seconds{stage="prune"} $PRUNE_DURATION

# HELP homelab_backup_last_run_timestamp_seconds Timestamp of the last backup run
# TYPE homelab_backup_last_run_timestamp_seconds gauge
homelab_backup_last_run_timestamp_seconds $script_end_time

# HELP homelab_backup_repo_size_bytes Size of the homelab backup repository in bytes
# TYPE homelab_backup_repo_size_bytes gauge
homelab_backup_repo_size_bytes $repo_size_bytes

# HELP homelab_backup_b2_size_bytes Size of the synced backup in B2 cloud in bytes
# TYPE homelab_backup_b2_size_bytes gauge
homelab_backup_b2_size_bytes $b2_size_bytes

# HELP homelab_backup_snapshot_count Total number of snapshots in the critical repository
# TYPE homelab_backup_snapshot_count gauge
homelab_backup_snapshot_count $snapshot_count

# HELP homelab_backup_path_info Information about included and excluded paths per service
# TYPE homelab_backup_path_info gauge
{% for svc_name, svc_vars in services.items() %}
{% if 'backup' in svc_vars %}
{% if svc_vars.backup.get('paths') %}
{% for path in svc_vars.backup.paths %}
homelab_backup_path_info{service="{{ svc_name }}", path="{{ path }}", type="include"} 1
{% endfor %}
{% endif %}
{% if svc_vars.backup.get('excludes') %}
{% for path in svc_vars.backup.excludes %}
homelab_backup_path_info{service="{{ svc_name }}", path="{{ path }}", type="exclude"} 1
{% endfor %}
{% endif %}
{% endif %}
{% endfor %}
EOF

    if [ -d "$PROM_TARGET_DIR" ]; then
        mv "$PROM_TMP_FILE" "${PROM_TARGET_DIR}/homelab_backup.prom"
    else
        echo "[WARNING] Prometheus textfile directory $PROM_TARGET_DIR does not exist. Metrics not saved."
    fi

    if [ $GLOBAL_SUCCESS -eq 0 ] || [ $RCLONE_SUCCESS -eq 0 ] || [ $PRUNE_SUCCESS -eq 0 ]; then
        exit 1
    else
        exit 0
    fi
}

trap cleanup_and_start EXIT INT TERM

# ==========================================
# 4. PRE-FLIGHT CHECKS
# ==========================================
echo "[INFO] Running pre-flight checks..."

if [ -s "$INCLUDE_FILE" ]; then
    export RESTIC_REPOSITORY="$REPO_CRITICAL"
    if ! restic snapshots >/dev/null 2>&1; then
        echo >&2 "[ERROR] Repository $REPO_CRITICAL does not exist, is corrupted, or password is incorrect!"
        GLOBAL_SUCCESS=0
        exit 1
    fi
else
    echo "[INFO] No paths defined for backup. Exiting."
    exit 0
fi

# ==========================================
# 5. PRE-HOOK: STOP SERVICES
# ==========================================
if [ {% raw %}${#SERVICES_TO_STOP[@]}{% endraw %} -gt 0 ]; then
    echo "[INFO] Stopping stateful services (Rootless Quadlets)..."
    for service in "${SERVICES_TO_STOP[@]}"; do
        systemctl --user stop "$service"
    done
fi

# ==========================================
# 6. BACKUP: CRITICAL DATA
# ==========================================
echo "[INFO] Running Restic backup for critical data..."
LOCAL_BACKUP_START=$(date +%s)
export RESTIC_REPOSITORY="$REPO_CRITICAL"

restic backup \
    --files-from "$INCLUDE_FILE" \
    --exclude-file "$EXCLUDE_FILE" \
    --compression max \
    --verbose=1 || GLOBAL_SUCCESS=0

echo "[INFO] Verifying repository integrity..."
restic check --read-data-subset=10% || {
    echo "[ERROR] Repository check failed!"
    GLOBAL_SUCCESS=0
}

LOCAL_BACKUP_END=$(date +%s)
LOCAL_BACKUP_DURATION=$((LOCAL_BACKUP_END - LOCAL_BACKUP_START))

if [ {% raw %}${#SERVICES_TO_STOP[@]}{% endraw %} -gt 0 ]; then
    echo "[INFO] Local backups finished. Fast restarting services..."
    for service in "${SERVICES_TO_STOP[@]}"; do
        systemctl --user start "$service"
    done
    SERVICES_TO_STOP=()
fi

# ==========================================
# 7. CLOUD SYNC (Rclone)
# ==========================================
echo "[INFO] Syncing local repositories to the cloud..."
CLOUD_SYNC_START=$(date +%s)

if [ "$B2_QUOTA_BYTES" -gt 0 ]; then
    echo "[INFO] Checking quota limits before cloud sync (Max: $B2_QUOTA_BYTES bytes)..."
    LOCAL_SIZE_CRITICAL=$(du -sb "$REPO_CRITICAL" 2>/dev/null | cut -f1 || echo 0)

    LOCAL_SIZE_DEVICES_CLOUD=$(find "$REPO_DEVICES_ROOT" -mindepth 2 -maxdepth 2 -type d -name "cloud" -exec du -sb {} + 2>/dev/null | awk '{s+=$1} END {print s+0}')

    TOTAL_PROJECTED_SIZE=$((LOCAL_SIZE_CRITICAL + LOCAL_SIZE_DEVICES_CLOUD))

    if [ "$TOTAL_PROJECTED_SIZE" -gt "$B2_QUOTA_BYTES" ]; then
        echo "[ERROR] Projected cloud size ($TOTAL_PROJECTED_SIZE bytes) exceeds limit ($B2_QUOTA_BYTES bytes)!"
        QUOTA_EXCEEDED=1
        RCLONE_SUCCESS=0
    else
        echo "[INFO] Projected size ($TOTAL_PROJECTED_SIZE bytes) is within quota. Proceeding..."
    fi
fi

if [ $QUOTA_EXCEEDED -eq 0 ] && [ $GLOBAL_SUCCESS -eq 1 ]; then
    rclone sync "$REPO_CRITICAL" "${RCLONE_TARGET}/homelab" --fast-list --transfers 8 || RCLONE_SUCCESS=0

    if [ -d "$REPO_DEVICES_ROOT" ]; then
        echo "[INFO] Syncing external device repositories (all users, cloud tier only)..."
        rclone sync "$REPO_DEVICES_ROOT" "${RCLONE_TARGET}/devices" \
            --include "/*/cloud/**" \
            --fast-list --transfers 8 || RCLONE_SUCCESS=0
    fi
else
    echo "[WARNING] Skipping Rclone sync to prevent exceeding B2 quota."
fi

CLOUD_SYNC_END=$(date +%s)
CLOUD_SYNC_DURATION=$((CLOUD_SYNC_END - CLOUD_SYNC_START))

# ==========================================
# 8. RETENTION (Pruning)
# ==========================================
echo "[INFO] Running retention policy (Prune)..."
PRUNE_START=$(date +%s)
export RESTIC_REPOSITORY="$REPO_CRITICAL"

restic forget --prune --keep-daily 7 --keep-weekly 4 --keep-monthly 6 || {
    GLOBAL_SUCCESS=0
    PRUNE_SUCCESS=0
}

PRUNE_END=$(date +%s)
PRUNE_DURATION=$((PRUNE_END - PRUNE_START))
