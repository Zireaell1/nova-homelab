#!/bin/bash

set -uo pipefail

# ==========================================
# 1. CONFIGURATION
# ==========================================
SCRIPT_START_TIME=$(date +%s)
export RESTIC_PASSWORD='{{ vault_backup_restic_password }}'
export XDG_CONFIG_HOME="/home/{{ ansible_user }}/.config"

REPO_CRITICAL="{{ backup_repo_critical }}"
REPO_DEVICES="{{ backup_repo_devices }}"
RCLONE_TARGET="{{ backup_rclone_target }}"

# ==========================================
# 2. GENERATE DYNAMIC PATH LISTS
# ==========================================
INCLUDE_FILE=$(mktemp /tmp/restic_includes.XXXXXX)
EXCLUDE_FILE=$(mktemp /tmp/restic_excludes.XXXXXX)

cat << 'EOF' > "$INCLUDE_FILE"
{% for svc_name, svc_vars in services.items() %}
{% if 'backup' in svc_vars and svc_vars.backup.get('paths') %}
{% for path in svc_vars.backup.paths %}
{{ path }}
{% endfor %}
{% endif %}
{% endfor %}
EOF

cat << 'EOF' > "$EXCLUDE_FILE"
{% for svc_name, svc_vars in services.items() %}
{% if 'backup' in svc_vars and svc_vars.backup.get('excludes') %}
{% for path in svc_vars.backup.excludes %}
{{ path }}
{% endfor %}
{% endif %}
{% endfor %}
EOF

sed -i '/^[[:space:]]*$/d' "$INCLUDE_FILE" "$EXCLUDE_FILE"

SERVICES_TO_STOP=(
{% for svc_name, svc_vars in services.items() %}
{% if 'backup' in svc_vars and svc_vars.backup.get('stop', false) %}
  "{{ svc_vars.get('quadlet_name', svc_name ~ '.service') }}"
{% endif %}
{% endfor %}
)

# ==========================================
# 3. TRAP CLEANUP
# ==========================================
cleanup_and_start() {
    local exit_code=$?
    local script_end_time=$(date +%s)
    local duration=$((script_end_time - SCRIPT_START_TIME))
    local repo_size_bytes=0
    if [ -d "$REPO_CRITICAL" ]; then
        repo_size_bytes=$(du -sb "$REPO_CRITICAL" | cut -f1)
    fi

    echo "[INFO] Running final cleanup procedure (Trap)..."
    
    if [ {% raw %}${#SERVICES_TO_STOP[@]}{% endraw %} -gt 0 ]; then
        echo "[INFO] Restarting systemd services..."
        for service in "${SERVICES_TO_STOP[@]}"; do
            systemctl --user start "$service" || echo "[WARNING] Failed to start $service"
        done
    fi

    rm -f "$INCLUDE_FILE" "$EXCLUDE_FILE"

    local prom_success=0
    if [ $exit_code -eq 0 ]; then
        prom_success=1
        echo "[SUCCESS] Backup routine completed successfully in ${duration}s."
    else
        echo "[CRITICAL] Script failed with exit code: $exit_code after ${duration}s."
    fi

    local PROM_TMP_FILE="/tmp/homelab_backup.prom"
    local PROM_TARGET_DIR="/opt/alloy-metrics"

    cat <<EOF > "$PROM_TMP_FILE"
# HELP homelab_backup_success Whether the backup succeeded (1) or failed (0)
# TYPE homelab_backup_success gauge
homelab_backup_success $prom_success

# HELP homelab_backup_duration_seconds Time taken for the backup script to run
# TYPE homelab_backup_duration_seconds gauge
homelab_backup_duration_seconds $duration

# HELP homelab_backup_last_run_timestamp_seconds Timestamp of the last backup run
# TYPE homelab_backup_last_run_timestamp_seconds gauge
homelab_backup_last_run_timestamp_seconds $script_end_time

# HELP homelab_backup_repo_size_bytes Size of the homelab backup repository in bytes
# TYPE homelab_backup_repo_size_bytes gauge
homelab_backup_repo_size_bytes $repo_size_bytes
EOF

    if [ -d "$PROM_TARGET_DIR" ]; then
        mv "$PROM_TMP_FILE" "${PROM_TARGET_DIR}/homelab_backup.prom"
    else
        echo "[WARNING] Prometheus textfile directory $PROM_TARGET_DIR does not exist. Metrics not saved."
    fi

    exit $exit_code
}

trap cleanup_and_start EXIT INT TERM

# ==========================================
# 4. PRE-FLIGHT CHECKS
# ==========================================
echo "[INFO] Running pre-flight checks..."

if [ -s "$INCLUDE_FILE" ]; then
    export RESTIC_REPOSITORY="$REPO_CRITICAL"
    if ! restic snapshots >/dev/null 2>&1; then
        echo >&2 "[ERROR] Repository $REPO_CRITICAL does not exist, is corrupted, or password is incorrect!"
        exit 1
    fi
else
    echo "[INFO] No paths defined for backup. Exiting."
    exit 0
fi

# ==========================================
# 5. PRE-HOOK: STOP SERVICES
# ==========================================
if [ {% raw %}${#SERVICES_TO_STOP[@]}{% endraw %} -gt 0 ]; then
    echo "[INFO] Stopping stateful services (Rootless Quadlets)..."
    for service in "${SERVICES_TO_STOP[@]}"; do
        systemctl --user stop "$service"
    done
fi

# ==========================================
# 6. BACKUP: CRITICAL DATA
# ==========================================
echo "[INFO] Running Restic backup for critical data..."
export RESTIC_REPOSITORY="$REPO_CRITICAL"

restic backup \
    --files-from "$INCLUDE_FILE" \
    --exclude-file "$EXCLUDE_FILE" \
    --compression max \
    --verbose=1

echo "[INFO] Verifying repository integrity..."
restic check --read-data-subset=10% || { echo "[ERROR] Repository is corrupted!"; exit 1; }

if [ {% raw %}${#SERVICES_TO_STOP[@]}{% endraw %} -gt 0 ]; then
    echo "[INFO] Local backups finished. Fast restarting services..."
    for service in "${SERVICES_TO_STOP[@]}"; do
        systemctl --user start "$service"
    done
    SERVICES_TO_STOP=()
fi

# ==========================================
# 7. CLOUD SYNC (Rclone)
# ==========================================
echo "[INFO] Syncing local repositories to the cloud..."

rclone sync "$REPO_CRITICAL" "${RCLONE_TARGET}/homelab" --fast-list --transfers 8

if [ -d "$REPO_DEVICES" ]; then
    echo "[INFO] Syncing external device repositories..."
    rclone sync "$REPO_DEVICES" "${RCLONE_TARGET}/devices" --fast-list --transfers 8
fi

# ==========================================
# 8. RETENTION (Pruning)
# ==========================================
echo "[INFO] Running retention policy (Prune)..."
export RESTIC_REPOSITORY="$REPO_CRITICAL"
restic forget --prune --keep-daily 7 --keep-weekly 4 --keep-monthly 6
