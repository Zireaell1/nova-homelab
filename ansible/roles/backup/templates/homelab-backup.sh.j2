#!/usr/bin/env bash

set -Eeuo pipefail

# ==========================================
# 1. CONFIGURATION
# ==========================================
SCRIPT_START_TIME=$(date +%s)

export RESTIC_PASSWORD_FILE="{{ backup_restic_password_file }}"
export XDG_CONFIG_HOME="{{ user_config_path }}"

REPO_CRITICAL="{{ local_backup_path }}"
REPO_DEVICES_ROOT="{{ restic_server_path }}"
RCLONE_TARGET="{{ backup_rclone_target }}"
CANARY_FILE="{{ backup_canary_file }}"
PROM_TARGET_DIR="{{ textfile_metrics_path }}"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/homelab-backup.lock"

B2_QUOTA_BYTES="{{ backup_b2_quota_bytes }}"

GLOBAL_SUCCESS=1
RCLONE_SUCCESS=1
PRUNE_SUCCESS=1
QUOTA_EXCEEDED=0
INTERRUPTED=0

LOCAL_BACKUP_DURATION=0
CLOUD_SYNC_DURATION=0
PRUNE_DURATION=0

INCLUDE_FILE=""
EXCLUDE_FILE=""

STOPPED=()

# ==========================================
# 2. HELPERS
# ==========================================
log()  { echo    "[INFO] $*"; }
warn() { echo    "[WARNING] $*"; }
err()  { echo >&2 "[ERROR] $*"; }

on_err() {
    err "Unhandled failure at line ${1} (exit ${2}) -- aborting."
    GLOBAL_SUCCESS=0
}
trap 'on_err "${LINENO}" "$?"' ERR

on_signal() {
    INTERRUPTED=1
    warn "Received a termination signal; unwinding."
}
trap on_signal INT TERM

abort_if_interrupted() {
    if [ "$INTERRUPTED" -eq 1 ]; then
        GLOBAL_SUCCESS=0
        err "Interrupted -- not starting the next stage."
        exit 1
    fi
}

# ==========================================
# 3. SERVICES
# ==========================================
stop_services() {
    local svc
    for svc in "${SERVICES_TO_STOP[@]}"; do
        log "Stopping ${svc}"
        if systemctl --user stop "$svc"; then
            STOPPED+=("$svc")
        else
            err "Could not stop ${svc} -- refusing to snapshot it live."
            GLOBAL_SUCCESS=0
            return 1
        fi
    done
    return 0
}

start_services() {
    local svc
    local remaining=()
    for svc in "${STOPPED[@]}"; do
        if systemctl --user start "$svc"; then
            log "Started ${svc}"
        else
            err "Failed to start ${svc}"
            GLOBAL_SUCCESS=0
            remaining+=("$svc")
        fi
    done
    STOPPED=("${remaining[@]+"${remaining[@]}"}")
}

# ==========================================
# 4. METRICS
# ==========================================
write_metrics() {
    local end_time="$1" duration="$2" exit_code="$3"
    local repo_size_bytes=0 snapshot_count=0 b2_size_bytes=0
    local tmp

    if [ -d "$REPO_CRITICAL" ]; then
        repo_size_bytes=$(du -sb "$REPO_CRITICAL" 2>/dev/null | cut -f1 || echo 0)
        export RESTIC_REPOSITORY="$REPO_CRITICAL"
        snapshot_count=$(restic snapshots --json 2>/dev/null | jq length 2>/dev/null || echo 0)
    fi

    if [ "$INTERRUPTED" -eq 0 ]; then
        local b2_info
        if b2_info=$(rclone size "${RCLONE_TARGET}/homelab" --json \
                        --contimeout 10s --timeout 60s --retries 1 2>/dev/null); then
            b2_size_bytes=$(echo "$b2_info" | jq -r '.bytes' 2>/dev/null || echo 0)
        fi
    fi

    if [ ! -d "$PROM_TARGET_DIR" ]; then
        warn "Metrics directory ${PROM_TARGET_DIR} does not exist; metrics not saved."
        return 0
    fi

    tmp="${PROM_TARGET_DIR}/.homelab_backup.prom.$$"

    cat <<EOF > "$tmp"
# HELP homelab_backup_success Whether the local Restic backup succeeded (1) or failed (0)
# TYPE homelab_backup_success gauge
homelab_backup_success $GLOBAL_SUCCESS

# HELP homelab_backup_cloud_sync_success Whether the Rclone cloud sync succeeded (1) or failed (0)
# TYPE homelab_backup_cloud_sync_success gauge
homelab_backup_cloud_sync_success $RCLONE_SUCCESS

# HELP homelab_backup_prune_success Whether the retention policy prune succeeded (1) or failed (0)
# TYPE homelab_backup_prune_success gauge
homelab_backup_prune_success $PRUNE_SUCCESS

# HELP homelab_backup_quota_exceeded Whether the projected B2 size exceeded the limit (1) or not (0)
# TYPE homelab_backup_quota_exceeded gauge
homelab_backup_quota_exceeded $QUOTA_EXCEEDED

# HELP homelab_backup_services_down Services stopped for the snapshot that did not come back
# TYPE homelab_backup_services_down gauge
homelab_backup_services_down ${#STOPPED[@]}

# HELP homelab_backup_exit_code Exit status of the backup script
# TYPE homelab_backup_exit_code gauge
homelab_backup_exit_code $exit_code

# HELP homelab_backup_duration_seconds Time taken for the total backup script to run
# TYPE homelab_backup_duration_seconds gauge
homelab_backup_duration_seconds $duration

# HELP homelab_backup_stage_duration_seconds Time taken for individual backup stages
# TYPE homelab_backup_stage_duration_seconds gauge
homelab_backup_stage_duration_seconds{stage="local_backup"} $LOCAL_BACKUP_DURATION
homelab_backup_stage_duration_seconds{stage="cloud_sync"} $CLOUD_SYNC_DURATION
homelab_backup_stage_duration_seconds{stage="prune"} $PRUNE_DURATION

# HELP homelab_backup_last_run_timestamp_seconds Timestamp of the last backup run
# TYPE homelab_backup_last_run_timestamp_seconds gauge
homelab_backup_last_run_timestamp_seconds $end_time

# HELP homelab_backup_repo_size_bytes Size of the homelab backup repository in bytes
# TYPE homelab_backup_repo_size_bytes gauge
homelab_backup_repo_size_bytes $repo_size_bytes

# HELP homelab_backup_b2_size_bytes Size of the synced backup in B2 cloud in bytes
# TYPE homelab_backup_b2_size_bytes gauge
homelab_backup_b2_size_bytes $b2_size_bytes

# HELP homelab_backup_snapshot_count Total number of snapshots in the critical repository
# TYPE homelab_backup_snapshot_count gauge
homelab_backup_snapshot_count $snapshot_count

# HELP homelab_backup_path_info Information about included and excluded paths per service
# TYPE homelab_backup_path_info gauge
{% for t in backup_targets %}
{% for path in t.paths | default([]) %}
homelab_backup_path_info{service="{{ t.name }}", path="{{ path }}", type="include"} 1
{% endfor %}
{% for path in t.excludes | default([]) %}
homelab_backup_path_info{service="{{ t.name }}", path="{{ path }}", type="exclude"} 1
{% endfor %}
{% endfor %}
EOF

    mv -f "$tmp" "${PROM_TARGET_DIR}/homelab_backup.prom"
}

# ==========================================
# 5. CLEANUP
# ==========================================
cleanup() {
    local rc=$?
    trap - EXIT ERR INT TERM

    if [ "${#STOPPED[@]}" -gt 0 ]; then
        log "Restarting services held for the snapshot..."
        start_services
    fi

    [ -n "$INCLUDE_FILE" ] && rm -f "$INCLUDE_FILE"
    [ -n "$EXCLUDE_FILE" ] && rm -f "$EXCLUDE_FILE"

    local end_time duration
    end_time=$(date +%s)
    duration=$((end_time - SCRIPT_START_TIME))

    if [ "$GLOBAL_SUCCESS" -eq 1 ] && [ "$RCLONE_SUCCESS" -eq 1 ] \
       && [ "$PRUNE_SUCCESS" -eq 1 ] && [ "$QUOTA_EXCEEDED" -eq 0 ]; then
        log "Backup routine completed successfully in ${duration}s."
        rc=0
    else
        err "Backup finished with errors after ${duration}s."
        [ "$rc" -eq 0 ] && rc=1
    fi

    if [ "${#STOPPED[@]}" -gt 0 ]; then
        err "STILL DOWN: ${STOPPED[*]} -- these need manual attention."
    fi

    write_metrics "$end_time" "$duration" "$rc" || warn "Failed to write metrics."

    exit "$rc"
}
trap cleanup EXIT

# ==========================================
# 6. SINGLE-INSTANCE LOCK
# ==========================================
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    log "Another backup run holds the lock; exiting."
    trap - EXIT
    exit 0
fi

# ==========================================
# 7. BUILD PATH LISTS
# ==========================================
INCLUDE_FILE=$(mktemp /tmp/restic_includes.XXXXXX)
EXCLUDE_FILE=$(mktemp /tmp/restic_excludes.XXXXXX)

cat << 'EOF' > "$INCLUDE_FILE"
{% for t in backup_targets %}
{% for path in t.paths | default([]) %}
{{ path }}
{% endfor %}
{% endfor %}
EOF

cat << 'EOF' > "$EXCLUDE_FILE"
{% for t in backup_targets %}
{% for path in t.excludes | default([]) %}
{{ path }}
{% endfor %}
{% endfor %}
EOF

sed -i '/^[[:space:]]*$/d' "$INCLUDE_FILE" "$EXCLUDE_FILE"

if [ ! -s "$INCLUDE_FILE" ]; then
    err "backup_targets produced no paths -- refusing to write an empty snapshot."
    GLOBAL_SUCCESS=0
    exit 1
fi

log "Writing canary to ${CANARY_FILE}"
mkdir -p "$(dirname "$CANARY_FILE")"
echo "$SCRIPT_START_TIME" > "$CANARY_FILE"
echo "$CANARY_FILE" >> "$INCLUDE_FILE"

SERVICES_TO_STOP=(
{% for t in backup_targets if t.stop | default(false) %}
  "{{ t.name }}.service"
{% endfor %}
)

# ==========================================
# 8. PRE-FLIGHT
# ==========================================
log "Running pre-flight checks..."
export RESTIC_REPOSITORY="$REPO_CRITICAL"

restic unlock || warn "restic unlock reported a problem; continuing."

if ! restic snapshots >/dev/null 2>&1; then
    err "Repository ${REPO_CRITICAL} is missing, corrupt, or the password is wrong."
    GLOBAL_SUCCESS=0
    exit 1
fi

# ==========================================
# 9. QUIESCE AND SNAPSHOT
# ==========================================
if [ "${#SERVICES_TO_STOP[@]}" -gt 0 ]; then
    log "Stopping stateful services..."
    stop_services || exit 1
fi

log "Running Restic backup for critical data..."
LOCAL_BACKUP_START=$(date +%s)

restic backup \
    --files-from "$INCLUDE_FILE" \
    --exclude-file "$EXCLUDE_FILE" \
    --compression max \
    --verbose=1 || GLOBAL_SUCCESS=0

LOCAL_BACKUP_DURATION=$(( $(date +%s) - LOCAL_BACKUP_START ))

if [ "${#STOPPED[@]}" -gt 0 ]; then
    log "Snapshot complete; restarting services..."
    start_services
fi

abort_if_interrupted

# ==========================================
# 10. INTEGRITY CHECK
# ==========================================
log "Verifying repository integrity..."
restic check --read-data-subset=10% || {
    err "Repository check failed."
    GLOBAL_SUCCESS=0
}

abort_if_interrupted

# ==========================================
# 11. CLOUD SYNC
# ==========================================
log "Syncing local repositories to the cloud..."
CLOUD_SYNC_START=$(date +%s)

if [ "$B2_QUOTA_BYTES" -gt 0 ]; then
    log "Checking quota (max ${B2_QUOTA_BYTES} bytes)..."
    LOCAL_SIZE_CRITICAL=$(du -sb "$REPO_CRITICAL" 2>/dev/null | cut -f1 || echo 0)
    LOCAL_SIZE_DEVICES_CLOUD=$(find "$REPO_DEVICES_ROOT" -mindepth 2 -maxdepth 2 \
        -type d -name "cloud" -exec du -sb {} + 2>/dev/null | awk '{s+=$1} END {print s+0}')
    TOTAL_PROJECTED_SIZE=$((LOCAL_SIZE_CRITICAL + LOCAL_SIZE_DEVICES_CLOUD))

    if [ "$TOTAL_PROJECTED_SIZE" -gt "$B2_QUOTA_BYTES" ]; then
        err "Projected cloud size (${TOTAL_PROJECTED_SIZE}) exceeds the limit (${B2_QUOTA_BYTES})."
        QUOTA_EXCEEDED=1
        RCLONE_SUCCESS=0
    else
        log "Projected size (${TOTAL_PROJECTED_SIZE}) is within quota."
    fi
fi

if [ "$QUOTA_EXCEEDED" -eq 0 ] && [ "$GLOBAL_SUCCESS" -eq 1 ]; then
    rclone sync "$REPO_CRITICAL" "${RCLONE_TARGET}/homelab" \
        --fast-list --transfers 8 || RCLONE_SUCCESS=0
else
    warn "Skipping the homelab repo sync."
fi

if [ "$QUOTA_EXCEEDED" -eq 0 ] && [ -d "$REPO_DEVICES_ROOT" ]; then
    log "Syncing external device repositories (cloud tier only)..."
    rclone sync "$REPO_DEVICES_ROOT" "${RCLONE_TARGET}/devices" \
        --include "/*/cloud/**" \
        --fast-list --transfers 8 || RCLONE_SUCCESS=0
fi

CLOUD_SYNC_DURATION=$(( $(date +%s) - CLOUD_SYNC_START ))

abort_if_interrupted

# ==========================================
# 12. RETENTION
# ==========================================
log "Running retention policy..."
PRUNE_START=$(date +%s)

restic forget --prune --keep-daily 7 --keep-weekly 4 --keep-monthly 6 || {
    err "Prune failed."
    GLOBAL_SUCCESS=0
    PRUNE_SUCCESS=0
}

PRUNE_DURATION=$(( $(date +%s) - PRUNE_START ))
