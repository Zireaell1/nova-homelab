#!/usr/bin/env bash
#
# Homelab backup: restic to a local repo, rclone to B2. Runs nightly from homelab-backup.timer
# (01:00); verify and podman-prune follow through OnSuccess=/OnFailure=.
#
# ==============================================================================
# Commands used in this script, in the order they run:
#
# * flock -n 9                                  : One run at a time (lock file in $XDG_RUNTIME_DIR); a second run exits 0.
# * restic unlock                               : Removes stale locks a killed run left behind; live locks are kept.
# * restic snapshots                            : Pre-flight: the repository exists and the password opens it.
# * podman --version / ps -a / images --digests : Writes versions.txt (what ran when this snapshot was taken) into the snapshot.
# * systemctl --user stop|start <name>.service  : Quiesces every backup_targets entry with stop: true, restarts it right after.
# * restic backup --files-from --exclude-file --compression max
#                                               : The snapshot: backup_targets paths + canary.txt + versions.txt.
# * restic check --read-data-subset=<weekday>/7 : Reads a seventh of the data packs each night, so all of them every week.
# * rclone lsf <b2>/homelab --include /config + rclone cat <b2>/homelab/config
#                                               : Repo-identity guard: B2 must hold this repository (byte-equal config) or none.
# * rclone sync <repo> <b2>/homelab --fast-list --transfers 8 --immutable --retries 5 --retries-sleep 2m --max-delete-size <25%>
#                                               : Mirrors the repository. --immutable: never overwrite an existing file
#                                                 (restic never rewrites one). --max-delete-size: a wiped source can't empty B2.
# * rclone sync <rest-server root> <b2>/devices --include "/*/cloud/**" (same flags)
#                                               : Device repositories of the cloud tier only; local tier never leaves the house.
# * restic forget --prune --keep-daily 7 --keep-weekly 4 --keep-monthly 6
#                                               : Retention, after the sync (B2 gets tonight's snapshot before anything is deleted).
# * du -sb / find                               : Local size per repository and device tier (quota, delete budget, metrics).
# * restic snapshots --json | jq length         : Snapshot count for the metrics.
# * rclone size <b2> --b2-versions --json / rclone size <b2> --json
#                                               : What B2 bills (hidden versions included) and the current files; the difference is
#                                                 homelab_backup_b2_hidden_bytes.
#
# Environment: RESTIC_PASSWORD_FILE, RESTIC_REPOSITORY, XDG_CONFIG_HOME (rclone reads rclone/rclone.conf from it).
# Writes: <textfile dir>/homelab_backup.prom (temp file + rename), canary.txt, versions.txt.
# ==============================================================================
#

set -Eeuo pipefail

# ==========================================
# 1. CONFIGURATION
# ==========================================
SCRIPT_START_TIME=$(date +%s)

export RESTIC_PASSWORD_FILE="{{ backup_restic_password_file }}"
export XDG_CONFIG_HOME="{{ user_config_path }}"

REPO_CRITICAL="{{ local_backup_path }}"
REPO_DEVICES_ROOT="{{ restic_server_path }}"
RCLONE_TARGET="{{ backup_rclone_target }}"
CANARY_FILE="{{ backup_canary_file }}"
PROM_TARGET_DIR="{{ textfile_metrics_path }}"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/homelab-backup.lock"

B2_QUOTA_BYTES="{{ backup_b2_quota_bytes }}"

MAX_DELETE_PERCENT="{{ backup_rclone_max_delete_percent }}"
MAX_DELETE_MIN_BYTES="{{ backup_rclone_max_delete_min_bytes }}"
RCLONE_SAFETY=(--fast-list --transfers 8 --immutable
    --retries "{{ backup_rclone_retries }}" --retries-sleep "{{ backup_rclone_retries_sleep }}")

GLOBAL_SUCCESS=1
RCLONE_SUCCESS=1
PRUNE_SUCCESS=1
QUOTA_EXCEEDED=0
REPO_MISMATCH=0
INTERRUPTED=0

LOCAL_BACKUP_DURATION=0
CLOUD_SYNC_DURATION=0
PRUNE_DURATION=0

LOCAL_SIZE_HOMELAB=0
LOCAL_SIZE_DEVICES_CLOUD=0
LOCAL_SIZE_DEVICES_LOCAL=0
DEVICES_UNKNOWN_TIERS=0

INCLUDE_FILE=""
EXCLUDE_FILE=""

# Services we stopped and have not yet successfully restarted.
STOPPED=()

# ==========================================
# 2. HELPERS
# ==========================================
log()  { echo    "[INFO] $*"; }
warn() { echo    "[WARNING] $*"; }
err()  { echo >&2 "[ERROR] $*"; }

on_err() {
    err "Unhandled failure at line ${1} (exit ${2}) -- aborting."
    GLOBAL_SUCCESS=0
}
trap 'on_err "${LINENO}" "$?"' ERR

on_signal() {
    INTERRUPTED=1
    warn "Received a termination signal; unwinding."
}
trap on_signal INT TERM

abort_if_interrupted() {
    if [ "$INTERRUPTED" -eq 1 ]; then
        GLOBAL_SUCCESS=0
        err "Interrupted -- not starting the next stage."
        exit 1
    fi
}

# ==========================================
# 3. SIZE ACCOUNTING
# ==========================================
# The rest-server layout is <user>/<tier>/<device>, where the tier decides
# whether the data ever leaves the house (see the client script in
# roles/caddy/files/srv/windows-device-critical-backup.cmd):
#
#   LOCAL_SIZE_HOMELAB        Nova's own repo
#   LOCAL_SIZE_DEVICES_CLOUD  <user>/cloud/*  -- synced to B2, counts against quota
#   LOCAL_SIZE_DEVICES_LOCAL  <user>/local/*  -- stays on this machine forever
#
measure_local() {
    LOCAL_SIZE_HOMELAB=0
    LOCAL_SIZE_DEVICES_CLOUD=0
    LOCAL_SIZE_DEVICES_LOCAL=0
    DEVICES_UNKNOWN_TIERS=0

    if [ -d "$REPO_CRITICAL" ]; then
        LOCAL_SIZE_HOMELAB=$(du -sb "$REPO_CRITICAL" 2>/dev/null | cut -f1) \
            || LOCAL_SIZE_HOMELAB=0
    fi

    if [ -d "$REPO_DEVICES_ROOT" ]; then
        LOCAL_SIZE_DEVICES_CLOUD=$(find "$REPO_DEVICES_ROOT" -mindepth 2 -maxdepth 2 \
            -type d -name "cloud" -exec du -sb {} + 2>/dev/null \
            | awk '{s+=$1} END {print s+0}') || LOCAL_SIZE_DEVICES_CLOUD=0
        LOCAL_SIZE_DEVICES_LOCAL=$(find "$REPO_DEVICES_ROOT" -mindepth 2 -maxdepth 2 \
            -type d -name "local" -exec du -sb {} + 2>/dev/null \
            | awk '{s+=$1} END {print s+0}') || LOCAL_SIZE_DEVICES_LOCAL=0
        DEVICES_UNKNOWN_TIERS=$(find "$REPO_DEVICES_ROOT" -mindepth 2 -maxdepth 2 \
            -type d ! -name "cloud" ! -name "local" 2>/dev/null \
            | wc -l) || DEVICES_UNKNOWN_TIERS=0
    fi

    [ -n "$LOCAL_SIZE_HOMELAB" ]       || LOCAL_SIZE_HOMELAB=0
    [ -n "$LOCAL_SIZE_DEVICES_CLOUD" ] || LOCAL_SIZE_DEVICES_CLOUD=0
    [ -n "$LOCAL_SIZE_DEVICES_LOCAL" ] || LOCAL_SIZE_DEVICES_LOCAL=0
    [ -n "$DEVICES_UNKNOWN_TIERS" ]    || DEVICES_UNKNOWN_TIERS=0
}

max_delete_bytes() {
    local size="$1" budget
    budget=$(( size * MAX_DELETE_PERCENT / 100 ))
    [ "$budget" -lt "$MAX_DELETE_MIN_BYTES" ] && budget=$MAX_DELETE_MIN_BYTES
    echo "$budget"
}

check_b2_repo_identity() {
    local listing remote_cfg rc=0
    listing=$(rclone lsf "${RCLONE_TARGET}/homelab" --files-only --max-depth 1 \
                --include "/config" --contimeout 10s --timeout 60s --retries 1 2>/dev/null) || rc=$?
    if [ "$rc" -eq 3 ] || { [ "$rc" -eq 0 ] && [ -z "$listing" ]; }; then
        log "No repository on B2 yet; the first sync creates it."
        return 0
    fi
    if [ "$rc" -ne 0 ]; then
        err "Could not list ${RCLONE_TARGET}/homelab (rclone exit ${rc}); not syncing blind."
        return 1
    fi
    remote_cfg=$(rclone cat "${RCLONE_TARGET}/homelab/config" --contimeout 10s --timeout 60s \
                    2>/dev/null | base64 -w0) || rc=$?
    if [ "$rc" -ne 0 ] || [ -z "$remote_cfg" ]; then
        err "Could not read the repository config on B2 (rclone exit ${rc}); not syncing blind."
        return 1
    fi
    if [ "$remote_cfg" != "$(base64 -w0 < "${REPO_CRITICAL}/config")" ]; then
        err "B2 holds a DIFFERENT restic repository than ${REPO_CRITICAL}; refusing to sync over it."
        err "Rebuild? Bring the repository back from B2 first: make restore_nova mode=seed"
        REPO_MISMATCH=1
        return 1
    fi
    return 0
}

# ==========================================
# 4. SERVICES
# ==========================================
stop_services() {
    local svc
    for svc in "${SERVICES_TO_STOP[@]}"; do
        log "Stopping ${svc}"
        if systemctl --user stop "$svc"; then
            STOPPED+=("$svc")
        else
            err "Could not stop ${svc} -- refusing to snapshot it live."
            GLOBAL_SUCCESS=0
            return 1
        fi
    done
    return 0
}

start_services() {
    local svc
    local remaining=()
    for svc in "${STOPPED[@]}"; do
        if systemctl --user start "$svc"; then
            log "Started ${svc}"
        else
            err "Failed to start ${svc}"
            GLOBAL_SUCCESS=0
            remaining+=("$svc")
        fi
    done
    STOPPED=("${remaining[@]+"${remaining[@]}"}")
}

# ==========================================
# 5. METRICS
# ==========================================
write_metrics() {
    local end_time="$1" duration="$2" exit_code="$3"
    local snapshot_count=0 b2_size_bytes=0 b2_current_bytes=0 b2_hidden_bytes=0
    local tmp

    measure_local

    if [ -d "$REPO_CRITICAL" ]; then
        export RESTIC_REPOSITORY="$REPO_CRITICAL"
        snapshot_count=$(restic snapshots --json 2>/dev/null | jq length 2>/dev/null || echo 0)
    fi

    if [ "$INTERRUPTED" -eq 0 ]; then
        local b2_info
        if b2_info=$(rclone size "${RCLONE_TARGET}" --b2-versions --fast-list --json \
                        --contimeout 10s --timeout 60s --retries 1 2>/dev/null); then
            b2_size_bytes=$(echo "$b2_info" | jq -r '.bytes' 2>/dev/null || echo 0)
        fi
        if b2_info=$(rclone size "${RCLONE_TARGET}" --fast-list --json \
                        --contimeout 10s --timeout 60s --retries 1 2>/dev/null); then
            b2_current_bytes=$(echo "$b2_info" | jq -r '.bytes' 2>/dev/null || echo 0)
        fi
        [ "$b2_size_bytes" -ge "$b2_current_bytes" ] 2>/dev/null \
            && b2_hidden_bytes=$(( b2_size_bytes - b2_current_bytes ))
    fi

    if [ ! -d "$PROM_TARGET_DIR" ]; then
        warn "Metrics directory ${PROM_TARGET_DIR} does not exist; metrics not saved."
        return 0
    fi

    tmp="${PROM_TARGET_DIR}/.homelab_backup.prom.$$"

    cat <<EOF > "$tmp"
# HELP homelab_backup_success Whether the local Restic backup succeeded (1) or failed (0)
# TYPE homelab_backup_success gauge
homelab_backup_success $GLOBAL_SUCCESS

# HELP homelab_backup_cloud_sync_success Whether the Rclone cloud sync succeeded (1) or failed (0)
# TYPE homelab_backup_cloud_sync_success gauge
homelab_backup_cloud_sync_success $RCLONE_SUCCESS

# HELP homelab_backup_prune_success Whether the retention policy prune succeeded (1) or failed (0)
# TYPE homelab_backup_prune_success gauge
homelab_backup_prune_success $PRUNE_SUCCESS

# HELP homelab_backup_quota_exceeded Whether the projected B2 size exceeded the limit (1) or not (0)
# TYPE homelab_backup_quota_exceeded gauge
homelab_backup_quota_exceeded $QUOTA_EXCEEDED

# HELP homelab_backup_services_down Services stopped for the snapshot that did not come back
# TYPE homelab_backup_services_down gauge
homelab_backup_services_down {% raw %}${#STOPPED[@]}{% endraw %}

# HELP homelab_backup_exit_code Exit status of the backup script
# TYPE homelab_backup_exit_code gauge
homelab_backup_exit_code $exit_code

# HELP homelab_backup_duration_seconds Time taken for the total backup script to run
# TYPE homelab_backup_duration_seconds gauge
homelab_backup_duration_seconds $duration

# HELP homelab_backup_stage_duration_seconds Time taken for individual backup stages
# TYPE homelab_backup_stage_duration_seconds gauge
homelab_backup_stage_duration_seconds{stage="local_backup"} $LOCAL_BACKUP_DURATION
homelab_backup_stage_duration_seconds{stage="cloud_sync"} $CLOUD_SYNC_DURATION
homelab_backup_stage_duration_seconds{stage="prune"} $PRUNE_DURATION

# HELP homelab_backup_last_run_timestamp_seconds Timestamp of the last backup run
# TYPE homelab_backup_last_run_timestamp_seconds gauge
homelab_backup_last_run_timestamp_seconds $end_time

# HELP homelab_backup_repo_size_bytes Local disk used per repository; the series do not overlap
# TYPE homelab_backup_repo_size_bytes gauge
homelab_backup_repo_size_bytes{repo="homelab"} $LOCAL_SIZE_HOMELAB
homelab_backup_repo_size_bytes{repo="devices_cloud"} $LOCAL_SIZE_DEVICES_CLOUD
homelab_backup_repo_size_bytes{repo="devices_local"} $LOCAL_SIZE_DEVICES_LOCAL

# HELP homelab_backup_devices_unknown_tiers Device repo directories that are neither cloud nor local
# TYPE homelab_backup_devices_unknown_tiers gauge
homelab_backup_devices_unknown_tiers $DEVICES_UNKNOWN_TIERS

# HELP homelab_backup_b2_size_bytes Total size of the B2 bucket (all tiers), hidden versions included: what B2 bills
# TYPE homelab_backup_b2_size_bytes gauge
homelab_backup_b2_size_bytes $b2_size_bytes

# HELP homelab_backup_b2_hidden_bytes Part of the B2 size held as hidden versions (kept by the bucket lifecycle rule)
# TYPE homelab_backup_b2_hidden_bytes gauge
homelab_backup_b2_hidden_bytes $b2_hidden_bytes

# HELP homelab_backup_b2_repo_mismatch Whether B2 holds a different restic repository than the local one (1); the sync was refused
# TYPE homelab_backup_b2_repo_mismatch gauge
homelab_backup_b2_repo_mismatch $REPO_MISMATCH

# HELP homelab_backup_b2_quota_bytes Configured ceiling the projected cloud size is compared against
# TYPE homelab_backup_b2_quota_bytes gauge
homelab_backup_b2_quota_bytes $B2_QUOTA_BYTES

# HELP homelab_backup_snapshot_count Total number of snapshots in the critical repository
# TYPE homelab_backup_snapshot_count gauge
homelab_backup_snapshot_count $snapshot_count

# HELP homelab_backup_path_info Information about included and excluded paths per service
# TYPE homelab_backup_path_info gauge
{% for t in backup_targets %}
{% for path in t.paths | default([]) %}
homelab_backup_path_info{service="{{ t.name }}", path="{{ path }}", type="include"} 1
{% endfor %}
{% for path in t.excludes | default([]) %}
homelab_backup_path_info{service="{{ t.name }}", path="{{ path }}", type="exclude"} 1
{% endfor %}
{% endfor %}
EOF

    mv -f "$tmp" "${PROM_TARGET_DIR}/homelab_backup.prom"
}

# ==========================================
# 6. CLEANUP
# ==========================================
cleanup() {
    local rc=$?
    trap - EXIT ERR INT TERM

    if [ "{% raw %}${#STOPPED[@]}{% endraw %}" -gt 0 ]; then
        log "Restarting services held for the snapshot..."
        start_services
    fi

    [ -n "$INCLUDE_FILE" ] && rm -f "$INCLUDE_FILE"
    [ -n "$EXCLUDE_FILE" ] && rm -f "$EXCLUDE_FILE"

    local end_time duration
    end_time=$(date +%s)
    duration=$((end_time - SCRIPT_START_TIME))

    if [ "$rc" -eq 0 ] && [ "$GLOBAL_SUCCESS" -eq 1 ] && [ "$RCLONE_SUCCESS" -eq 1 ] \
       && [ "$PRUNE_SUCCESS" -eq 1 ] && [ "$QUOTA_EXCEEDED" -eq 0 ]; then
        log "Backup routine completed successfully in ${duration}s."
    else
        err "Backup finished with errors after ${duration}s."
        [ "$rc" -eq 0 ] && rc=1
    fi

    if [ "{% raw %}${#STOPPED[@]}{% endraw %}" -gt 0 ]; then
        err "STILL DOWN: ${STOPPED[*]} -- these need manual attention."
    fi

    write_metrics "$end_time" "$duration" "$rc" || warn "Failed to write metrics."

    exit "$rc"
}
trap cleanup EXIT

# ==========================================
# 7. SINGLE-INSTANCE LOCK
# ==========================================
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
    log "Another backup run holds the lock; exiting."
    trap - EXIT
    exit 0
fi

# ==========================================
# 8. BUILD PATH LISTS
# ==========================================
INCLUDE_FILE=$(mktemp /tmp/restic_includes.XXXXXX)
EXCLUDE_FILE=$(mktemp /tmp/restic_excludes.XXXXXX)

cat << 'EOF' > "$INCLUDE_FILE"
{% for t in backup_targets %}
{% for path in t.paths | default([]) %}
{{ path }}
{% endfor %}
{% endfor %}
EOF

cat << 'EOF' > "$EXCLUDE_FILE"
{% for t in backup_targets %}
{% for path in t.excludes | default([]) %}
{{ path }}
{% endfor %}
{% endfor %}
EOF

sed -i '/^[[:space:]]*$/d' "$INCLUDE_FILE" "$EXCLUDE_FILE"

if [ ! -s "$INCLUDE_FILE" ]; then
    err "backup_targets produced no paths -- refusing to write an empty snapshot."
    GLOBAL_SUCCESS=0
    exit 1
fi

log "Writing canary to ${CANARY_FILE}"
mkdir -p "$(dirname "$CANARY_FILE")"
echo "$SCRIPT_START_TIME" > "$CANARY_FILE"
echo "$CANARY_FILE" >> "$INCLUDE_FILE"

MANIFEST_FILE="$(dirname "$CANARY_FILE")/versions.txt"
log "Writing version manifest to ${MANIFEST_FILE}"
{% raw %}
{
    echo "# homelab-backup $(date -Is): what was running when this snapshot was taken"
    echo "host: $(hostname)  kernel: $(uname -r)  os: $(. /etc/os-release && echo "$PRETTY_NAME")"
    podman --version
    echo
    echo "## containers (name, image, image id, status)"
    podman ps -a --format '{{.Names}}\t{{.Image}}\t{{.ImageID}}\t{{.Status}}' | sort
    echo
    echo "## images (repository:tag, digest, id)"
    podman images --digests --format '{{.Repository}}:{{.Tag}}\t{{.Digest}}\t{{.ID}}' | sort
} > "$MANIFEST_FILE" 2>&1 || warn "Could not write the version manifest; the backup continues without it."
{% endraw %}
echo "$MANIFEST_FILE" >> "$INCLUDE_FILE"

SERVICES_TO_STOP=(
{% for t in backup_targets if t.stop | default(false) %}
  "{{ t.name }}.service"
{% endfor %}
)

# ==========================================
# 9. PRE-FLIGHT
# ==========================================
log "Running pre-flight checks..."
export RESTIC_REPOSITORY="$REPO_CRITICAL"

restic unlock || warn "restic unlock reported a problem; continuing."

if ! restic snapshots >/dev/null 2>&1; then
    err "Repository ${REPO_CRITICAL} is missing, corrupt, or the password is wrong."
    GLOBAL_SUCCESS=0
    exit 1
fi

# ==========================================
# 10. QUIESCE AND SNAPSHOT
# ==========================================
if [ "{% raw %}${#SERVICES_TO_STOP[@]}{% endraw %}" -gt 0 ]; then
    log "Stopping stateful services..."
    stop_services || exit 1
fi

log "Running Restic backup for critical data..."
LOCAL_BACKUP_START=$(date +%s)

restic backup \
    --files-from "$INCLUDE_FILE" \
    --exclude-file "$EXCLUDE_FILE" \
    --compression max \
    --verbose=1 || GLOBAL_SUCCESS=0

LOCAL_BACKUP_DURATION=$(( $(date +%s) - LOCAL_BACKUP_START ))

if [ "{% raw %}${#STOPPED[@]}{% endraw %}" -gt 0 ]; then
    log "Snapshot complete; restarting services..."
    start_services
fi

abort_if_interrupted

# ==========================================
# 11. INTEGRITY CHECK
# ==========================================
log "Verifying repository integrity..."
restic check --read-data-subset="$(date +%u)/7" || {
    err "Repository check failed."
    GLOBAL_SUCCESS=0
}

abort_if_interrupted

# ==========================================
# 12. CLOUD SYNC
# ==========================================
log "Syncing local repositories to the cloud..."
CLOUD_SYNC_START=$(date +%s)

measure_local

if [ "$B2_QUOTA_BYTES" -gt 0 ]; then
    log "Checking quota (max ${B2_QUOTA_BYTES} bytes)..."
    TOTAL_PROJECTED_SIZE=$((LOCAL_SIZE_HOMELAB + LOCAL_SIZE_DEVICES_CLOUD))

    if [ "$TOTAL_PROJECTED_SIZE" -gt "$B2_QUOTA_BYTES" ]; then
        err "Projected cloud size (${TOTAL_PROJECTED_SIZE}) exceeds the limit (${B2_QUOTA_BYTES})."
        QUOTA_EXCEEDED=1
        RCLONE_SUCCESS=0
    else
        log "Projected size (${TOTAL_PROJECTED_SIZE}) is within quota."
    fi
fi

if [ "$QUOTA_EXCEEDED" -eq 0 ] && [ "$GLOBAL_SUCCESS" -eq 1 ]; then
    if check_b2_repo_identity; then
        rclone sync "$REPO_CRITICAL" "${RCLONE_TARGET}/homelab" "${RCLONE_SAFETY[@]}" \
            --max-delete-size "$(max_delete_bytes "$LOCAL_SIZE_HOMELAB")B" || RCLONE_SUCCESS=0
    else
        RCLONE_SUCCESS=0
    fi
else
    warn "Skipping the homelab repo sync."
fi

if [ "$QUOTA_EXCEEDED" -eq 0 ] && [ -d "$REPO_DEVICES_ROOT" ]; then
    log "Syncing external device repositories (cloud tier only)..."
    rclone sync "$REPO_DEVICES_ROOT" "${RCLONE_TARGET}/devices" \
        --include "/*/cloud/**" "${RCLONE_SAFETY[@]}" \
        --max-delete-size "$(max_delete_bytes "$LOCAL_SIZE_DEVICES_CLOUD")B" || RCLONE_SUCCESS=0
fi

CLOUD_SYNC_DURATION=$(( $(date +%s) - CLOUD_SYNC_START ))

abort_if_interrupted

# ==========================================
# 13. RETENTION
# ==========================================
log "Running retention policy..."
PRUNE_START=$(date +%s)

restic forget --prune --keep-daily 7 --keep-weekly 4 --keep-monthly 6 || {
    err "Prune failed."
    GLOBAL_SUCCESS=0
    PRUNE_SUCCESS=0
}

PRUNE_DURATION=$(( $(date +%s) - PRUNE_START ))
