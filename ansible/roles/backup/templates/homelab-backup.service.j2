[Unit]
Description=Restic & Rclone Homelab Backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

ExecStartPre=-{{ user_bin_path }}/git-sync.sh
ExecStart={{ user_bin_path }}/homelab-backup.sh

StandardOutput=journal
StandardError=journal

TimeoutStartSec=1h
TimeoutStopSec=5m
