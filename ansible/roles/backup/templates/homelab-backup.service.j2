[Unit]
Description=Restic & Rclone Homelab Backup

RequiresMountsFor={{ backup_mount }}
ConditionPathIsMountPoint={{ backup_mount }}

Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service

[Service]
Type=oneshot

ExecStartPre=-{{ user_bin_path }}/git-sync.sh
ExecStart={{ user_bin_path }}/homelab-backup.sh

StandardOutput=journal
StandardError=journal

TimeoutStartSec=1h
TimeoutStopSec=5m
