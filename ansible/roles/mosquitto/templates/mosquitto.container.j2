[Unit]
Description=Mosquitto MQTT
Documentation=https://mosquitto.org/documentation/

Wants=network-online.target
After=network-online.target

RequiresMountsFor={{ stacks_path }}/mosquitto/config
RequiresMountsFor={{ stacks_path }}/mosquitto/data

[Container]
# --- Image / Exec ---
Image={{ mosquitto_image }}:{{ mosquitto_version }}
ContainerName=mosquitto
StopTimeout=20

# --- Identity / Namespaces ---
User=1883:1883
UserNS=keep-id:uid=1883,gid=1883

# --- Security / Capabilities ---
DropCapability=all
NoNewPrivileges=true

# --- Resource Limits ---
Memory={{ mosquitto_memory_limit }}

# --- Storage ---
Volume={{ stacks_path }}/mosquitto/config:/mosquitto/config:Z
Volume={{ stacks_path }}/mosquitto/data:/mosquitto/data:Z

# --- Networking ---
Network=home.network

# --- Configuration / Env ---
Timezone={{ timezone }}

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
