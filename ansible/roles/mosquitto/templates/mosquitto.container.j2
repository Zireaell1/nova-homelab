[Unit]
Description=Mosquitto MQTT
Documentation=https://mosquitto.org/documentation/

RequiresMountsFor={{ stacks_path }}/mosquitto/config
RequiresMountsFor={{ stacks_path }}/mosquitto/data
RequiresMountsFor={{ stacks_path }}/mosquitto/log

[Container]
Image={{ mosquitto_image }}
ContainerName=mosquitto
Timezone={{ timezone }}
Memory={{ mosquitto_memory_limit }}

Volume={{ stacks_path }}/mosquitto/config:/mosquitto/config:Z
Volume={{ stacks_path }}/mosquitto/data:/mosquitto/data:Z
Volume={{ stacks_path }}/mosquitto/log:/mosquitto/log:Z

UserNS=keep-id

Network=home.network

[Service]
Restart=always

[Install]
WantedBy=default.target
