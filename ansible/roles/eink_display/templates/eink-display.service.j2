[Unit]
Description=Nova eink display
Wants=network-online.target
After=network-online.target

[Service]
SyslogIdentifier=eink-display

WorkingDirectory={{ user_home }}/eink-display

Environment="PATH={{ user_home }}/eink-display/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile={{ user_home }}/eink-display/eink-display.env

ExecStart={{ user_home }}/eink-display/.venv/bin/python src/nova_eink_display/main.py

Restart=always
RestartSec=10

[Install]
WantedBy=default.target
