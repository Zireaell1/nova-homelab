[Unit]
Description=Vaultwarden
Documentation=https://github.com/dani-garcia/vaultwarden/wiki

Wants=network-online.target
After=network-online.target

RequiresMountsFor={{ stacks_path }}/vaultwarden/data

[Container]
Image={{ vaultwarden_image }}:{{ version_vaultwarden }}
ContainerName=vaultwarden
Timezone={{ timezone }}
Memory={{ vaultwarden_memory_limit }}

DropCapability=all
NoNewPrivileges=true

HealthCmd=/healthcheck.sh
HealthInterval=120s
HealthRetries=10
HealthTimeout=45s

EnvironmentFile={{ stacks_path }}/vaultwarden/vaultwarden.env

StopTimeout=20

Exec=/start.sh

UserNS=keep-id:uid=0,gid=0

Volume={{ stacks_path }}/vaultwarden/data:/data:Z

Network=vaultwarden.network

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
