[Unit]
Description=Authelia
Documentation=https://www.authelia.com/

Wants=network-online.target
After=network-online.target

Wants=authelia-postgres.service authelia-redis.service
After=authelia-postgres.service authelia-redis.service

RequiresMountsFor={{ stacks_path }}/authelia/config

[Container]
# --- Image / Exec ---
Image={{ authelia_image }}:{{ authelia_version }}
ContainerName=authelia
StopTimeout=20

# --- Identity / Namespaces ---
User=1000:1000
UserNS=keep-id:uid=1000,gid=1000

# --- Security / Capabilities ---
DropCapability=all
NoNewPrivileges=true

# --- Resource Limits ---
Memory={{ authelia_memory_limit }}

# --- Storage ---
Volume={{ stacks_path }}/authelia/config:/config:Z
Volume={{ stacks_path }}/authelia/secrets:/secrets:ro,z

# --- Networking ---
Network=authelia.network
Network=authelia-backend.network

# --- Configuration / Env ---
Timezone={{ timezone }}

EnvironmentFile={{ stacks_path }}/authelia/authelia.env

HealthCmd=["/app/healthcheck.sh"]
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
