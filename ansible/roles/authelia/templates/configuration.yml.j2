theme: 'auto'

server:
  address: 'tcp://:9091'
  buffers:
    read: 16384
    write: 16384

authentication_backend:
  file:
    path: '/config/users_database.yml'

totp:
  issuer: '{{ vault_domain }}'

definitions:
  network:
    internal:
      - '{{ network_home }}'
    tailscale:
      - '{{ network_tailscale }}'

access_control:
  default_policy: 'deny'
  rules:
    # Camera-Front Two-factor Auth (Admin Only)
    - domain: 'camera-front.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Camera-Back Two-factor Auth (Admin Only)
    - domain: 'camera-back.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Camera-Doorbell Two-factor Auth (Admin Only)
    - domain: 'camera-doorbell.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Camera-Entry Two-factor Auth (Admin Only)
    - domain: 'camera-entry.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Switch Two-factor Auth (Admin Only)
    - domain: 'switch.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Z2M Bypass Webmanifest
    - domain: 'z2m.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/.*\.webmanifest$'
        - '^/assets/.*\.png$'
        - '^/images/.*\.png$'

    # Z2M Two-factor Auth (Admin Only)
    - domain: 'z2m.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Frigate Bypass Assets
    - domain: 'frigate.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/images/.*(maskable-icon).*\.png$'

    # Frigate Two-factor Auth (Based On Roles)
    - domain: 'frigate.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'

    # Dozzle Bypass Webmanifest
    - domain: 'dozzle.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/manifest\.webmanifest$'

    # Dozzle Two-factor Auth (Admin Only)
    - domain: 'dozzle.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Uptime Kuma Bypass Webmanifest
    - domain: 'kuma.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/manifest\.json$'
        - '^/icon-.*\.png$'

    # Uptime Kuma Two-factor Auth (Admin Only)
    - domain: 'kuma.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Pi-Hole Bypass Webmanifest
    - domain: 'pihole.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/admin/img/favicons/manifest\.json$'
        - '^/admin/img/favicons/.*\.png$'

    # Pi-Hole Two-factor Auth (Admin Only)
    - domain: 'pihole.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Mkdocs Two-factor Auth (All Users)
    - domain: 'docs.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'

regulation:
  modes:
    - 'user'
    - 'ip'
  max_retries: 3
  find_time: '2 minutes'
  ban_time: '15 minutes'

session:
  cookies:
    - name: 'authelia_session'
      domain: '{{ vault_domain }}'
      authelia_url: 'https://auth.{{ vault_domain }}'
  redis:
    host: 'authelia-redis'
    port: 6379

storage:
  postgres:
    address: 'tcp://authelia-postgres:5432'
    database: 'authelia'
    username: 'authelia'

notifier:
  disable_startup_check: false
  filesystem:
    filename: '/config/notification.txt'

identity_providers:
  oidc:
    authorization_policies:
      admin:
        default_policy: 'deny'
        rules:
          - policy: 'two_factor'
            subject: 'group:admin'
    jwks:
      - algorithm: 'RS256'
        use: 'sig'
        key: {% raw %}{{ secret "/secrets/rsa.2048.key" | mindent 10 "|" | msquote }}{% endraw %}

    clients:
      - client_id: '{{ vault_authelia_paperless_client_id }}'
        client_name: 'Paperless'
        client_secret: '{{ vault_authelia_paperless_client_secret }}'
        public: false
        authorization_policy: 'two_factor'
        require_pkce: true
        pkce_challenge_method: 'S256'
        redirect_uris:
          - 'https://paperless.{{ vault_domain }}/accounts/oidc/authelia/login/callback/'
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
          - 'groups'
        response_types:
          - 'code'
        grant_types:
          - 'authorization_code'
        access_token_signed_response_alg: 'none'
        userinfo_signed_response_alg: 'none'
        token_endpoint_auth_method: 'client_secret_basic'
