theme: 'auto'

server:
  address: 'tcp://:9091'
  buffers:
    read: 16384
    write: 16384

telemetry:
  metrics:
    enabled: true
    address: 'tcp://:9959/metrics'

authentication_backend:
  file:
    path: '/config/users_database.yml'

totp:
  issuer: '{{ vault_domain }}'

definitions:
  network:
    internal:
      - '{{ vault_network_home }}'
    tailscale:
      - '{{ vault_network_tailscale }}'
    dashboard:
      - '{{ vault_dashboard_tablet_ip }}/32'

access_control:
  default_policy: 'deny'
  rules:
    # ===============================================================================
    # Manifests / Assets Bypass
    # ===============================================================================
    - domain: '{{ services['prometheus']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/favicon\.svg$'

    - domain: '{{ services['zigbee2mqtt']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/.*\.webmanifest$'
        - '^/assets/.*\.png$'
        - '^/images/.*\.png$'

    - domain: '{{ services['pihole']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/admin/img/favicons/manifest\.json$'
        - '^/admin/img/favicons/.*\.png$'

    - domain: '{{ services['frigate']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/images/.*(maskable-icon).*\.png$'

    # ===============================================================================
    # Service Accounts / API
    # ===============================================================================
    # Restic Rest Server One-Factor Auth for backup scripts
    - domain: '{{ services['restic']['subdomain'] }}.{{ vault_domain }}'
      policy: 'one_factor'
      networks:
        - 'internal'
      subject:
        - ['group:backup']

    # Prometheus One-factor Auth for eink display
    - domain: '{{ services['prometheus']['subdomain'] }}.{{ vault_domain }}'
      policy: 'one_factor'
      networks:
        - 'internal'
      resources:
        - '^/api/v1/query.*'
      methods:
        - 'GET'
      subject:
        - ['group:screen-controller-group']

    # Loki One-factor Auth for logs endpoint
    - domain: '{{ services['loki']['subdomain'] }}.{{ vault_domain }}'
      policy: 'one_factor'
      networks:
        - 'internal'
      resources:
        - '^/loki/api/v1/push$'
      subject:
        - ['group:logs']

    # ===============================================================================
    # Exceptions
    # ===============================================================================
    # Vaultwarden Two-factor Auth (Admin Panel)
    - domain: '{{ services['vaultwarden']['subdomain'] }}.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
      resources:
        - '^/admin.*'
      subject:
        - ['group:admin']

    # Vaultwarden needs to be bypassed because of mobile app
    - domain: '{{ services['vaultwarden']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'

    # HomeAssistant needs to be bypassed because of mobile app
    - domain: '{{ services['homeassistant']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
        - 'dashboard'

    # ===============================================================================
    # User Services
    # ===============================================================================
    - domain:
        - '{{ services['frigate']['subdomain'] }}.{{ vault_domain }}'
        - '{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:user']
        - ['group:admin']

    # ===============================================================================
    # Admin Services
    # ===============================================================================
    - domain:
        - '{{ services['alloy']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['grafana']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['prometheus']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['go2rtc']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['zigbee2mqtt']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['pihole']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['peanut']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['files']['subdomain'] }}.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Loki ready endpoint
    - domain:
        - '{{ services['loki']['subdomain'] }}.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/ready$'
      subject:
        - ['group:admin']

    # ===============================================================================
    # Internal Only Admin Services
    # ===============================================================================
    - domain:
        - '{{ services['switch']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['camera_front']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['camera_back']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['camera_doorbell']['subdomain'] }}.{{ vault_domain }}'
        - '{{ services['camera_entry']['subdomain'] }}.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
      subject:
        - ['group:admin']

regulation:
  modes:
    - 'user'
    - 'ip'
  max_retries: 3
  find_time: '2 minutes'
  ban_time: '15 minutes'

session:
  cookies:
    - name: 'authelia_session'
      domain: '{{ vault_domain }}'
      authelia_url: 'https://{{ services['authelia']['subdomain'] }}.{{ vault_domain }}'
  redis:
    host: 'authelia-redis'
    port: 6379

storage:
  postgres:
    address: 'tcp://authelia-postgres:5432'
    database: 'authelia'
    username: 'authelia'

notifier:
  disable_startup_check: false
  filesystem:
    filename: '/config/notification.txt'
