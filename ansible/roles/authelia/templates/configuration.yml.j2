theme: 'auto'

server:
  address: 'tcp://:9091'
  buffers:
    read: 16384
    write: 16384

telemetry:
  metrics:
    enabled: true
    address: 'tcp://:9959/metrics'

authentication_backend:
  file:
    path: '/config/users_database.yml'

totp:
  issuer: '{{ vault_domain }}'

definitions:
  network:
    internal:
      - '{{ vault_network_home }}'
    tailscale:
      - '{{ vault_network_tailscale }}'
    dashboard:
      - '{{ vault_dashboard_tablet_ip }}/32'

access_control:
  default_policy: 'deny'
  rules:
    # ===============================================================================
    # Manifests / Assets Bypass
    # ===============================================================================
    - domain: '{{ service_endpoints['prometheus']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/favicon\.svg$'

    - domain: '{{ service_endpoints['go2rtc']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/favicon\.ico$'

    - domain: '{{ service_endpoints['zigbee2mqtt']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/.*\.webmanifest$'
        - '^/assets/.*\.png$'
        - '^/images/.*\.png$'

    - domain: '{{ service_endpoints['pihole']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/admin/img/favicons/manifest\.json$'
        - '^/admin/img/favicons/.*\.png$'

    - domain: '{{ service_endpoints['frigate']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/images/.*(maskable-icon).*\.png$'

    # ===============================================================================
    # Service Accounts / API
    # ===============================================================================
    # Restic Rest Server One-Factor Auth for backup scripts
    - domain: '{{ service_endpoints['restic']['subdomain'] }}.{{ vault_domain }}'
      policy: 'one_factor'
      networks:
        - 'internal'
      subject:
        - ['group:backup']

    # Prometheus One-factor Auth for eink display
    - domain: '{{ service_endpoints['prometheus']['subdomain'] }}.{{ vault_domain }}'
      policy: 'one_factor'
      networks:
        - 'internal'
      resources:
        - '^/api/v1/query.*'
      methods:
        - 'GET'
      subject:
        - ['group:screen-controller-group']

    # Loki One-factor Auth for logs endpoint
    - domain: '{{ service_endpoints['loki']['subdomain'] }}.{{ vault_domain }}'
      policy: 'one_factor'
      networks:
        - 'internal'
      resources:
        - '^/loki/api/v1/push$'
      subject:
        - ['group:logs']

    # Prometheus One-factor Auth for metrics endpoint
    - domain: '{{ service_endpoints['prometheus']['subdomain'] }}.{{ vault_domain }}'
      policy: 'one_factor'
      networks:
        - 'internal'
      resources:
        - '^/api/v1/write$'
      subject:
        - ['group:metrics']

    # ===============================================================================
    # Exceptions
    # ===============================================================================
    # Vaultwarden Two-factor Auth (Admin Panel)
    - domain: '{{ service_endpoints['vaultwarden']['subdomain'] }}.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
      resources:
        - '^/admin.*'
      subject:
        - ['group:admin']

    # Vaultwarden needs to be bypassed because of mobile app
    - domain: '{{ service_endpoints['vaultwarden']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'

    # HomeAssistant needs to be bypassed because of mobile app
    - domain: '{{ service_endpoints['homeassistant']['subdomain'] }}.{{ vault_domain }}'
      policy: 'bypass'
      networks:
        - 'internal'
        - 'tailscale'
        - 'dashboard'

    # ===============================================================================
    # User Services
    # ===============================================================================
    - domain:
        - '{{ service_endpoints['frigate']['subdomain'] }}.{{ vault_domain }}'
        - '{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:user']
        - ['group:admin']

    - domain: '{{ service_endpoints['files']['subdomain'] }}.{{ vault_domain }}'
      policy: 'one_factor'
      networks:
        - 'dashboard'
      subject:
        - ['group:dashboard-group']

    - domain: '{{ service_endpoints['files']['subdomain'] }}.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:user']
        - ['group:admin']

    # ===============================================================================
    # Admin Services
    # ===============================================================================
    - domain:
        - '{{ service_endpoints['alloy']['subdomain'] }}.{{ vault_domain }}'
        - '{{ service_endpoints['grafana']['subdomain'] }}.{{ vault_domain }}'
        - '{{ service_endpoints['prometheus']['subdomain'] }}.{{ vault_domain }}'
        - '{{ service_endpoints['go2rtc']['subdomain'] }}.{{ vault_domain }}'
        - '{{ service_endpoints['zigbee2mqtt']['subdomain'] }}.{{ vault_domain }}'
        - '{{ service_endpoints['pihole']['subdomain'] }}.{{ vault_domain }}'
        - '{{ service_endpoints['peanut']['subdomain'] }}.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      subject:
        - ['group:admin']

    # Loki ready endpoint
    - domain:
        - '{{ service_endpoints['loki']['subdomain'] }}.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
        - 'tailscale'
      resources:
        - '^/ready$'
      subject:
        - ['group:admin']

    # ===============================================================================
    # Internal Only Admin Services
    # ===============================================================================
    - domain:
        - '{{ service_endpoints['switch']['subdomain'] }}.{{ vault_domain }}'
        - '{{ service_endpoints['camera_front']['subdomain'] }}.{{ vault_domain }}'
        - '{{ service_endpoints['camera_back']['subdomain'] }}.{{ vault_domain }}'
        - '{{ service_endpoints['camera_doorbell']['subdomain'] }}.{{ vault_domain }}'
        - '{{ service_endpoints['camera_entry']['subdomain'] }}.{{ vault_domain }}'
      policy: 'two_factor'
      networks:
        - 'internal'
      subject:
        - ['group:admin']

regulation:
  modes:
    - 'user'
    - 'ip'
  max_retries: 3
  find_time: '2 minutes'
  ban_time: '15 minutes'

session:
  cookies:
    - name: 'authelia_session'
      domain: '{{ vault_domain }}'
      authelia_url: 'https://{{ service_endpoints['authelia']['subdomain'] }}.{{ vault_domain }}'
  redis:
    host: 'authelia-redis'
    port: 6379

storage:
  postgres:
    address: 'tcp://authelia-postgres:5432'
    database: 'authelia'
    username: 'authelia'

notifier:
  disable_startup_check: false
  filesystem:
    filename: '/config/notification.txt'

# TODO: future paperless-ngx OIDC config
identity_providers:
  oidc:
    authorization_policies:
      admin:
        default_policy: 'deny'
        rules:
          - policy: 'two_factor'
            subject: 'group:admin'
    jwks:
      - algorithm: 'RS256'
        use: 'sig'
        key: {% raw %}{{ secret "/secrets/rsa.2048.key" | mindent 10 "|" | msquote }}{% endraw %}

    clients:
      - client_id: '{{ vault_authelia_paperless_client_id }}'
        client_name: 'Paperless'
        client_secret: '{{ vault_authelia_paperless_client_secret }}'
        public: false
        authorization_policy: 'two_factor'
        require_pkce: true
        pkce_challenge_method: 'S256'
        redirect_uris:
          - 'https://paperless.{{ vault_domain }}/accounts/oidc/authelia/login/callback/'
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
          - 'groups'
        response_types:
          - 'code'
        grant_types:
          - 'authorization_code'
        access_token_signed_response_alg: 'none'
        userinfo_signed_response_alg: 'none'
        token_endpoint_auth_method: 'client_secret_basic'
