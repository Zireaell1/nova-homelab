[Unit]
Description=Immich Machine Learning (OpenVINO)
Documentation=https://docs.immich.app/

RequiresMountsFor={{ stacks_path }}/immich/model-cache

[Container]
# --- Image / Exec ---
Image={{ immich_machine_learning_image }}:{{ immich_machine_learning_version }}-openvino
ContainerName=immich-machine-learning
StopTimeout=20

# --- Identity / Namespaces ---
GroupAdd=keep-groups
UserNS=keep-id:uid=0,gid=0

# --- Security / Capabilities ---
DropCapability=all
NoNewPrivileges=true

# --- Resource Limits ---
Memory={{ immich_machine_learning_memory_limit }}

# --- Devices ---
AddDevice=/dev/dri/renderD128:/dev/dri/renderD128

# --- Storage ---
Volume={{ stacks_path }}/immich/model-cache:/cache:Z

# --- Networking ---
Network=immich-backend.network
Network=immich.network

# --- Configuration / Env ---
Timezone={{ timezone }}

Environment=TZ={{ timezone }}

Environment=MACHINE_LEARNING_MODEL_REVISION={{ immich_machine_learning_model_revision }}

HealthCmd=["python3", "healthcheck.py"]
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=120s

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=30

CPUWeight=25

[Install]
WantedBy=default.target
