[Unit]
Description=Immich PostgreSQL

RequiresMountsFor={{ stacks_path }}/immich/postgres

[Container]
# --- Image / Exec ---
Image={{ immich_postgres_image }}:{{ immich_postgres_version }}
ContainerName=immich-postgres
StopTimeout=20

# --- Resource Limits ---
Memory={{ immich_postgres_memory_limit }}
ShmSize=128m

# --- Storage ---
Volume={{ stacks_path }}/immich/postgres:/var/lib/postgresql/data:Z
Volume={{ stacks_path }}/immich/secrets/STORAGE_PASSWORD:/STORAGE_PASSWORD:ro,z

# --- Networking ---
Network=immich-backend.network

# --- Configuration / Env ---
Timezone={{ timezone }}

Environment=POSTGRES_USER=postgres
Environment=POSTGRES_PASSWORD_FILE=/STORAGE_PASSWORD
Environment=POSTGRES_DB=immich
Environment=POSTGRES_INITDB_ARGS=--data-checksums

HealthCmd=["pg_isready", "-q", "-U", "postgres"]
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
