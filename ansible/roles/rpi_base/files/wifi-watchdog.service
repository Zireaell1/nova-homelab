# Managed by Ansible (rpi_base).
[Unit]
Description=Recover wifi when the default gateway stops answering
After=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/wifi-watchdog
SyslogIdentifier=wifi-watchdog
Restart=always
RestartSec=30
RestartSteps=5
RestartMaxDelaySec=5min

[Install]
WantedBy=multi-user.target
