apiVersion: 1

groups:
    - orgId: 1
      name: 1m-eval
      folder: Ansible Provisioned Alerts
      interval: 1m
      rules:
        - uid: podman_container_crashed
          title: Podman Container Crashed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: podman_container_exit_code > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Container {{ '{{' }} $labels.name {{ '}}' }} exited with code {{ '{{' }} $values.A {{ '}}' }}."
          notification_settings:
            receiver: Discord

        - uid: podman_container_unhealthy
          title: Podman Container Unhealthy
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: podman_container_health == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Container {{ '{{' }} $labels.name {{ '}}' }} has been failing its healthcheck for 5 minutes."
          notification_settings:
            receiver: Discord

        - uid: ups_on_battery
          title: UPS On Battery
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: ups_input_voltage < ups_output_voltage_nominal * 0.8
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 1m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Mains lost -- input {{ '{{' }} $values.A {{ '}}' }}V against a {{ '{{' }} $labels.instance {{ '}}' }} nominal. Running on battery."
            description: "Self-calibrating against ups_output_voltage_nominal, so it needs no hardcoded mains voltage."
          notification_settings:
            receiver: Discord

        - uid: ups_battery_low
          title: UPS Battery Low
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: ups_battery_charge < ups_battery_charge_low
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Battery at {{ '{{' }} $values.A {{ '}}' }}% -- past the UPS's own low-battery threshold. Shutdown is imminent."
          notification_settings:
            receiver: Discord

        - uid: ups_runtime_low
          title: UPS Runtime Low
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: ups_battery_runtime < 300
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Only {{ '{{' }} $values.A {{ '}}' }}s of runtime left on battery."
          notification_settings:
            receiver: Discord

        - uid: scrape_target_down
          title: Scrape Target Down
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: up == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Prometheus cannot scrape {{ '{{' }} $labels.job {{ '}}' }} at {{ '{{' }} $labels.instance {{ '}}' }}."
            description: "Covers every exporter at once, including the monitoring stack itself."
          notification_settings:
            receiver: Discord

        - uid: caddy_upstream_unhealthy
          title: Caddy Upstream Unhealthy
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: caddy_reverse_proxy_upstreams_healthy == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Caddy marked upstream {{ '{{' }} $labels.upstream {{ '}}' }} unhealthy."
          notification_settings:
            receiver: Discord

        - uid: caddy_config_reload_failed
          title: Caddy Config Reload Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: caddy_config_last_reload_successful == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Caddy is serving the previous config -- the last load attempt failed."
          notification_settings:
            receiver: Discord

        - uid: frigate_camera_down
          title: Frigate Camera Down
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: frigate_camera_fps == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Camera {{ '{{' }} $labels.camera_name {{ '}}' }} is producing no frames."
            description: "Frigate keeps running with a dead camera, so nothing else reports this."
          notification_settings:
            receiver: Discord


    - orgId: 1
      name: 5m-eval
      folder: Ansible Provisioned Alerts
      interval: 5m
      rules:
        - uid: systemd_unit_failed
          title: Systemd Unit Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_systemd_unit_state{state="failed"} == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Host unit {{ '{{' }} $labels.name {{ '}}' }} is in the failed state."
            description: "The only coverage for native daemons -- nut, tailscaled, fail2ban, alloy, smartd -- which podman metrics cannot see."
          notification_settings:
            receiver: Discord

        - uid: smart_health_failed
          title: SMART Health Assessment Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: smartmon_device_smart_healthy == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }} reports its overall SMART self-assessment as failed."
            description: "A lagging indicator by design: the drive only says this once a threshold is crossed. smart_sectors_degrading is the leading one."
          notification_settings:
            receiver: Discord

        - uid: smart_sectors_degrading
          title: SMART Sectors Degrading
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: '{__name__=~"smartmon_(reallocated_sector_ct|current_pending_sector|offline_uncorrectable)_raw_value"} > 0'
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }}: {{ '{{' }} $labels.__name__ {{ '}}' }} is {{ '{{' }} $values.A {{ '}}' }}."
            description: "Any non-zero value here is the earliest warning of a failing disk, well before the health assessment flips."
          notification_settings:
            receiver: Discord

        - uid: authelia_auth_failures
          title: Authelia Authentication Failures
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: sum(rate(authelia_authn_duration_count{success="false"}[5m])) > 0.2
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Failed authentications running at {{ '{{' }} $values.A {{ '}}' }}/s over 5 minutes."
            description: "With Home Assistant, Vaultwarden and mainsail all on bypass, Authelia's own metrics are where a credential attack shows first."
          notification_settings:
            receiver: Discord

        - uid: tailscale_unhealthy
          title: Tailscale Reporting Unhealthy
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: tailscaled_health_messages > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 15m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "tailscaled is reporting {{ '{{' }} $values.A {{ '}}' }} health message(s)."
            description: "Run `tailscale status` for the text; this only exposes the count."
          notification_settings:
            receiver: Discord

        - uid: prometheus_rule_eval_failing
          title: Prometheus Rule Evaluation Failing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: increase(prometheus_rule_evaluation_failures_total[15m]) > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $labels.rule_group {{ '}}' }} failed to evaluate."
            description: "Meta-alert: a rule that cannot evaluate silently stops alerting. This is the one that tells you the alerting itself broke."
          notification_settings:
            receiver: Discord

    - orgId: 1
      name: 15m-eval
      folder: Ansible Provisioned Alerts
      interval: 15m
      rules:
        - uid: backup_has_not_run
          title: Backup Has Not Run
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_backup_last_run_timestamp_seconds > 108000
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: Alerting
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "No backup has completed in over 30 hours (or the metrics stopped being written)."
            description: "Check `systemctl --user status homelab-backup.timer` and whether {{ backup_mount }} is mounted -- ConditionPathIsMountPoint makes an unmounted disk a successful skip, which produces no metrics at all."
          notification_settings:
            receiver: Discord

        - uid: backup_services_not_restarted
          title: Backup Left Services Stopped
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_services_down > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $values.A {{ '}}' }} service(s) stopped for the snapshot did not come back up."
            description: "The backup run caused an outage. Check `systemctl --user list-units --state=failed` and the journal for homelab-backup.service."
          notification_settings:
            receiver: Discord

        - uid: backup_local_failed
          title: Local Backup Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "The nightly restic backup to {{ local_backup_path }} failed."
          notification_settings:
            receiver: Discord

        - uid: backup_cloud_sync_failed
          title: Cloud Sync Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_cloud_sync_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "The rclone sync to B2 failed -- the offsite copy is not current."
          notification_settings:
            receiver: Discord

        - uid: backup_verify_failed
          title: Cloud Backup Verification Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_verify_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Could not restore the canary from B2, or it was older than the {{ backup_canary_max_age }}s limit."
            description: "This is the only end-to-end proof the offsite copy is restorable. Device repos are not covered -- rest-server holds those encrypted under each client's own password."
          notification_settings:
            receiver: Discord

        - uid: backup_canary_ageing
          title: Cloud Canary Ageing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_verify_canary_age_seconds > 86400
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The canary in B2 is over 24h old -- the offsite copy is falling behind."
          notification_settings:
            receiver: Discord

        - uid: backup_quota_exceeded
          title: Cloud Quota Exceeded
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_quota_exceeded == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Projected cloud size exceeded backup_b2_quota_bytes -- the sync was skipped."
          notification_settings:
            receiver: Discord

        - uid: backup_cloud_quota_pressure
          title: Cloud Quota Pressure
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_b2_size_bytes / homelab_backup_b2_quota_bytes > 0.85 and homelab_backup_b2_quota_bytes > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "B2 bucket is over 85% of the configured quota."
          notification_settings:
            receiver: Discord

        - uid: backup_prune_failed
          title: Backup Prune Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_prune_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "restic forget --prune failed -- retention is drifting and the repo will keep growing."
          notification_settings:
            receiver: Discord

        - uid: backup_devices_unknown_tier
          title: Device Repo In Unknown Tier
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_devices_unknown_tiers > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $values.A {{ '}}' }} device repo dir(s) are in neither the cloud nor local tier, so they sync nowhere."
          notification_settings:
            receiver: Discord

        - uid: backup_duration_near_timeout
          title: Backup Approaching Its Timeout
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_duration_seconds > 2700
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Last backup took {{ '{{' }} $values.A {{ '}}' }}s, against the 1h TimeoutStartSec on homelab-backup.service."
          notification_settings:
            receiver: Discord

        - uid: filesystem_will_fill
          title: Filesystem Will Fill
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: predict_linear(node_filesystem_avail_bytes{fstype!~"tmpfs|ramfs|overlay"}[6h], 21600) < 0 and node_filesystem_avail_bytes / node_filesystem_size_bytes < 0.2
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 30m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} is trending to full within 6 hours."
            description: "The <20% guard stops a 6h dip on a mostly-empty filesystem from firing."
          notification_settings:
            receiver: Discord

        - uid: filesystem_critical
          title: Filesystem Almost Full
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_filesystem_avail_bytes{fstype!~"tmpfs|ramfs|overlay"} / node_filesystem_size_bytes < 0.05
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} is under 5% free."
          notification_settings:
            receiver: Discord

        - uid: device_backup_stale
          title: Device Backup Stale
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_device_backup_last_snapshot_timestamp_seconds > 259200
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.user {{ '}}' }}/{{ '{{' }} $labels.tier {{ '}}' }}/{{ '{{' }} $labels.device {{ '}}' }} has not backed up in over 3 days."
            description: "72h rather than 30h: these are client machines that get switched off for a weekend. Freshness is all that is observable server-side -- rest-server holds each repo encrypted under the client's own password."
          notification_settings:
            receiver: Discord

        - uid: device_backup_collector_failed
          title: Device Backup Collector Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_device_backup_collector_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The device freshness collector could not read the restic repository root."
            description: "Usually means /mnt/backup is not mounted. noDataState stays OK because backup_has_not_run already owns the case where the textfile stops being written at all."
          notification_settings:
            receiver: Discord
