apiVersion: 1

groups:
    - orgId: 1
      name: 1m-eval
      folder: Ansible Provisioned Alerts
      interval: 1m
      rules:
        - uid: modem_unreachable
          title: Modem Unreachable
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: probe_success{probe="modem"} == 0 and on() probe_success{probe="gateway"} == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 1m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The modem stopped answering ping while the gateway is fine."
            impact: "The whole house is offline — the modem is rebooting, hung or without power. This message arrives once the internet is back."
            action: "Modem uptime / session time in its web UI · was it the scheduled reboot? compare the modem's clock with real time · UPS: `network_ups_tools_ups_status{flag=\"OB\"}`"
          notification_settings:
            receiver: Discord

        - uid: wan_down
          title: Internet Down, Modem Up
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: max(probe_success{hop="internet"}) == 0 and on() max(probe_success{probe="modem"}) == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 2m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Every internet probe fails while the modem itself answers."
            impact: "Offline on the mobile side — carrier outage, lost data session or no signal. Nothing on Nova or the LAN is at fault. This message arrives once the internet is back."
            action: "Modem web UI: signal (RSRP/SINR), network type, session counter · WAN dashboard for when it started"
          notification_settings:
            receiver: Discord

        - uid: host_oom_kill
          title: Kernel OOM Kill
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: increase(node_vmstat_oom_kill[10m]) > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }}: the kernel OOM-killed a process in the last 10 minutes."
            impact: "A container or service was killed for memory — it is restarting or gone, and it may happen again."
            action: "`journalctl -k -b | grep -i 'killed process'` · raise that service's `Memory=` or find the leak"
          notification_settings:
            receiver: Discord

        - uid: textfile_collector_error
          title: Textfile Collector Broken
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_textfile_scrape_error == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }}: a .prom file in the textfile directory is unreadable."
            impact: "The whole textfile collector is dropped while one file is bad — backup, update, SMART, cert and git-mirror metrics all go stale at once."
            action: "`ls -l /opt/alloy-metrics` · `journalctl -u alloy -e | grep textfile` · fix or delete the malformed file"
          notification_settings:
            receiver: Discord

        - uid: selinux_not_enforcing
          title: SELinux Not Enforcing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_selinux_current_mode != 1 and on(instance) node_selinux_enabled == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }}: SELinux is no longer in enforcing mode."
            impact: "Every container and host confinement the setup relies on is off."
            action: "`getenforce` · `sudo setenforce 1` · find who changed it: `journalctl -b | grep -iE 'setenforce|MAC_STATUS'`"
          notification_settings:
            receiver: Discord

        - uid: podman_container_crashed
          title: Podman Container Crashed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: (podman_container_exit_code > 0) * on(id) group_left(name) podman_container_info
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Container {{ '{{' }} $labels.name {{ '}}' }} exited with code {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }}."
            impact: "The service is down; systemd restarts it after 10s, so a repeat of this alert means a crash loop."
            action: "`podman logs --tail 50 <container>` · `systemctl --user status <container>`"
          notification_settings:
            receiver: Discord

        - uid: podman_container_unhealthy
          title: Podman Container Unhealthy
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: (podman_container_health == 1) * on(id) group_left(name) podman_container_info
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Container {{ '{{' }} $labels.name {{ '}}' }} has failed its healthcheck for 5 minutes."
            impact: "The process is running but not answering, so the service is effectively down."
            action: "`podman healthcheck run <container>` · `podman logs --tail 50 <container>`"
          notification_settings:
            receiver: Discord

        - uid: ups_on_battery
          title: UPS On Battery
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: network_ups_tools_ups_status{flag="OB"} == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 1m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Power cut: the UPS is on battery."
            impact: "Nova is running on battery; it shuts down automatically when the UPS reports low battery."
            action: "Check the mains and the breaker · remaining runtime is on the UPS dashboard"
          notification_settings:
            receiver: Discord

        - uid: ups_battery_low
          title: UPS Battery Low
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: network_ups_tools_battery_charge < network_ups_tools_battery_charge_low
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "UPS battery at {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }}%, below its low threshold. Shutdown is imminent."
            impact: "NUT is about to shut Nova down; anything not yet stopped stops uncleanly."
            action: "Nothing to fix remotely. After power returns: `systemctl --user list-units --state=failed`"
          notification_settings:
            receiver: Discord

        - uid: ups_runtime_low
          title: UPS Runtime Low
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: network_ups_tools_battery_runtime < 300
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "UPS has {{ '{{' }} humanizeDuration $values.A.Value {{ '}}' }} of battery left."
            impact: "Shutdown follows when the battery reaches the UPS's low threshold."
            action: "If mains is not coming back, shut down cleanly now: `sudo systemctl poweroff`"
          notification_settings:
            receiver: Discord

        - uid: ups_battery_replace
          title: UPS Battery Needs Replacing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: network_ups_tools_ups_status{flag="RB"} == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 1h
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The UPS reports its battery needs replacing."
            impact: "Runtime on battery is no longer what the dashboard claims; a power cut may end in an unclean shutdown."
            action: "Check `upsc eaton battery.date` and order a replacement battery for the Eaton 5E"
          notification_settings:
            receiver: Discord

        - uid: ups_overload
          title: UPS Overloaded
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: network_ups_tools_ups_load > 80
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "UPS load at {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }}% for 5 minutes."
            impact: "Battery runtime shrinks sharply near full load; a spike above 100% makes the UPS drop the output."
            action: "Find what draws more than usual: Power dashboard · `upsc eaton ups.load ups.realpower`"
          notification_settings:
            receiver: Discord

        - uid: ups_power_flapping
          title: Mains Power Flapping
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: changes(network_ups_tools_ups_status{flag="OL"}[1h]) > 4
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Mains dropped in and out {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} times in the last hour."
            impact: "Each switch to battery wears it; brownouts can also hit devices not behind the UPS."
            action: "Check the plug, the power strip and the breaker · UPS dashboard → Status flags"
          notification_settings:
            receiver: Discord

        - uid: ups_battery_not_recharging
          title: UPS Battery Not Recharging
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: network_ups_tools_battery_charge < 90 and on() network_ups_tools_ups_status{flag="OL"} == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 12h
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "UPS battery stuck at {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }}% after 12 hours on mains."
            impact: "An ageing battery; the 5E cannot self-test, so this is the earliest warning it gives."
            action: "Plan a battery replacement · runtime on battery will be shorter than the dashboard estimates"
          notification_settings:
            receiver: Discord

        - uid: ups_mains_voltage_abnormal
          title: Mains Voltage Out of Range
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: (network_ups_tools_input_voltage < 207 or network_ups_tools_input_voltage > 253) and on() network_ups_tools_ups_status{flag="OL"} == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Mains at {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} V, outside 230 V ±10% for 5 minutes."
            impact: "The UPS is correcting it (AVR) for now; sustained, it wears the UPS and may push it onto battery."
            action: "Compare with other outlets · if it persists, report it to the grid operator"
          notification_settings:
            receiver: Discord

        - uid: ups_data_missing
          title: UPS Data Missing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: absent(network_ups_tools_battery_charge)
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "No UPS readings for 5 minutes."
            impact: "Every other UPS alert is blind — a power cut would go unnoticed until Nova shuts down."
            action: "`systemctl status nut-server nut-driver@eaton` · `upsc eaton` · `systemctl --user status nut-exporter`"
          notification_settings:
            receiver: Discord

        - uid: ups_forced_shutdown
          title: UPS Forced Shutdown
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: network_ups_tools_ups_status{flag="FSD"} == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "NUT has ordered a shutdown: Nova is powering off now."
            impact: "Everything goes down; it comes back only when mains returns and the UPS restores output."
            action: "After power returns: `journalctl -b -1 -u nut-monitor` · `systemctl --user list-units --state=failed`"
          notification_settings:
            receiver: Discord

        - uid: scrape_target_down
          title: Scrape Target Down
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: up == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Prometheus cannot reach {{ '{{' }} $labels.job {{ '}}' }} ({{ '{{' }} $labels.instance {{ '}}' }}) for 10 minutes."
            impact: "No metrics from it, so every alert that depends on it is blind too."
            action: "Prometheus → Status → Targets shows the error · `podman ps -a` for the container behind it"
          notification_settings:
            receiver: Discord

        - uid: caddy_upstream_unhealthy
          title: Caddy Upstream Unhealthy
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: caddy_reverse_proxy_upstreams_healthy == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Caddy cannot reach {{ '{{' }} $labels.upstream {{ '}}' }} for 5 minutes."
            impact: "The site behind it returns 502 Bad Gateway."
            action: "`podman ps -a` for the container behind it · `podman logs --tail 50 caddy`"
          notification_settings:
            receiver: Discord

        - uid: caddy_config_reload_failed
          title: Caddy Config Reload Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: caddy_config_last_reload_successful == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Caddy rejected its new config and is still serving the previous one."
            impact: "Sites keep working, but the last Caddyfile change is not live."
            action: "`podman exec caddy caddy validate --config /etc/caddy/Caddyfile` · `podman logs caddy 2>&1 | grep -i error`"
          notification_settings:
            receiver: Discord

        - uid: frigate_camera_down
          title: Frigate Camera Down
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: frigate_camera_fps == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Camera {{ '{{' }} $labels.camera_name {{ '}}' }} has sent no frames for 5 minutes."
            impact: "No recording and no detection for that camera."
            action: "Check the camera's power and network (`ping` it) · Frigate → System · `podman logs --tail 50 frigate`"
          notification_settings:
            receiver: Discord

        - uid: eink_hardware_fallback
          title: E-Ink Display Hardware Unavailable
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: eink_display_fallback == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "The e-ink panel failed to start; the app is drawing to a PNG instead of the screen."
            impact: "The screen is frozen on its last image while everything else reports healthy."
            action: "Reseat the HAT ribbon cable · traceback on Orion: `journalctl --user -t eink-display -b`"
          notification_settings:
            receiver: Discord

    - orgId: 1
      name: 5m-eval
      folder: Ansible Provisioned Alerts
      interval: 5m
      rules:
        - uid: wan_packet_loss
          title: Internet Packet Loss
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: avg_over_time(probe_success{probe=~"quad9|cloudflare"}[10m]) < 0.9 and on() max(probe_success{probe="modem"}) == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.probe {{ '}}' }}: {{ '{{' }} humanizePercentage $values.A.Value {{ '}}' }} of pings answered over 10 minutes."
            impact: "The mobile link is up but lossy — calls, streams and remote access stutter."
            action: "Modem signal (RSRP/SINR, band) · WAN dashboard RTT panel · usually weather, cell load or antenna position"
          notification_settings:
            receiver: Discord

        - uid: log_error_burst
          title: Log Error Burst
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 1800
                to: 0
              datasourceUid: "{{ grafana_loki_datasource_name }}"
              model:
                editorMode: code
                expr: 'sum by (host, job, container, unit) (count_over_time({job=~"container|os"} | detected_level=~"(?i)(error|critical|fatal)" [30m])) > 30'
                queryType: instant
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} or $labels.container $labels.unit {{ '}}' }} on {{ '{{' }} $labels.host {{ '}}' }} logged {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} error lines in 30 minutes."
            impact: "Something is failing repeatedly — often the first sign of a broken dependency, a full disk or a crash loop."
            action: "Grafana Explore: `{host=\"{{ '{{' }} $labels.host {{ '}}' }}\", container=\"{{ '{{' }} $labels.container {{ '}}' }}\"} | detected_level=~\"(?i)error\"` · `podman logs --since 30m {{ '{{' }} $labels.container {{ '}}' }}` or `journalctl --since -30min -u {{ '{{' }} $labels.unit {{ '}}' }}`"
          notification_settings:
            receiver: Discord
            mute_time_intervals:
              - weekly-maintenance

        - uid: host_memory_low
          title: Host Memory Low
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes < 0.10
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 15m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }} has only {{ '{{' }} humanizePercentage $values.A.Value {{ '}}' }} memory available."
            impact: "The next allocation spike ends in swapping or an OOM kill."
            action: "Podman dashboard → memory by container · `systemd-cgtop -m`"
          notification_settings:
            receiver: Discord

        - uid: container_memory_near_limit
          title: Container Near Memory Limit
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: (podman_container_mem_usage_bytes / (podman_container_mem_limit_bytes > 0) > 0.9) * on(id) group_left(name) podman_container_info
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 15m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.name {{ '}}' }} uses {{ '{{' }} humanizePercentage $values.A.Value {{ '}}' }} of its memory limit."
            impact: "At the limit the kernel OOM-kills it inside its cgroup."
            action: "Raise `<role>_memory_limit` in the role defaults, or look for a leak on the Podman dashboard"
          notification_settings:
            receiver: Discord

        - uid: hardware_temperature_high
          title: Hardware Temperature High
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_hwmon_temp_celsius > on(instance, chip, sensor) (node_hwmon_temp_crit_celsius - 10) and on(instance, chip, sensor) node_hwmon_temp_crit_celsius > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }} {{ '{{' }} $labels.chip {{ '}}' }}/{{ '{{' }} $labels.sensor {{ '}}' }} at {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} °C, within 10 °C of its critical point."
            impact: "Thermal throttling first, then a hard shutdown at the critical temperature."
            action: "Check the fans (`node_hwmon_fan_rpm`), dust and the rack airflow"
          notification_settings:
            receiver: Discord

        - uid: disk_temperature_high
          title: Disk Temperature High
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: smartmon_temperature_celsius_raw_value > 60
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 15m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.disk {{ '}}' }} at {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} °C."
            impact: "Above ~60 °C HDD life drops sharply and NVMe drives start to throttle."
            action: "Check the drive bay fan and airflow · SMART dashboard"
          notification_settings:
            receiver: Discord

        - uid: network_link_flapping
          title: Network Link Flapping
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: increase(node_network_carrier_changes_total{device=~"en.*|wl.*"}[1h]) > 4
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }} {{ '{{' }} $labels.device {{ '}}' }} lost its link {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} times in an hour."
            impact: "Every drop interrupts DNS, cameras or the e-ink display; on wifi it is the N-97 symptom."
            action: "Cable/port on the switch · `journalctl -u NetworkManager -e` · on Orion: `nmcli dev wifi`"
          notification_settings:
            receiver: Discord

        - uid: conntrack_table_filling
          title: Conntrack Table Filling
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_nf_conntrack_entries / node_nf_conntrack_entries_limit > 0.8
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }} conntrack table {{ '{{' }} humanizePercentage $values.A.Value {{ '}}' }} full."
            impact: "When it is full the kernel drops new connections — DNS and every container network stop accepting."
            action: "`sudo conntrack -S` · find the source with `sudo conntrack -L | awk '{print $5}' | sort | uniq -c | sort -rn | head`"
          notification_settings:
            receiver: Discord

        - uid: frigate_skipping_frames
          title: Frigate Skipping Frames
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: frigate_skipped_fps > 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 15m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Frigate is skipping {{ '{{' }} printf `%.1f` $values.A.Value {{ '}}' }} fps on {{ '{{' }} $labels.camera_name {{ '}}' }}."
            impact: "Detection cannot keep up — events on that camera can be missed."
            action: "Frigate → System → detector inference speed · lower `detect.fps` or check the NPU"
          notification_settings:
            receiver: Discord

        - uid: systemd_unit_failed
          title: Systemd Unit Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_systemd_unit_state{state="failed"} == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Unit {{ '{{' }} $labels.name {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} has failed."
            impact: "That service is stopped until something restarts it."
            action: "`systemctl status <unit>` · `journalctl -u <unit> -b -n 50` · after fixing: `systemctl reset-failed <unit>`"
          notification_settings:
            receiver: Discord

        - uid: host_rebooted
          title: Host Rebooted
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - node_boot_time_seconds < 900
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }} booted {{ '{{' }} humanizeDuration $values.A.Value {{ '}}' }} ago."
            impact: "Every service restarted. If you did not reboot it: power cut (check the UPS alerts), kernel panic or a hang."
            action: "`journalctl -b -1 -p warning -e` · `last -x reboot shutdown | head`"
          notification_settings:
            receiver: Discord

        - uid: smart_health_failed
          title: SMART Health Assessment Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: smartmon_device_smart_healthy == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }} reports its SMART health as FAILED."
            impact: "The drive expects to fail soon; data on it is at risk."
            action: "Make sure the last backup succeeded · `sudo smartctl -a <disk>` · replace the disk"
          notification_settings:
            receiver: Discord

        - uid: smart_sectors_degrading
          title: SMART Sectors Degrading
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: 'label_replace({__name__=~"smartmon_(reallocated_sector_ct|current_pending_sector|offline_uncorrectable|media_errors)_raw_value"}, "attribute", "$1", "__name__", "smartmon_(.+)_raw_value") > 0'
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }}: {{ '{{' }} $labels.attribute {{ '}}' }} is {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }}."
            impact: "An early sign of a failing disk. A stable small number is survivable; a rising one means replace it."
            action: "Watch the trend on the SMART dashboard · `sudo smartctl -A <disk>` · keep backups current"
          notification_settings:
            receiver: Discord

        - uid: authelia_auth_failures
          title: Authelia Authentication Failures
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: sum(rate(authelia_authn_duration_count{success="false"}[5m])) > 0.2
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Failed logins at {{ '{{' }} printf `%.2f` $values.A.Value {{ '}}' }}/s over the last 5 minutes."
            impact: "Someone is guessing passwords, or a device keeps retrying an old one."
            action: "Source IP and user: `podman logs --since 15m authelia 2>&1 | grep -i unsuccessful`"
          notification_settings:
            receiver: Discord

        - uid: tailscale_unhealthy
          title: Tailscale Reporting Unhealthy
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: tailscaled_health_messages > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 15m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Tailscale has reported {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} health warning(s) for 15 minutes."
            impact: "Remote access over Tailscale may be degraded or down."
            action: "`tailscale status` (warnings are listed at the end) · `tailscale netcheck`"
          notification_settings:
            receiver: Discord

        - uid: prometheus_rule_eval_failing
          title: Prometheus Rule Evaluation Failing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: increase(prometheus_rule_evaluation_failures_total[15m]) > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Prometheus rule group {{ '{{' }} $labels.rule_group {{ '}}' }} failed to evaluate."
            impact: "Rules in that group stop producing results; anything built on them goes silent."
            action: "Prometheus → Status → Rules shows the error · `podman logs --tail 50 prometheus`"
          notification_settings:
            receiver: Discord

        - uid: kernel_io_errors
          title: Kernel I/O Or Filesystem Errors
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: loki_process_custom_kernel_io_errors_total > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} kernel disk or filesystem error(s) in the journal."
            impact: "A disk is failing or a filesystem is damaged; data corruption is possible."
            action: "Find the device: `sudo journalctl -k -p err -b | tail -50` · `sudo smartctl -a /dev/<dev>` · confirm the last backup"
          notification_settings:
            receiver: Discord

        - uid: eink_display_stale
          title: E-Ink Display Loop Stalled
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - eink_last_tick_timestamp_seconds > {{ eink_display_fetch_interval * 3 + 40 }}
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "The e-ink display has not updated for {{ '{{' }} humanizeDuration $values.A.Value {{ '}}' }}."
            impact: "The screen is frozen on its last image; the app is running but stuck."
            action: "on Orion: `systemctl --user restart eink-display` · `journalctl --user -t eink-display -n 50`"
          notification_settings:
            receiver: Discord

        - uid: eink_metrics_absent
          title: E-Ink Metrics Absent
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: absent(eink_last_tick_timestamp_seconds)
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "No metrics from the e-ink display for 10 minutes."
            impact: "Either the display app is down or Orion is not sending anything."
            action: "on Orion: `systemctl --user status eink-display` · if Orion is unreachable, check its power and wifi"
          notification_settings:
            receiver: Discord

        - uid: eink_tick_failures
          title: E-Ink Display Ticks Failing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: increase(eink_tick_failures_total[15m]) > {{ (900 // eink_display_fetch_interval * 0.4) | round | int }}
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} e-ink updates failed in the last 15 minutes."
            impact: "The screen skips updates; usually Prometheus was slow or unreachable."
            action: "on Orion: `journalctl --user -t eink-display -n 50`"
          notification_settings:
            receiver: Discord

        - uid: eink_restart_loop
          title: E-Ink Display Restarting Repeatedly
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: increase(eink_starts_total[1h]) > 3
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The e-ink service restarted {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} times in the last hour."
            impact: "Every restart forces a full panel refresh, which wears the panel."
            action: "on Orion: `systemctl --user status eink-display` — an exit code means a crash, a clean stop means something keeps restarting it"
          notification_settings:
            receiver: Discord

    - orgId: 1
      name: 15m-eval
      folder: Ansible Provisioned Alerts
      interval: 15m
      rules:
        - uid: clock_unsynchronised
          title: Clock Not Synchronised
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_timex_sync_status == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 30m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }} clock is not synchronised."
            impact: "TOTP codes, Authelia sessions and certificate checks all depend on the clock; Authelia no longer checks NTP itself."
            action: "`chronyc tracking` · `chronyc sources -v` · `systemctl status chronyd`"
          notification_settings:
            receiver: Discord

        - uid: tailscale_route_not_approved
          title: Tailscale Route Not Approved
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: tailscaled_advertised_routes > tailscaled_approved_routes
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 15m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Nova advertises a subnet route that the tailnet has not approved."
            impact: "Remote clients cannot reach Nova's LAN address — HTTPS and DNS over the tailnet stop working."
            action: "Admin console → Machines → nova → Edit route settings · or add it to `autoApprovers`"
          notification_settings:
            receiver: Discord

        - uid: loki_logs_dropped
          title: Logs Dropped Before Loki
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: sum by (instance, reason) (increase(loki_write_dropped_entries_total[1h])) > 10
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Alloy on {{ '{{' }} $labels.instance {{ '}}' }} dropped {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} log lines in the last hour (reason: {{ '{{' }} $labels.reason {{ '}}' }})."
            impact: "The journal-based alerts (kernel I/O errors, SELinux denials, Zigbee errors) are blind for the dropped lines."
            action: "Why Loki refused them: `sum by (reason) (increase(loki_discarded_samples_total[1h]))` · `journalctl -u alloy -e | grep loki.write`"
          notification_settings:
            receiver: Discord

        - uid: prometheus_tsdb_problems
          title: Prometheus Storage Problems
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: increase(prometheus_tsdb_compactions_failed_total[6h]) > 0 or increase(prometheus_tsdb_wal_corruptions_total[6h]) > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Prometheus had a failed compaction or a WAL corruption."
            impact: "Blocks stop being compacted and disk use grows; a corrupt WAL can lose recent samples."
            action: "`podman logs prometheus | grep -iE 'compact|corrupt'` · disk space on the monitoring LV"
          notification_settings:
            receiver: Discord

        - uid: backup_has_not_run
          title: Backup Has Not Run
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_backup_last_run_timestamp_seconds > 108000
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "No backup has completed for {{ '{{' }} humanizeDuration $values.A.Value {{ '}}' }}."
            impact: "Anything changed since the last backup exists only on the live disks."
            action: "`systemctl --user list-timers homelab-backup.timer` · `findmnt {{ backup_mount }}` · `journalctl --user -u homelab-backup.service -n 50`"
          notification_settings:
            receiver: Discord

        - uid: backup_metrics_absent
          title: Backup Metrics Absent
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: absent(homelab_backup_last_run_timestamp_seconds)
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Backup metrics have disappeared."
            impact: "Every backup alert is blind: a failed backup would go unnoticed."
            action: "`ls -l {{ textfile_metrics_path }}` · `systemctl status alloy`"
          notification_settings:
            receiver: Discord

        - uid: backup_services_not_restarted
          title: Backup Left Services Stopped
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_services_down > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} service(s) stopped for the backup did not come back."
            impact: "Those services are down right now."
            action: "`systemctl --user list-units --state=failed` · then `systemctl --user start <unit>`"
          notification_settings:
            receiver: Discord

        - uid: backup_local_failed
          title: Local Backup Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Last night's backup to {{ local_backup_path }} failed."
            impact: "No new restore point, locally or in B2."
            action: "`journalctl --user -u homelab-backup.service -n 100`"
          notification_settings:
            receiver: Discord

        - uid: backup_cloud_sync_failed
          title: Cloud Sync Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_cloud_sync_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Offsite sync to B2 failed."
            impact: "The local backup is fine; the offsite copy is out of date."
            action: "`journalctl --user -u homelab-backup.service -n 100 | grep -i rclone` · usually network, B2 credentials or quota"
          notification_settings:
            receiver: Discord

        - uid: backup_verify_failed
          title: Cloud Backup Verification Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_verify_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Test restore from B2 failed: the canary file was missing or stale."
            impact: "The offsite copy may not be restorable."
            action: "`journalctl --user -u homelab-verify-backup.service -n 50`"
          notification_settings:
            receiver: Discord

        - uid: backup_canary_ageing
          title: Cloud Canary Ageing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_verify_canary_age_seconds > 86400
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The offsite copy is {{ '{{' }} humanizeDuration $values.A.Value {{ '}}' }} behind."
            impact: "A restore from B2 would lose that much data."
            action: "Usually `backup_cloud_sync_failed` or `backup_quota_exceeded` is firing too; fix that one"
          notification_settings:
            receiver: Discord

        - uid: backup_quota_exceeded
          title: Cloud Quota Exceeded
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_quota_exceeded == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Offsite sync skipped: the backup would exceed the B2 quota."
            impact: "B2 gets no new data until space is freed or the quota is raised."
            action: "Find what grew: `restic stats` on {{ local_backup_path }} · prune, or raise `backup_b2_quota_bytes`"
          notification_settings:
            receiver: Discord

        - uid: backup_cloud_quota_pressure
          title: Cloud Quota Pressure
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_b2_size_bytes / homelab_backup_b2_quota_bytes > 0.85 and homelab_backup_b2_quota_bytes > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The B2 bucket is at {{ '{{' }} humanizePercentage $values.A.Value {{ '}}' }} of its quota."
            impact: "Offsite sync stops once it reaches 100%."
            action: "Prune older snapshots or raise `backup_b2_quota_bytes` before it fills"
          notification_settings:
            receiver: Discord

        - uid: backup_prune_failed
          title: Backup Prune Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_prune_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Backup retention cleanup failed."
            impact: "Old snapshots are not being removed, so the repository keeps growing."
            action: "`journalctl --user -u homelab-backup.service -n 100 | grep -A5 forget` · often a stale lock: `restic unlock`"
          notification_settings:
            receiver: Discord

        - uid: backup_devices_unknown_tier
          title: Device Repo In Unknown Tier
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_devices_unknown_tiers > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} device backup folder(s) are in neither the cloud nor the local tier."
            impact: "Those devices' backups are never copied offsite."
            action: "Move the folder under `<user>/cloud/` or `<user>/local/` in the rest-server root"
          notification_settings:
            receiver: Discord

        - uid: backup_duration_near_timeout
          title: Backup Approaching Its Timeout
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_duration_seconds > 2700
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The last backup took {{ '{{' }} humanizeDuration $values.A.Value {{ '}}' }}, close to its 1h limit."
            impact: "A little more data and the backup will be killed mid-run."
            action: "Stage timings: `journalctl --user -u homelab-backup.service` · trim `backup_targets` or raise TimeoutStartSec"
          notification_settings:
            receiver: Discord

        - uid: filesystem_will_fill
          title: Filesystem Will Fill
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: predict_linear(node_filesystem_avail_bytes{fstype!~"tmpfs|ramfs|overlay"}[6h], 21600) < 0 and node_filesystem_avail_bytes / node_filesystem_size_bytes < 0.2
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 30m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} will be full within 6 hours at the current rate."
            impact: "Writes will start failing, and services on that disk with them."
            action: "`sudo du -xh --max-depth=2 <mountpoint> 2>/dev/null | sort -h | tail`"
          notification_settings:
            receiver: Discord

        - uid: filesystem_critical
          title: Filesystem Almost Full
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_filesystem_avail_bytes{fstype!~"tmpfs|ramfs|overlay"} / node_filesystem_size_bytes < 0.05
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} has only {{ '{{' }} humanizePercentage $values.A.Value {{ '}}' }} free."
            impact: "Writes will start failing, and services on that disk with them."
            action: "`sudo du -xh --max-depth=2 <mountpoint> 2>/dev/null | sort -h | tail`"
          notification_settings:
            receiver: Discord

        - uid: device_backup_stale
          title: Device Backup Stale
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_device_backup_last_snapshot_timestamp_seconds > 259200
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.device {{ '}}' }} ({{ '{{' }} $labels.user {{ '}}' }}, {{ '{{' }} $labels.tier {{ '}}' }}) has not backed up for {{ '{{' }} humanizeDuration $values.A.Value {{ '}}' }}."
            impact: "That device has no recent restore point."
            action: "Check the device is switched on and its scheduled backup ran (log on the device)"
          notification_settings:
            receiver: Discord

        - uid: device_backup_collector_failed
          title: Device Backup Collector Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_device_backup_collector_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Device backup freshness could not be read."
            impact: "`device_backup_stale` is blind."
            action: "`findmnt {{ backup_mount }}` · `journalctl --user -u device-backup-freshness.service -n 20`"
          notification_settings:
            receiver: Discord

        - uid: alloy_not_reporting
          title: Alloy Not Reporting
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: absent(up{job="alloy", instance="{{ nova_hostname }}"})
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Alloy on Nova has stopped sending metrics."
            impact: "Host, backup, update and SMART metrics are all blind; most other alerts cannot fire."
            action: "`systemctl status alloy` · `journalctl -u alloy -n 50`"
          notification_settings:
            receiver: Discord

        - uid: alloy_not_reporting_orion
          title: Alloy Not Reporting (Orion)
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: absent(up{job="alloy", instance="{{ hostvars['orion']['inventory_hostname'] }}"})
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Alloy on Orion has stopped sending metrics for 10 minutes."
            impact: "Orion's metrics and logs are blind."
            action: "Is Orion reachable? `ssh orion systemctl status alloy`"
          notification_settings:
            receiver: Discord

        - uid: selinux_denials
          title: SELinux Denials
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: loki_process_custom_selinux_denials_total > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "SELinux blocked {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} action(s)."
            impact: "Something, usually a container, was denied access and may be failing."
            action: "`sudo ausearch -m AVC -ts recent` · `sudo sealert -a /var/log/audit/audit.log`"
          notification_settings:
            receiver: Discord

        - uid: zigbee2mqtt_errors
          title: Zigbee2MQTT Adapter Errors
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: loki_process_custom_zigbee2mqtt_errors_total > 2
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Zigbee2MQTT logged {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} adapter errors."
            impact: "Zigbee devices may not respond."
            action: "`podman logs --tail 50 zigbee2mqtt` · is the dongle still there? `ls /dev/serial/by-id/`"
          notification_settings:
            receiver: Discord

        - uid: eink_fetch_errors
          title: E-Ink Prometheus Queries Failing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: sum by (reason) (increase(eink_fetch_errors_total[15m])) > {{ (900 // eink_display_fetch_interval * 2 / 3) | round | int }}
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The e-ink display failed to fetch data {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} times in 15 minutes ({{ '{{' }} $labels.reason {{ '}}' }})."
            impact: "The screen shows API ERR."
            action: "Unreachable = network or Authelia · Query Error = bad PromQL · Parse Error = non-JSON reply. on Orion: `journalctl --user -t eink-display -n 50`"
          notification_settings:
            receiver: Discord

        - uid: eink_metrics_missing
          title: E-Ink Display Missing Metrics
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: eink_metrics_missing > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 30m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} e-ink tile(s) have had no data for 30 minutes."
            impact: "Those tiles show `--`."
            action: "Check that a query still matches its series, first of all `INSTANCE` in eink-display.env against Nova's `instance` label"
          notification_settings:
            receiver: Discord

        - uid: eink_wear_not_persisted
          title: E-Ink Wear Counters Not Persisted
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: eink_wear_persisted == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 15m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The e-ink wear counters are not being saved."
            impact: "Panel lifetime figures reset on every restart."
            action: "on Orion: `systemctl --user cat eink-display | grep StateDirectory`"
          notification_settings:
            receiver: Discord

        - uid: eink_refresh_budget
          title: E-Ink Refresh Rate Above Budget
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: sum(rate(eink_refresh_total[24h])) * 86400 > 5000
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 1h
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The e-ink panel is refreshing about {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} times a day (normal is about {{ (78000 / eink_display_fetch_interval) | int }})."
            impact: "The panel will wear out years early."
            action: "On the e-ink dashboard: look for a flapping tile, or night mode not engaging"
          notification_settings:
            receiver: Discord

        - uid: updates_security_pending
          title: Security Updates Pending
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_updates_pending{severity="security"} > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 336h
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }} has had {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} security update(s) waiting for two weeks."
            impact: "Known vulnerabilities stay unpatched until they are installed."
            action: "`make nova_update` · `make orion_update`"
          notification_settings:
            receiver: Discord
            repeat_interval: 168h

        - uid: updates_reboot_required
          title: Reboot Required
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_updates_reboot_required == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 12h
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }} has needed a reboot for 12 hours."
            impact: "The updated kernel or libraries are not in use until it reboots."
            action: "Reboot when convenient: `sudo systemctl reboot`"
          notification_settings:
            receiver: Discord
            repeat_interval: 24h

        - uid: updates_collector_stale
          title: Update Collector Has Stopped Running
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_updates_last_check_timestamp_seconds > 172800
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The update check on {{ '{{' }} $labels.instance {{ '}}' }} has not run for {{ '{{' }} humanizeDuration $values.A.Value {{ '}}' }}."
            impact: "Update alerts are showing stale numbers."
            action: "`systemctl status homelab-updates.timer` · `journalctl -u homelab-updates.service -n 20`"
          notification_settings:
            receiver: Discord

        - uid: updates_cache_stale
          title: Package Metadata Is Stale
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_updates_cache_timestamp_seconds > 259200
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Package metadata on {{ '{{' }} $labels.instance {{ '}}' }} is {{ '{{' }} humanizeDuration $values.A.Value {{ '}}' }} old."
            impact: "Pending-update counts are out of date and may wrongly show 0."
            action: "Fedora: `systemctl status dnf-makecache.timer` · Debian: `systemctl status apt-daily.timer`"
          notification_settings:
            receiver: Discord

        - uid: updates_collector_failed
          title: Update Collector Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_updates_collector_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The update check on {{ '{{' }} $labels.instance {{ '}}' }} failed."
            impact: "Update counts may be wrong."
            action: "`journalctl -u homelab-updates.service -n 20` · on Fedora usually `dnf5-plugins` missing"
          notification_settings:
            receiver: Discord

        - uid: boot_collector_failed
          title: Boot Collector Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_boot_collector_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The boot metrics collector on {{ '{{' }} $labels.instance {{ '}}' }} failed."
            impact: "Boot and shutdown timings show the previous good run."
            action: "`journalctl -u homelab-boot-metrics.service -b` — the [ERROR] line names the failing command"
          notification_settings:
            receiver: Discord

        - uid: smart_critical_warning
          title: SMART Critical Warning
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: smartmon_critical_warning_raw_value > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }} has raised its NVMe critical-warning flag ({{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }})."
            impact: "The drive reports a failure condition itself and may switch to read-only."
            action: "Decode: `sudo smartctl -a -d nvme <disk>` · confirm backups · plan a replacement"
          notification_settings:
            receiver: Discord

