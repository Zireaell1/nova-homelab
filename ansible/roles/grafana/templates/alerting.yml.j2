apiVersion: 1

groups:
    - orgId: 1
      name: 1m-eval
      folder: Ansible Provisioned Alerts
      interval: 1m
      rules:
        - uid: podman_container_crashed
          title: Podman Container Crashed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: (podman_container_exit_code > 0) * on(id) group_left(name) podman_container_info
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Container {{ '{{' }} $labels.name {{ '}}' }} exited with code {{ '{{' }} $values.A {{ '}}' }}."
          notification_settings:
            receiver: Discord

        - uid: podman_container_unhealthy
          title: Podman Container Unhealthy
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: (podman_container_health == 1) * on(id) group_left(name) podman_container_info
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Container {{ '{{' }} $labels.name {{ '}}' }} has been failing its healthcheck for 5 minutes."
          notification_settings:
            receiver: Discord

        - uid: ups_on_battery
          title: UPS On Battery
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: ups_input_voltage < ups_output_voltage_nominal * 0.8
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 1m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Mains lost -- input {{ '{{' }} $values.A {{ '}}' }}V, under 80% of the UPS's nominal. Running on battery."
            description: "Self-calibrating against ups_output_voltage_nominal, so it needs no hardcoded mains voltage."
          notification_settings:
            receiver: Discord

        - uid: ups_battery_low
          title: UPS Battery Low
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: ups_battery_charge < ups_battery_charge_low
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Battery at {{ '{{' }} $values.A {{ '}}' }}% -- past the UPS's own low-battery threshold. Shutdown is imminent."
          notification_settings:
            receiver: Discord

        - uid: ups_runtime_low
          title: UPS Runtime Low
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: ups_battery_runtime < 300
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Only {{ '{{' }} $values.A {{ '}}' }}s of runtime left on battery."
          notification_settings:
            receiver: Discord

        - uid: scrape_target_down
          title: Scrape Target Down
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: up == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Prometheus cannot scrape {{ '{{' }} $labels.job {{ '}}' }} at {{ '{{' }} $labels.instance {{ '}}' }}."
            description: "Covers every exporter at once, including the monitoring stack itself."
          notification_settings:
            receiver: Discord

        - uid: caddy_upstream_unhealthy
          title: Caddy Upstream Unhealthy
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: caddy_reverse_proxy_upstreams_healthy == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Caddy marked upstream {{ '{{' }} $labels.upstream {{ '}}' }} unhealthy."
          notification_settings:
            receiver: Discord

        - uid: caddy_config_reload_failed
          title: Caddy Config Reload Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: caddy_config_last_reload_successful == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Caddy is serving the previous config -- the last load attempt failed."
          notification_settings:
            receiver: Discord

        - uid: frigate_camera_down
          title: Frigate Camera Down
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: frigate_camera_fps == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Camera {{ '{{' }} $labels.camera_name {{ '}}' }} is producing no frames."
            description: "Frigate keeps running with a dead camera, so nothing else reports this."
          notification_settings:
            receiver: Discord

        - uid: eink_hardware_fallback
          title: E-Ink Display Hardware Unavailable
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: eink_display_fallback == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "The e-ink panel could not be initialised -- frames are being written to a PNG, not to the glass."
            description: "EPDDisplay() raised at start-up and the app fell back to SimulatedDisplay, which it does deliberately so a loose ribbon cable cannot take the service down. Every other eink metric keeps counting as though the panel were real, so without this alert the dashboard looks healthy. Check the HAT seating and `journalctl -t eink-display` for the traceback. eink_simulated alone is not enough to alert on: it is also 1 when SIMULATE=true, which is the normal state on a laptop."
          notification_settings:
            receiver: Discord

    - orgId: 1
      name: 5m-eval
      folder: Ansible Provisioned Alerts
      interval: 5m
      rules:
        - uid: systemd_unit_failed
          title: Systemd Unit Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_systemd_unit_state{state="failed"} == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Host unit {{ '{{' }} $labels.name {{ '}}' }} is in the failed state."
            description: "The only coverage for native daemons -- nut, tailscaled, fail2ban, alloy, smartd -- which podman metrics cannot see."
          notification_settings:
            receiver: Discord

        - uid: smart_health_failed
          title: SMART Health Assessment Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: smartmon_device_smart_healthy == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }} reports its overall SMART self-assessment as failed."
            description: "A lagging indicator by design: the drive only says this once a threshold is crossed. smart_sectors_degrading is the leading one."
          notification_settings:
            receiver: Discord

        - uid: smart_sectors_degrading
          title: SMART Sectors Degrading
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: '{__name__=~"smartmon_(reallocated_sector_ct|current_pending_sector|offline_uncorrectable|media_errors)_raw_value"} > 0'
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }}: {{ '{{' }} $labels.__name__ {{ '}}' }} is {{ '{{' }} $values.A {{ '}}' }}."
            description: "Any non-zero value here is the earliest warning of a failing disk, well before the health assessment flips."
          notification_settings:
            receiver: Discord

        - uid: authelia_auth_failures
          title: Authelia Authentication Failures
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: sum(rate(authelia_authn_duration_count{success="false"}[5m])) > 0.2
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Failed authentications running at {{ '{{' }} $values.A {{ '}}' }}/s over 5 minutes."
            description: "With Home Assistant, Vaultwarden and mainsail all on bypass, Authelia's own metrics are where a credential attack shows first."
          notification_settings:
            receiver: Discord

        - uid: tailscale_unhealthy
          title: Tailscale Reporting Unhealthy
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: tailscaled_health_messages > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 15m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "tailscaled is reporting {{ '{{' }} $values.A {{ '}}' }} health message(s)."
            description: "Run `tailscale status` for the text; this only exposes the count."
          notification_settings:
            receiver: Discord

        - uid: prometheus_rule_eval_failing
          title: Prometheus Rule Evaluation Failing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: increase(prometheus_rule_evaluation_failures_total[15m]) > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $labels.rule_group {{ '}}' }} failed to evaluate."
            description: "Meta-alert: a rule that cannot evaluate silently stops alerting. This is the one that tells you the alerting itself broke."
          notification_settings:
            receiver: Discord

        - uid: kernel_io_errors
          title: Kernel I/O Or Filesystem Errors
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: loki_process_custom_kernel_io_errors_total > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $values.A {{ '}}' }} kernel I/O or filesystem error line(s) in the journal -- a disk is failing or a filesystem is damaged."
            description: "Counted by the Alloy log pipeline from kernel journal lines (Buffer I/O error, blk_update_request, EXT4-fs error, XFS corruption/metadata errors, failed FPDMA commands). This catches a disk going bad hours before smart_sectors_degrading does, and it is the only signal here that sees filesystem corruption at all. The counter is dropped 24h after the last error (max_idle_duration), so the alert self-resolves; an Alloy restart also clears it."
          notification_settings:
            receiver: Discord

        - uid: eink_display_stale
          title: E-Ink Display Loop Stalled
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - eink_last_tick_timestamp_seconds > 400
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 5m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "The e-ink fetch loop has not completed a tick in {{ '{{' }} $values.A {{ '}}' }} seconds."
            description: "Threshold is 3x FETCH_INTERVAL (120s). This is the process being alive but wedged -- the scrape still succeeds, so `scrape_target_down` cannot see it. It deliberately watches last_tick and not last_render: record_tick() runs on every path including the night-mode early return, whereas last_render stops advancing from 23:00 to 06:00 and would make this fire every night."
          notification_settings:
            receiver: Discord

        - uid: eink_metrics_absent
          title: E-Ink Metrics Absent
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: absent(eink_last_tick_timestamp_seconds)
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "No metrics are arriving from the e-ink display at all."
            description: "The series has disappeared rather than gone stale, which means either the whole Orion pipeline is down or Alloy on Orion has stopped. Alloy generates the eink `up` series itself and remote-writes it, so when Alloy dies the `up` series never arrives and `scrape_target_down` cannot fire -- the same hole `alloy_not_reporting` describes, which deliberately covers nova only. This is the Orion half of it."
          notification_settings:
            receiver: Discord

        - uid: eink_tick_failures
          title: E-Ink Display Ticks Failing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: increase(eink_tick_failures_total[15m]) > 3
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $values.A {{ '}}' }} e-ink ticks have raised in the last 15 minutes."
            description: "Individual ticks are caught and retried; five consecutive failures re-raise and let systemd restart the unit. Seeing this without a matching eink_restart_loop means failures are intermittent -- usually Prometheus timing out rather than the panel."
          notification_settings:
            receiver: Discord

        - uid: eink_restart_loop
          title: E-Ink Display Restarting Repeatedly
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: increase(eink_starts_total[1h]) > 3
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The e-ink service has started {{ '{{' }} $values.A {{ '}}' }} times in the last hour."
            description: "Restarts are not free: each one costs the panel a full Clear() plus an unconditional full first render, and the panel is rated for roughly 1M refreshes. A steady trickle usually means an Ansible task is notifying the handler on every run rather than a crash; `systemctl --user status eink-display` distinguishes the two."
          notification_settings:
            receiver: Discord

    - orgId: 1
      name: 15m-eval
      folder: Ansible Provisioned Alerts
      interval: 15m
      rules:
        - uid: backup_has_not_run
          title: Backup Has Not Run
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_backup_last_run_timestamp_seconds > 108000
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "No backup has completed in over 30 hours."
            description: "Check `systemctl --user status homelab-backup.timer` and whether {{ backup_mount }} is mounted -- ConditionPathIsMountPoint makes an unmounted disk a successful skip, which produces no metrics at all."
          notification_settings:
            receiver: Discord

        - uid: backup_metrics_absent
          title: Backup Metrics Absent
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: absent(homelab_backup_last_run_timestamp_seconds)
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "homelab_backup_last_run_timestamp_seconds has disappeared entirely."
            description: "The textfile collector keeps serving the last .prom file, so this means node_exporter lost {{ textfile_metrics_path }} or stopped -- not that a backup was skipped. A skipped run shows up as `backup_has_not_run` instead."
          notification_settings:
            receiver: Discord

        - uid: backup_services_not_restarted
          title: Backup Left Services Stopped
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_services_down > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $values.A {{ '}}' }} service(s) stopped for the snapshot did not come back up."
            description: "The backup run caused an outage. Check `systemctl --user list-units --state=failed` and the journal for homelab-backup.service."
          notification_settings:
            receiver: Discord

        - uid: backup_local_failed
          title: Local Backup Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "The nightly restic backup to {{ local_backup_path }} failed."
          notification_settings:
            receiver: Discord

        - uid: backup_cloud_sync_failed
          title: Cloud Sync Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_cloud_sync_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "The rclone sync to B2 failed -- the offsite copy is not current."
          notification_settings:
            receiver: Discord

        - uid: backup_verify_failed
          title: Cloud Backup Verification Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_verify_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Could not restore the canary from B2, or it was older than the {{ backup_canary_max_age }}s limit."
            description: "This is the only end-to-end proof the offsite copy is restorable. Device repos are not covered -- rest-server holds those encrypted under each client's own password."
          notification_settings:
            receiver: Discord

        - uid: backup_canary_ageing
          title: Cloud Canary Ageing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_verify_canary_age_seconds > 86400
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The canary in B2 is over 24h old -- the offsite copy is falling behind."
          notification_settings:
            receiver: Discord

        - uid: backup_quota_exceeded
          title: Cloud Quota Exceeded
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_quota_exceeded == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Projected cloud size exceeded backup_b2_quota_bytes -- the sync was skipped."
          notification_settings:
            receiver: Discord

        - uid: backup_cloud_quota_pressure
          title: Cloud Quota Pressure
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_b2_size_bytes / homelab_backup_b2_quota_bytes > 0.85 and homelab_backup_b2_quota_bytes > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "B2 bucket is over 85% of the configured quota."
          notification_settings:
            receiver: Discord

        - uid: backup_prune_failed
          title: Backup Prune Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_prune_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "restic forget --prune failed -- retention is drifting and the repo will keep growing."
          notification_settings:
            receiver: Discord

        - uid: backup_devices_unknown_tier
          title: Device Repo In Unknown Tier
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_devices_unknown_tiers > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $values.A {{ '}}' }} device repo dir(s) are in neither the cloud nor local tier, so they sync nowhere."
          notification_settings:
            receiver: Discord

        - uid: backup_duration_near_timeout
          title: Backup Approaching Its Timeout
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_backup_duration_seconds > 2700
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Last backup took {{ '{{' }} $values.A {{ '}}' }}s, against the 1h TimeoutStartSec on homelab-backup.service."
          notification_settings:
            receiver: Discord

        - uid: filesystem_will_fill
          title: Filesystem Will Fill
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: predict_linear(node_filesystem_avail_bytes{fstype!~"tmpfs|ramfs|overlay"}[6h], 21600) < 0 and node_filesystem_avail_bytes / node_filesystem_size_bytes < 0.2
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 30m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} is trending to full within 6 hours."
            description: "The <20% guard stops a 6h dip on a mostly-empty filesystem from firing."
          notification_settings:
            receiver: Discord

        - uid: filesystem_critical
          title: Filesystem Almost Full
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: node_filesystem_avail_bytes{fstype!~"tmpfs|ramfs|overlay"} / node_filesystem_size_bytes < 0.05
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 10m
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "{{ '{{' }} $labels.mountpoint {{ '}}' }} on {{ '{{' }} $labels.instance {{ '}}' }} is under 5% free."
          notification_settings:
            receiver: Discord

        - uid: device_backup_stale
          title: Device Backup Stale
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_device_backup_last_snapshot_timestamp_seconds > 259200
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.user {{ '}}' }}/{{ '{{' }} $labels.tier {{ '}}' }}/{{ '{{' }} $labels.device {{ '}}' }} has not backed up in over 3 days."
            description: "72h rather than 30h: these are client machines that get switched off for a weekend. Freshness is all that is observable server-side -- rest-server holds each repo encrypted under the client's own password."
          notification_settings:
            receiver: Discord

        - uid: device_backup_collector_failed
          title: Device Backup Collector Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_device_backup_collector_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The device freshness collector could not read the restic repository root."
            description: "Usually means /mnt/backup is not mounted. noDataState stays OK because backup_metrics_absent owns the case where the textfile stops being written at all."
          notification_settings:
            receiver: Discord

        - uid: alloy_not_reporting
          title: Alloy Not Reporting
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: absent(up{job="alloy", instance="{{ host_svc_address }}:12345"})
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Alloy on nova has stopped reporting -- every host metric, both backup collectors and the textfile metrics are now blind."
            description: "Alloy generates its own `up` series, so a dead Alloy makes them go stale rather than drop to 0 and `scrape_target_down` cannot fire for it. This watches for the series disappearing instead. Orion's Alloy is deliberately not covered -- it feeds the e-ink screen only. The instance matcher renders from `host_svc_address`, the same variable the Alloy config uses, so the two cannot drift apart."
          notification_settings:
            receiver: Discord

        - uid: selinux_denials
          title: SELinux Denials
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: loki_process_custom_selinux_denials_total > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "setroubleshootd reported {{ '{{' }} $values.A {{ '}}' }} SELinux denial(s)."
            description: "SELinux is Enforcing, so a denial means something was actually blocked -- most often a container path that was never labelled container_file_t, or a new service. Check `ausearch -m AVC -ts recent` and `sealert -a /var/log/audit/audit.log`. Value is denials since the counter appeared; it vanishes 24h after the last one. Raise the threshold if deploys make this chatty."
          notification_settings:
            receiver: Discord

        - uid: zigbee2mqtt_errors
          title: Zigbee2MQTT Adapter Errors
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: loki_process_custom_zigbee2mqtt_errors_total > 2
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Zigbee2MQTT has logged {{ '{{' }} $values.A {{ '}}' }} adapter or coordinator errors."
            description: "Threshold is 2 rather than 0 because Restart=always makes a single transient adapter error self-healing -- three or more means the coordinator is genuinely unhappy or the USB device has dropped. Partly covers the gap left by zigbee2mqtt having no container healthcheck yet (Q-03)."
          notification_settings:
            receiver: Discord

        - uid: eink_fetch_errors
          title: E-Ink Prometheus Queries Failing
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: sum by (reason) (increase(eink_fetch_errors_total[15m])) > 5
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The display's Prometheus query failed {{ '{{' }} $values.A {{ '}}' }} times in 15 minutes ({{ '{{' }} $labels.reason {{ '}}' }})."
            description: "The display makes one OR-joined query per tick through Caddy and Authelia. `Prometheus Unreachable` is the network or the auth path, `Query Error` means Prometheus rejected the PromQL, `Parse Error` means the response was not JSON. The screen shows API ERR while this is happening."
          notification_settings:
            receiver: Discord

        - uid: eink_metrics_missing
          title: E-Ink Display Missing Metrics
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: eink_metrics_missing > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 30m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $values.A {{ '}}' }} of the display's queries have been returning no data for 30 minutes."
            description: "The query succeeded but some series came back empty, so those tiles render as `--` rather than blanking the screen. A value that appears and never clears usually means a query no longer matches -- most often the hardcoded INSTANCE label in the display's config drifting from the node_exporter instance label."
          notification_settings:
            receiver: Discord

        - uid: eink_wear_not_persisted
          title: E-Ink Wear Counters Not Persisted
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: eink_wear_persisted == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 15m
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The e-ink display's lifetime refresh counters are resetting on every restart."
            description: "STATE_DIRECTORY is not reaching the process, so wear.json is never written and the panel-life figures on the dashboard are since-boot rather than lifetime. Check that StateDirectory=eink-display is still in the unit -- this alert exists because that line lives in a different repository from the code that needs it."
          notification_settings:
            receiver: Discord

        - uid: eink_refresh_budget
          title: E-Ink Refresh Rate Above Budget
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: sum(rate(eink_refresh_total[24h])) * 86400 > 5000
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 1h
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The panel is refreshing about {{ '{{' }} $values.A {{ '}}' }} times a day."
            description: "Steady state is roughly 650/day: one render per 120s tick, minus the 23:00-06:00 sleep, plus the occasional blink. Crossing 5000 means a wear rule stopped working -- alert flapping defeating the edge-trigger, MAX_PARTIAL_REFRESHES being ignored, or night mode not engaging. The 1M lifetime total is a five-year problem; this is the same fault visible today."
          notification_settings:
            receiver: Discord

        - uid: updates_security_pending
          title: Security Updates Pending
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_updates_pending{severity="security"} > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }} has {{ '{{' }} $values.A {{ '}}' }} package(s) with a security update waiting."
            description: "Counted from the distribution's own security metadata -- apt origins containing `security` on Debian, `--security` advisories on Fedora -- not a hand-maintained package list, which goes stale silently. There is deliberately no alert on the total update count: forty pending means a week on Fedora and months on Debian stable, so one threshold cannot mean the same thing on both hosts."
          notification_settings:
            receiver: Discord

        - uid: updates_reboot_required
          title: Reboot Required
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_updates_reboot_required == 1
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          for: 12h
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "{{ '{{' }} $labels.instance {{ '}}' }} needs a reboot to finish applying updates."
            description: "`/var/run/reboot-required` on Debian, `dnf needs-restarting` on Fedora. The 12h `for` means a reboot you are already planning does not page you mid-maintenance. This is what catches a kernel updated weeks ago that nothing ever booted into."
          notification_settings:
            receiver: Discord

        - uid: updates_collector_stale
          title: Update Collector Has Stopped Running
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_updates_last_check_timestamp_seconds > 172800
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The update collector on {{ '{{' }} $labels.instance {{ '}}' }} has not run for over 48h."
            description: "homelab-updates.timer fires daily, so 48h means it is dead, masked, or the unit failed to install. The textfile keeps its last values on disk, so every count metric stays green and only this staleness check notices -- the same shape as backup_has_not_run."
          notification_settings:
            receiver: Discord

        - uid: updates_cache_stale
          title: Package Metadata Is Stale
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_updates_cache_timestamp_seconds > 259200
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Package metadata on {{ '{{' }} $labels.instance {{ '}}' }} was last refreshed over 3 days ago."
            description: "The collector never refreshes the cache itself -- apt-daily.timer and dnf-makecache.timer own that, and refreshing from a collector deadlocks against them and against unattended-upgrades. Without this rule a broken refresh timer produces a confident `0 pending` forever and the other update alerts go quietly useless."
          notification_settings:
            receiver: Discord

        - uid: updates_collector_failed
          title: Update Collector Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_updates_collector_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The update collector on {{ '{{' }} $labels.instance {{ '}}' }} ran but could not complete."
            description: "Distinct from updates_collector_stale: the timer fired and the textfile is fresh, but a command inside it failed. Check `journalctl -u homelab-updates.service`. On Fedora the usual cause is `dnf needs-restarting` missing, which means dnf5-plugins is not installed."
          notification_settings:
            receiver: Discord

        - uid: smart_critical_warning
          title: SMART Critical Warning
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: smartmon_critical_warning_raw_value > 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }} has raised its NVMe critical-warning flag ({{ '{{' }} $values.A {{ '}}' }})."
            description: "The controller itself declaring a problem -- spare below threshold, degraded reliability, read-only mode, or volatile memory backup failure -- rather than a counter ticking up. Kept out of smart_sectors_degrading because that rule is a leading indicator at warning severity; this one means the drive has already decided something is wrong. Decode with `smartctl -a -d nvme /dev/nvmeXn1`."
          notification_settings:
            receiver: Discord

        - uid: smart_lifetime_low
          title: SMART Lifetime Remaining Low
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: smartmon_percent_lifetime_remain_raw_value < 10
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }} has {{ '{{' }} $values.A {{ '}}' }}% of its rated write endurance left."
            description: "Derived by smartmon.sh as 100 - NVMe 'Percentage Used', so it matches ATA attribute 202 and one rule covers both. Endurance running out is not imminent failure, but it is the point to start planning a replacement rather than discovering it during a restore."
          notification_settings:
            receiver: Discord

        - uid: smart_spare_below_threshold
          title: SMART Spare Below Threshold
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: smartmon_available_spare_raw_value < smartmon_available_spare_threshold_raw_value
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }} is down to {{ '{{' }} $values.A {{ '}}' }}% spare blocks, below the threshold the drive itself reports."
            description: "Self-calibrating against the drive's own Available Spare Threshold rather than a guessed number, the same way the UPS rules use ups_battery_charge_low. Running out of replacement blocks is a different failure mode from write endurance -- smart_lifetime_low covers the other one, so keep both."
          notification_settings:
            receiver: Discord
