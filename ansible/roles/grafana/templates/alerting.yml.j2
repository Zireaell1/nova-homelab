          labels:
            severity: critical
          annotations:
            summary: "Disk {{ '{{' }} $labels.disk {{ '}}' }} is down to {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }}% spare blocks, below the drive's own threshold."
            impact: "The drive can barely replace bad blocks any more; failure is close."
            action: "Confirm backups · replace the disk soon"
          notification_settings:
            receiver: Discord

        - uid: git_mirror_stale
          title: Git Mirror Stale
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: time() - homelab_git_mirror_last_success_timestamp_seconds > 172800
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "Git mirror {{ '{{' }} $labels.repo {{ '}}' }} has not updated for {{ '{{' }} humanizeDuration $values.A.Value {{ '}}' }}."
            impact: "The backup holds an old copy of this repository."
            action: "`journalctl --user -u homelab-backup.service -n 100 | grep -i git`"
          notification_settings:
            receiver: Discord

        - uid: cert_expiring
          title: TLS Certificate Expiring
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: (max by (domain) (homelab_cert_not_after_timestamp_seconds) - time()) / 86400 < 14
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "TLS certificate for {{ '{{' }} $labels.domain {{ '}}' }} expires in {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} days."
            impact: "When it expires, browsers refuse every site it covers."
            action: "`podman logs caddy 2>&1 | grep -i acme` · usually the Cloudflare API token"
          notification_settings:
            receiver: Discord

        - uid: cert_collector_failed
          title: TLS Certificate Collector Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_cert_collector_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The certificate expiry check failed."
            impact: "`cert_expiring` is blind."
            action: "`journalctl --user -u caddy-cert-expiry.service -n 20`"
          notification_settings:
            receiver: Discord
