        - uid: cert_expiring
          title: TLS Certificate Expiring
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: (max by (domain) (homelab_cert_not_after_timestamp_seconds) - time()) / 86400 < 14
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: critical
          annotations:
            summary: "TLS certificate for {{ '{{' }} $labels.domain {{ '}}' }} expires in {{ '{{' }} printf `%.0f` $values.A.Value {{ '}}' }} days."
            impact: "When it expires, browsers refuse every site it covers."
            action: "`podman logs caddy 2>&1 | grep -i acme` · usually the Cloudflare API token"
          notification_settings:
            receiver: Discord

        - uid: cert_collector_failed
          title: TLS Certificate Collector Failed
          condition: A
          data:
            - refId: A
              relativeTimeRange:
                from: 600
                to: 0
              datasourceUid: "{{ grafana_prometheus_datasource_name }}"
              model:
                editorMode: code
                expr: homelab_cert_collector_success == 0
                instant: true
                intervalMs: 1000
                legendFormat: __auto
                maxDataPoints: 43200
                range: false
                refId: A
          noDataState: OK
          execErrState: Error
          isPaused: false
          labels:
            severity: warning
          annotations:
            summary: "The certificate expiry check failed."
            impact: "`cert_expiring` is blind."
