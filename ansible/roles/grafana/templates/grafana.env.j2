GF_SECURITY_ADMIN_USER={{ vault_admin_username }}
GF_SECURITY_ADMIN_PASSWORD__FILE=/run/secrets/admin_password

GF_SECURITY_DISABLE_GRAVATAR=true
GF_SECURITY_COOKIE_SECURE=true
GF_SECURITY_STRICT_TRANSPORT_SECURITY=true
GF_SECURITY_CONTENT_SECURITY_POLICY=true
GF_SNAPSHOTS_EXTERNAL_ENABLED=false
GF_PUBLIC_DASHBOARDS_ENABLED=false

GF_SERVER_DOMAIN=grafana.{{ vault_domain }}
GF_SERVER_ROOT_URL=https://{{ service_endpoints['grafana']['subdomain'] }}.{{ vault_domain }}/
GF_SERVER_ENFORCE_DOMAIN=true
GF_SERVER_ENABLE_GZIP=false

GF_AUTH_PROXY_ENABLED=true
GF_AUTH_PROXY_HEADER_NAME=Remote-User
GF_AUTH_PROXY_HEADER_PROPERTY=username
GF_AUTH_PROXY_AUTO_SIGN_UP=true
GF_AUTH_PROXY_WHITELIST={{ podman_caddy_ips['grafana'] }}
GF_AUTH_PROXY_SYNC_TTL=60
GF_AUTH_PROXY_ENABLE_LOGIN_TOKEN=true
GF_AUTH_PROXY_HEADERS=Name:Remote-Name Email:Remote-Email
GF_AUTH_DISABLE_LOGIN_FORM=true
GF_AUTH_BASIC_ENABLED=false
GF_AUTH_SIGNOUT_REDIRECT_URL=https://{{ service_endpoints['authelia']['subdomain'] }}.{{ vault_domain }}/logout

GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_ANALYTICS_FEEDBACK_LINKS_ENABLED=false
GF_NEWS_NEWS_FEED_ENABLED=false

GF_DATABASE_WAL=true

GF_UNIFIED_ALERTING_STATE_HISTORY_BACKEND=loki
GF_UNIFIED_ALERTING_STATE_HISTORY_LOKI_REMOTE_URL=http://loki:3100

GF_LOG_LEVEL=warn
GF_LOG_CONSOLE_FORMAT=json
