[Unit]
Description=Grafana
Documentation=https://grafana.com/docs/grafana/latest/

Wants=network-online.target
After=network-online.target

RequiresMountsFor={{ monitoring_path }}/grafana/data

[Container]
# --- Image / Exec ---
Image={{ grafana_image }}:{{ grafana_version }}
ContainerName=grafana
StopTimeout=20

# --- Identity / Namespaces ---
UserNS=keep-id:uid=472,gid=472

# --- Security / Capabilities ---
DropCapability=all
NoNewPrivileges=true

# --- Resource Limits ---
Memory={{ grafana_memory_limit }}

# --- Storage ---
Volume={{ monitoring_path }}/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Volume={{ monitoring_path }}/grafana/data:/var/lib/grafana:Z

# --- Networking ---
Network=grafana.network
Network=monitoring-backend.network

# --- Configuration / Env ---
Timezone={{ timezone }}

EnvironmentFile={{ monitoring_path }}/grafana/grafana.env
EnvironmentFile={{ monitoring_path }}/grafana/grafana.secrets.env

HealthCmd=["wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:3000/api/health"]
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
