global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'frigate'
    metrics_path: '/api/metrics'
    static_configs:
      - targets: ['frigate:5000']

  - job_name: 'loki'
    static_configs:
      - targets: ['loki:3100']

  - job_name: 'grafana'
    static_configs:
      - targets: ['grafana:3000']

  - job_name: 'caddy'
    static_configs:
      - targets: ['caddy:9091']
