[Unit]
Description=Restic Rest Server
Documentation=https://github.com/restic/rest-server

Wants=network-online.target
After=network-online.target

RequiresMountsFor={{ restic_data_path }}

[Container]
# --- Image / Exec ---
Image={{ restic_image }}:{{ restic_version }}
ContainerName=restic
StopTimeout=20

# --- Identity / Namespaces ---
UserNS=keep-id:uid=0,gid=0

# --- Security / Capabilities ---
DropCapability=all
NoNewPrivileges=true

# --- Resource Limits ---
Memory={{ restic_memory_limit }}

# --- Storage ---
Volume={{ restic_data_path }}:/data:Z

# --- Networking ---
Network=restic.network

# --- Configuration / Env ---
Timezone={{ timezone }}

Environment=OPTIONS="--private-repos --prometheus --prometheus-no-auth --proxy-auth-username Remote-User"

HealthCmd=["wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:8000/metrics"]
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
