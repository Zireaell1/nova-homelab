# `http:` (trusted_proxies, use_x_forwarded_for, ip_ban_enabled, login_attempts_threshold)
# is configured in the UI since HA 2026.8 -- Settings -> System -> Network -- and lives
# in .storage/, not here.

homeassistant:
  name: Home
  unit_system: metric
  temperature_unit: C
  time_zone: {{ timezone }}
  currency: PLN

  external_url: https://{{ service_endpoints['homeassistant']['subdomain'] }}.{{ vault_domain }}
  internal_url: https://{{ service_endpoints['homeassistant']['subdomain'] }}.{{ vault_domain }}

frontend:
  themes: !include_dir_merge_named themes

automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

logger:
  default: warning

recorder:
  purge_keep_days: 7
  auto_purge: true

prometheus:
  requires_auth: false
  namespace: homeassistant

  component_config_glob:
    sensor.*_temperature:
      override_metric: temperature_c
    sensor.*_humidity:
      override_metric: humidity_percent
    sensor.*_power:
      override_metric: power_watts
    sensor.*_energy:
      override_metric: energy_kwh
    sensor.*_battery:
      override_metric: battery_percent

  filter: !include ansible_managed/prometheus_filter.yaml
