[Unit]
Description=HomeAssistant
Documentation=https://www.home-assistant.io/

RequiresMountsFor={{ stacks_path }}/homeassistant/config

[Container]
# --- Image / Exec ---
Image={{ homeassistant_image }}:{{ homeassistant_version }}
ContainerName=homeassistant
StopTimeout=120

# --- Identity / Namespaces ---
UserNS=keep-id:uid=0,gid=0

# --- Security / Capabilities ---
DropCapability=all
NoNewPrivileges=true

# --- Resource Limits ---
Memory={{ homeassistant_memory_limit }}

# --- Storage ---
Volume={{ stacks_path }}/homeassistant/config:/config:Z

# --- Networking ---
Network=homeassistant.network
Network=home.network
Network=openrgb.network

AddHost=host.svc.internal:{{ host_svc_address }}

# --- Configuration / Env ---
Timezone={{ timezone }}

HealthCmd=["curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:8123/manifest.json"]
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=300s

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=130

[Install]
WantedBy=default.target
