# ===============================================================================
# Snippets
# ===============================================================================

# Cloudflare DNS-01
(cloudflare_tls) {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

# Authelia Forward Auth
(authelia_middleware) {
    forward_auth authelia:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
    }
}

# Authelia Forward Auth (without passing headers)
(authelia_middleware_basic) {
    forward_auth authelia:9091 {
        uri /api/authz/forward-auth
    }
}

(standard) {
    encode
}

(secure_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "0"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
        -X-Powered-By
    }
}

(vault_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "0"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
        -X-Powered-By
        -Last-Modified
    }
}

# ===============================================================================
# Global
# ===============================================================================

{
	default_bind fd/4 {
		protocols h1 h2
	}

	default_bind fdgram/5 {
		protocols h3
	}

	admin off
	auto_https disable_redirects

    metrics
}

http:// {
	bind fd/3 {
		protocols h1
	}
	redir https://{host}{uri}
	log # TODO:
}

# ===============================================================================
# Metrics
# ===============================================================================

:9091 {
    bind 0.0.0.0

    metrics
}

# ===============================================================================
# Wildcard
# ===============================================================================

*.{{ vault_domain }} {
    import cloudflare_tls

    respond "Service not found" 404
}

# ===============================================================================
# Root
# ===============================================================================

{{ vault_domain }} {
    import cloudflare_tls
    import standard
    import secure_headers

    import authelia_middleware
    reverse_proxy homepage:3000
}

# ===============================================================================
# Subdomains
# ===============================================================================

{{ services['authelia']['subdomain'] }}.{{ vault_domain }} {
    import standard
    import secure_headers

    reverse_proxy authelia:9091
}

{{ services['alloy']['subdomain'] }}.{{ vault_domain }} {
    import standard
    import secure_headers

    import authelia_middleware_basic
