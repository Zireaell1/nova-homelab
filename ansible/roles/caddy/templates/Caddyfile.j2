# Cloudflare DNS-01
(cloudflare_tls) {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

# Authelia Forward Auth
(authelia_middleware) {
    forward_auth authelia:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
    }
}

# Authelia Forward Auth Basic (without passing headers)
(authelia_middleware_basic) {
    forward_auth authelia:9091 {
        uri /api/authz/forward-auth
    }
}

(standard) {
    encode
}

(secure_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "0"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
        -X-Powered-By
    }
}

(vault_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "0"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
        -X-Powered-By
        -Last-Modified
    }
}

(gatekeeper) {
    @denied {
        not remote_ip {args[:]}
    }
    handle @denied {
        respond `
        <!DOCTYPE html>
        <html>

        <head>
            <title>Access Denied | Nova</title>
            <style>
                body {
                    font-family: sans-serif;
                    text-align: center;
                    padding: 10%;
                    background: #121212;
                    color: #e0e0e0;
                }

                h1 {
                    color: #ff5252;
                }

                .homelab-badge {
                    margin-top: 50px;
                    font-size: 0.85em;
                    color: #757575;
                    text-transform: uppercase;
                    letter-spacing: 2px;
                    border-top: 1px solid #333;
                    padding-top: 20px;
                    display: inline-block;
                }
            </style>
        </head>

        <body>
            <h1>403 - Forbidden</h1>
            <p>Access Denied by Gatekeeper. Your IP is not authorized.</p>

            <div class="homelab-badge">
                Nova
            </div>
        </body>

        </html>
        ` 403 {
            header Content-Type text/html
        }
    }
}

{
	default_bind fd/4 {
		protocols h1 h2
	}

	default_bind fdgram/5 {
		protocols h3
	}

	admin off
	auto_https disable_redirects

    metrics
}

http:// {
	bind fd/3 {
		protocols h1
	}
	redir https://{host}{uri}
	log # TODO:
}

:9091 {
    bind 0.0.0.0

    metrics
}

# Wildcard controller
*.{{ vault_domain }} {
    import cloudflare_tls

    respond "Service not found" 404
}

# Root Domain
{{ vault_domain }} {
    import cloudflare_tls
    import standard
    import secure_headers
    import gatekeeper {{ network_home }} {{ network_tailscale }}

    handle {
        reverse_proxy glance:8080
    }
}

