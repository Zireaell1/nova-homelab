[Unit]
Description=Caddy Proxy
Documentation=https://caddyserver.com/docs/

Wants=network-online.target
After=network-online.target

After=caddy.socket
Requires=caddy.socket

RequiresMountsFor={{ stacks_path }}/caddy/data
RequiresMountsFor={{ stacks_path }}/caddy/config

[Container]
Image=localhost/custom-caddy:{{ caddy_version }}
ContainerName=caddy
Timezone={{ timezone }}
Memory={{ caddy_memory_limit }}

DropCapability=all
NoNewPrivileges=true

EnvironmentFile={{ stacks_path }}/caddy/caddy.env

StopTimeout=20

Notify=true

Volume={{ stacks_path }}/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume={{ stacks_path }}/caddy/data:/data:Z
Volume={{ stacks_path }}/caddy/config:/config:Z

UserNS=keep-id

# TODO: maybe it could be better if other containers would join proxy network with some "isolated" option on network config 
Network=authelia.network

Network=frigate.network
Network=vaultwarden.network
Network=zigbee2mqtt.network
Network=peanut.network
Network=restic.network

Network=prometheus.network
Network=loki.network
Network=grafana.network

[Service]
Restart=always
TimeoutStartSec=900
TimeoutStopSec=30

[Install]
WantedBy=default.target
