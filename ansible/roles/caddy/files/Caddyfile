    import standard

    import allow_home
    import allow_tailscale

    import gatekeeper

    reverse_proxy uptime-kuma:3001
}

frigate.{$DOMAIN} {
    import standard

    import allow_home
    import allow_tailscale

    import gatekeeper

    import authelia_middleware

    reverse_proxy frigate:8971 {
        header_up X-Proxy-Secret {env.FRIGATE_AUTH_SECRET}
    }
}

paperless.{$DOMAIN} {
    import standard

    import allow_home
    import allow_tailscale

    import gatekeeper

    reverse_proxy paperless:8000 {
        header_down Referrer-Policy "strict-origin-when-cross-origin"
    }
}

z2m.{$DOMAIN} {
    import standard

    import allow_home
    import allow_tailscale

    import gatekeeper

    # TODO: probably should be authelia_middleware_basic, but it worked like that for some time without problems, so for now it can stay
    import authelia_middleware

    reverse_proxy zigbee2mqtt:8080
}

