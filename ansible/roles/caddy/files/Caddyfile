{
    order respond before forward_auth

	default_bind fd/4 {
		protocols h1 h2
	}

	default_bind fdgram/5 {
		protocols h3
	}
	# TODO: admin unix//data/admin.sock
	auto_https disable_redirects
}

# ------------- ACL Rules ------------------
# Tailscale VPN
(allow_tailscale) {
    @is_tailscale remote_ip {env.TAILSCALE_NETWORK}
    vars @is_tailscale authorized true
}

# Home LAN
(allow_home) {
    @is_home remote_ip {env.HOME_NETWORK} 10.89.0.0/16
    vars @is_home authorized true
}

# Homelab LAN
(allow_homelab) {
    @is_homelab remote_ip {env.HOMELAB_NETWORK}
    vars @is_homelab authorized true
}

# IOT LAN
(allow_iot) {
    @is_iot remote_ip {env.IOT_NETWORK}
    vars @is_iot authorized true
}

# Wall Dashboard Access
(allow_dashboard) {
    @is_dashboard remote_ip {env.DASHBOARD_IP}
    vars @is_dashboard authorized true
}

# ------------------------------------------------

# Gatekeeper
(gatekeeper) {
    @denied {
        not vars authorized true
    }
    respond @denied "Access denied." 403
}

# -----------------------------------------------

# Cloudflare DNS-01
(cloudflare_tls) {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

# -----------------------------------------------

# Authelia Forward Auth
(authelia_middleware) {
    forward_auth authelia:9091 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
    }
}

# Authelia Forward Auth Basic (without passing headers)
(authelia_middleware_basic) {
    forward_auth authelia:9091 {
        uri /api/authz/forward-auth
    }
}

# -----------------------------------------------

# Standard settings
(standard) {
    encode
}

# -----------------------------------------------

http:// {
	bind fd/3 {
		protocols h1
	}
	redir https://{host}{uri}
	log
}

# Wildcard controller
*.{$DOMAIN} {
    import cloudflare_tls

    respond "Service not found." 404
}

# Root Domain
{$DOMAIN} {
    import cloudflare_tls
    import standard

    import allow_home
    import allow_tailscale

    import gatekeeper

    reverse_proxy glance:8080
}

# Subdomains
restic.{$DOMAIN} {
    # TODO: Probably doesn't make sense to compress data there, if sent data is already compressed

    import allow_home

    import gatekeeper

    reverse_proxy restic:8000
}

auth.{$DOMAIN} {
    import standard

    import allow_home
    import allow_tailscale
    import allow_dashboard

    import gatekeeper

    reverse_proxy authelia:9091
}

mainsail.{$DOMAIN} {
    import standard

    import allow_home
    import allow_tailscale

    import gatekeeper

    reverse_proxy {$PRINTER_IP}
}

switch.{$DOMAIN} {
    import standard

    import allow_home
    import allow_tailscale

    import gatekeeper

    # TODO: do weryfikacji
    reverse_proxy {$SWITCH_IP}
}

kuma.{$DOMAIN} {
    import standard

    import allow_home
    import allow_tailscale

    import gatekeeper

    import authelia_middleware_basic

    reverse_proxy uptime-kuma:3001
}

