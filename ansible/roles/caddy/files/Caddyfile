beszel.{$DOMAIN} {
    import standard

    import allow_home
    import allow_tailscale
    # Beszel Agent access to Hub
    import allow_homelab

    import gatekeeper

    request_body {
        max_size 10MB
    }

    reverse_proxy beszel:8090 {
        transport http {
            read_timeout 360s
        }
    }
}

