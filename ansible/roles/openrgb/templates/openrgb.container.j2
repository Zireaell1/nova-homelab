[Unit]
Description=OpenRGB
Documentation=https://github.com/CalcProgrammer1/OpenRGB/

[Container]
# --- Image / Exec ---
Image={{ openrgb_local_image }}:latest
ContainerName=openrgb
StopTimeout=20

Notify=healthy

# --- Identity / Namespaces ---
GroupAdd=keep-groups
UserNS=keep-id:uid=0,gid=0

# --- Security / Capabilities ---
DropCapability=all
NoNewPrivileges=true
ReadOnly=true
DNS=none

# --- Resource Limits ---
Memory={{ openrgb_memory_limit }}

# --- Devices ---
AddDevice=/dev/asrock_rgb_hid

# --- Storage ---
Tmpfs=/root/.config:rw,size=16m,mode=0700

# --- Networking ---
Network=openrgb.network

# --- Configuration / Env ---
Timezone={{ timezone }}

Environment=TZ={{ timezone }}

HealthCmd=["grep", "-qE", ":1A56 [0-9A-F]+:0000 0A", "/proc/net/tcp", "/proc/net/tcp6"]
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

HealthStartupCmd=["grep", "-qE", ":1A56 [0-9A-F]+:0000 0A", "/proc/net/tcp", "/proc/net/tcp6"]
HealthStartupInterval=2s
HealthStartupTimeout=5s
HealthStartupSuccess=1

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=30

ExecStartPre=/bin/sleep 5

[Install]
WantedBy=default.target
