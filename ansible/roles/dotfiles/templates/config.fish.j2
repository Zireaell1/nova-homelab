set -gx EDITOR micro

if status is-interactive
    abbr -a up "{{ dotfiles_update_cmd }}"
    abbr -a upclean "{{ dotfiles_update_clean_cmd }}"
    abbr -a clean "{{ dotfiles_clean_cmd }}"
end

function fish_greeting
    if set -q ZELLIJ
        return
    end

    if command -q fastfetch
        fastfetch
    end

    echo
    set_color --bold {{ dotfiles_prompt_accent }}
    echo "✦ Quick commands"
    set_color normal
    for row in "up|update packages ({{ dotfiles_update_label }})" \
            "upclean|update and clean up ({{ dotfiles_update_clean_label }})" \
            "clean|remove unused packages only (asks first)"
        set -l parts (string split -m 1 "|" -- $row)
        set_color {{ dotfiles_prompt_accent_light }}
        printf "  %-9s" $parts[1]
        set_color brblack
        echo $parts[2]
    end
    set_color normal
    echo
end

function fish_prompt
    set -l last_status $status
    set_color brblack
    echo -n "$USER@"
    set_color {{ dotfiles_prompt_accent }}
    echo -n (prompt_hostname)
    set_color normal
    echo -n " "(prompt_pwd)
    set_color brblack
    echo -n (fish_vcs_prompt)
    if test $last_status -eq 0
        set_color {{ dotfiles_prompt_accent }}
        echo -n " ✦ "
    else
        set_color red
        echo -n " ✦ $last_status "
    end
    set_color normal
end
