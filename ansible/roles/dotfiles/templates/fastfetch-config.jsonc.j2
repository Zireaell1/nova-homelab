{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
{% if dotfiles_fastfetch_logo is file %}
    "logo": {
        "type": "file",
        "source": "{{ user_config_path }}/fastfetch/logo.txt",
        "color": { "1": "97", "2": "94" },
        "padding": { "top": 1, "right": 3, "left": 3 }
    },
{% endif %}
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        {
            "type": "command",
            "key": "OS Age",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); total_difference=$((current - birth_install)); years=$((total_difference / (365 * 86400))); remaining_days=$((total_difference % (365 * 86400) / 86400)); months=$((remaining_days / 30)); echo \"$years Years and $months Months\""
        },
        "packages",
        "separator",
        {
            "type": "cpu",
            "key": "CPU",
            "temp": true
        },
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "break",
        "colors"
    ]
}
