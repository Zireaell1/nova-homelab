version: 0.17-0

mqtt:
  enabled: true
  host: mosquitto
  port: 1883
  user: '{FRIGATE_MQTT_USER}'
  password: '{FRIGATE_MQTT_PASSWORD}'

tls:
  enabled: false

auth:
  enabled: false

proxy:
  auth_secret: {{ vault_caddy_frigate_auth_secret }}
  header_map:
    user: remote-user
    role: remote-groups
  default_role: viewer
  # TODO: logout_url:  

go2rtc:
  streams:
    Front:
      - ffmpeg:http://{FRIGATE_FRONT_ADDRESS}:80/flv?port=1935&app=bcs&stream=channel0_main.bcs&user={FRIGATE_FRONT_USER}&password={FRIGATE_FRONT_PASSWORD}
      - ffmpeg:Front#audio=opus
      - rtsp://{FRIGATE_FRONT_USER}:{FRIGATE_FRONT_PASSWORD}@{FRIGATE_FRONT_ADDRESS}:554/Preview_01_sub
    Front_sub:
      - ffmpeg:http://{FRIGATE_FRONT_ADDRESS}:80/flv?port=1935&app=bcs&stream=channel0_sub.bcs&user={FRIGATE_FRONT_USER}&password={FRIGATE_FRONT_PASSWORD}
      - rtsp://{FRIGATE_FRONT_USER}:{FRIGATE_FRONT_PASSWORD}@{FRIGATE_FRONT_ADDRESS}:554/Preview_01_sub
    Back:
      - ffmpeg:http://{FRIGATE_BACK_ADDRESS}:80/flv?port=1935&app=bcs&stream=channel0_main.bcs&user={FRIGATE_BACK_USER}&password={FRIGATE_BACK_PASSWORD}
      - ffmpeg:Back#audio=opus
      - rtsp://{FRIGATE_BACK_USER}:{FRIGATE_BACK_PASSWORD}@{FRIGATE_BACK_ADDRESS}:554/Preview_01_sub
    Back_sub:
      - ffmpeg:http://{FRIGATE_BACK_ADDRESS}:80/flv?port=1935&app=bcs&stream=channel0_sub.bcs&user={FRIGATE_BACK_USER}&password={FRIGATE_BACK_PASSWORD}
      - rtsp://{FRIGATE_BACK_USER}:{FRIGATE_BACK_PASSWORD}@{FRIGATE_BACK_ADDRESS}:554/Preview_01_sub
    Entry:
      - ffmpeg:http://{FRIGATE_ENTRY_ADDRESS}:80/flv?port=1935&app=bcs&stream=channel0_main.bcs&user={FRIGATE_ENTRY_USER}&password={FRIGATE_ENTRY_PASSWORD}
      - ffmpeg:Entry#audio=opus
      - rtsp://{FRIGATE_ENTRY_USER}:{FRIGATE_ENTRY_PASSWORD}@{FRIGATE_ENTRY_ADDRESS}:554/Preview_01_sub
    Entry_sub:
      - ffmpeg:http://{FRIGATE_ENTRY_ADDRESS}:80/flv?port=1935&app=bcs&stream=channel0_sub.bcs&user={FRIGATE_ENTRY_USER}&password={FRIGATE_ENTRY_PASSWORD}
      - rtsp://{FRIGATE_ENTRY_USER}:{FRIGATE_ENTRY_PASSWORD}@{FRIGATE_ENTRY_ADDRESS}:554/Preview_01_sub
    Doorbell:
      - ffmpeg:http://{FRIGATE_DOORBELL_ADDRESS}:80/flv?port=1935&app=bcs&stream=channel0_main.bcs&user={FRIGATE_DOORBELL_USER}&password={FRIGATE_DOORBELL_PASSWORD}
      - ffmpeg:Doorbell#audio=opus
      - rtsp://{FRIGATE_DOORBELL_USER}:{FRIGATE_DOORBELL_PASSWORD}@{FRIGATE_DOORBELL_ADDRESS}:554/Preview_01_sub
    Doorbell_sub:
      - ffmpeg:http://{FRIGATE_DOORBELL_ADDRESS}:80/flv?port=1935&app=bcs&stream=channel0_ext.bcs&user={FRIGATE_DOORBELL_USER}&password={FRIGATE_DOORBELL_PASSWORD}
      - rtsp://{FRIGATE_DOORBELL_USER}:{FRIGATE_DOORBELL_PASSWORD}@{FRIGATE_DOORBELL_ADDRESS}:554/Preview_01_sub
  webrtc:
    filters:
      networks: [ udp4, tcp4 ]
    candidates:
      - {{ primary_ip }}:8555
      - {{ vault_tailscale_ip }}:8555

ffmpeg:
  hwaccel_args: preset-intel-qsv-h264

detectors:
  ov:
    type: openvino
    device: NPU

model:
  width: 300
  height: 300
  input_tensor: nhwc
  input_pixel_format: bgr
  path: /openvino-model/ssdlite_mobilenet_v2.xml
  labelmap_path: /openvino-model/coco_91cl_bkgr.txt

objects:
  track:
    - person
    - bicycle
    - car
    - motorcycle
    - cat
    - dog

snapshots:
  enabled: true
  retain:
    default: 10

camera_groups:
  Birdseye:
    order: 1
    icon: LuBird
    cameras: birdseye
  Home:
    order: 2
    icon: LuDoorClosed
    cameras:
      - Front
      - Doorbell
      - Entry
      - Back

ui:
  timezone: {{ timezone }}
  time_format: 24hour

classification:
  custom:
    Main Gate State:
      enabled: true
      name: Main Gate State
      threshold: 0.8
      state_config:
        cameras:
          Front:
            crop:
              - 0.713296804424713
              - 0.20115177335612824
              - 0.9353890330052275
              - 0.5898131733720287
        motion: true

cameras:
  Front:
    enabled: true
    webui_url: "https://{{ services['camera_front']['subdomain'] }}.{{ vault_domain }}"
    ffmpeg:
      output_args:
        record: preset-record-generic-audio-copy
      inputs:
        - path: rtsp://127.0.0.1:8554/Front_sub
          input_args: preset-rtsp-restream
          roles:
            # TODO: - audio
            - detect
        - path: rtsp://127.0.0.1:8554/Front
          input_args: preset-rtsp-restream
          roles:
            - record
    detect:
      enabled: true
      annotation_offset: -1000
    record:
      enabled: true
      alerts:
        retain:
          days: 30
          mode: motion
      detections:
        retain:
          days: 30
          mode: motion
      continuous:
        days: 14
      motion:
        days: 0
    motion:
      mask:
        0,0.095,0,0,1,0,1,0.112,0.912,0,0.736,0,0.553,0.012,0.426,0.076,0.353,0.076,0.157,0.081
      threshold: 50
      contour_area: 10
      improve_contrast: true
    live:
      streams:
        Main Stream: Front
        Sub Stream: Front_sub
    zones:
      Backyard:
        coordinates:
          0.43,0.309,0.681,0.32,0.882,0.358,0.956,0.658,1,1,0,1,0,0.637,0.172,0.305
        loitering_time: 0
        objects: person
    review:
      alerts:
        required_zones: Backyard

  Entry:
