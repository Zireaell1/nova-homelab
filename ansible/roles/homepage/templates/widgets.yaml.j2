---
- resources:
      label: System
      cpu: true
      cputemp: true
      memory: true
      uptime: true

- resources:
      label: Home
      disk: /

- resources:
      label: Frigate
      disk: {{ frigate_mount }}

- resources:
      label: Backup
      disk: {{ backup_mount }}

- datetime:
      text_size: xl
      format:
          timeStyle: short
          dateStyle: short
          hourCycle: h23
